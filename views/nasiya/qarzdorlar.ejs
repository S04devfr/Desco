<%- include('../layouts/header', {
  title: "Qarzdorlar Nazorati — DESCO CRM",
  activePage: 'nasiya-qarzdorlar',
  user: user
}) %>

<style>
  .debtor-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .debtor-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand);
  }
  .debtor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .debtor-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge-manual {
    background: rgba(139, 92, 246, 0.1);
    color: #8B5CF6;
    border: 1px solid rgba(139, 92, 246, 0.2);
  }
  .badge-nasiya {
    background: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
  .badge-manager {
    background: rgba(0, 82, 255, 0.08);
    color: #0052FF;
    border: 1px solid rgba(0, 82, 255, 0.2);
    text-transform: none;
    font-size: 11px;
    font-weight: 700;
  }
  [data-theme="dark"] .badge-manager {
    background: rgba(108, 138, 255, 0.15);
    color: #6C8AFF;
    border: 1px solid rgba(108, 138, 255, 0.3);
  }
  .overdue-alert {
    background: rgba(239, 68, 68, 0.08);
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.15);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
  }
  .future-alert {
    background: rgba(16, 185, 129, 0.08);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.15);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
  }
  .debt-action-btn {
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .debt-action-btn:hover {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }
  .action-panel-row {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
    flex-wrap: wrap;
  }
  .schedule-container {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

<div class="page-header">
  <div>
    <h1>Qarzdorlar Nazorati <span style="background: rgba(139, 92, 246, 0.1); color: #8B5CF6; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(139, 92, 246, 0.2); margin-left: 8px; vertical-align: middle; display: inline-block; letter-spacing: 0.5px; text-transform: uppercase;">Smart Control</span></h1>
    <p>Qarzdorlar ro'yxati, aloqa muddatlari nazorati va tezkor harakatlar paneli</p>
  </div>
  <div class="page-header-actions" style="display: flex; gap: 10px; align-items: center;">
    <div class="search-box" style="position: relative;">
      <input type="text" id="debtorSearch" oninput="filterDebtors()" class="form-control form-control-sm" placeholder="Mijoz ismi, tel yoki shahar..." style="width: 250px; padding-left: 30px; height: 36px;">
      <i class="fas fa-search" style="position: absolute; left: 10px; top: 11px; color: var(--text-secondary); font-size: 13px;"></i>
    </div>
    
    <select id="debtorSort" onchange="filterDebtors()" class="filter-select" style="height: 36px; padding: 0 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface-card); color: var(--text-primary); font-size: 12px; font-weight: 600;">
      <option value="amount-desc">Qarz summasi (Kamayish)</option>
      <option value="amount-asc">Qarz summasi (O'sish)</option>
      <option value="days-overdue">Muddati o'tgan kunlar</option>
      <option value="date-asc">Sana (Eski)</option>
      <option value="date-desc">Sana (Yangi)</option>
    </select>

    <button class="btn btn-primary btn-sm" onclick="openQuickClientCreate()" style="height: 36px; display: flex; align-items: center; gap: 6px;">
      <i class="fas fa-user-plus"></i> Yangi Qarzdor
    </button>
  </div>
</div>

<!-- Dynamic Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 15px;">
  <div class="card" style="padding: 16px; display: flex; align-items: center; gap: 12px; border-radius: 10px; box-shadow: var(--shadow-sm);">
    <div style="width: 44px; height: 44px; border-radius: 8px; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; font-size: 18px;">
      <i class="fas fa-hand-holding-usd"></i>
    </div>
    <div>
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-tertiary);">Umumiy qarzdorlik</div>
      <div style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin-top: 2px;" id="totalDebtAmount">0 UZS</div>
    </div>
  </div>
  
  <div class="card" style="padding: 16px; display: flex; align-items: center; gap: 12px; border-radius: 10px; box-shadow: var(--shadow-sm);">
    <div style="width: 44px; height: 44px; border-radius: 8px; background: rgba(245, 158, 11, 0.1); color: #F59E0B; display: flex; align-items: center; justify-content: center; font-size: 18px;">
      <i class="fas fa-hourglass-half"></i>
    </div>
    <div>
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-tertiary);">Muddati o'tganlar</div>
      <div style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin-top: 2px;" id="overdueDebtsCount">0 ta mijoz</div>
    </div>
  </div>

  <div class="card" style="padding: 16px; display: flex; align-items: center; gap: 12px; border-radius: 10px; box-shadow: var(--shadow-sm);">
    <div style="width: 44px; height: 44px; border-radius: 8px; background: rgba(16, 185, 129, 0.1); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 18px;">
      <i class="fas fa-users"></i>
    </div>
    <div>
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-tertiary);">Jami qarzdorlar</div>
      <div style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin-top: 2px;" id="totalDebtorsCount">0 ta mijoz</div>
    </div>
  </div>
</div>

<!-- Debtors Grid Container -->
<div id="debtorsContainer" class="debtor-grid">
  <!-- Loading state -->
  <div style="grid-column: 1/-1; text-align: center; padding: 50px;">
    <div class="spinner" style="margin: 0 auto 10px;"></div>
    <span style="color: var(--text-tertiary);">Ma'lumotlar yuklanmoqda...</span>
  </div>
</div>

<!-- Overlays: Manual client debt creation (Reuse form/modal code from dashboard but standalone) -->
<div id="clientDebtModal" class="modal-overlay" style="display:none; z-index:1100; overflow-y:auto; align-items:flex-start; padding: 40px 20px;" onclick="if(event.target===this)closeClientDebtModal()">
  <div class="modal-dialog" style="max-width:500px; background: var(--surface-card); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-lg);">
    <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center;">
      <h3 id="clientDebtModalTitle" style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-primary);">
        <i class="fas fa-hand-holding-usd text-brand" style="margin-right:8px;"></i>Qarzdorlikni tahrirlash
      </h3>
      <button class="modal-close" onclick="closeClientDebtModal()" style="background: none; border: none; font-size: 16px; color: var(--text-secondary); cursor: pointer;"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body" style="padding: 20px;">
      <input type="hidden" id="debtClientId">
      <div class="form-group">
        <label class="form-label">Mijoz Ismi <span style="color:var(--danger)">*</span></label>
        <input type="text" id="debtClientName" class="form-control" placeholder="Mijoz ismi">
      </div>
      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Telefon Raqami</label>
          <input type="text" id="debtClientPhone" class="form-control" placeholder="+998901234567">
        </div>
        <div class="form-group">
          <label class="form-label">Shahri / Viloyati</label>
          <input type="text" id="debtClientCity" class="form-control" placeholder="Toshkent">
        </div>
      </div>
      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Qarz Summasi (UZS) <span style="color:var(--danger)">*</span></label>
          <input type="number" id="debtClientAmount" class="form-control" placeholder="1000000" min="0" step="10000">
        </div>
        <div class="form-group">
          <label class="form-label">Qarz Berilgan Sana</label>
          <input type="date" id="debtClientDate" class="form-control">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Qarz Izohi / Sababi</label>
        <input type="text" id="debtClientNotes" class="form-control" placeholder="Izoh...">
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button class="btn btn-secondary" onclick="closeClientDebtModal()">Bekor qilish</button>
        <button class="btn btn-primary" onclick="submitClientDebtForm()">Saqlash</button>
      </div>
    </div>
  </div>
</div>

<script>
let allClients = [];
let allDeals = [];
let consolidatedDebts = [];

async function loadData() {
  try {
    const [clientsRes, dealsRes] = await Promise.all([
      fetch('/api/clients').then(r => r.json()),
      fetch('/api/deals').then(r => r.json())
    ]);
    
    allClients = Array.isArray(clientsRes) ? clientsRes : [];
    allDeals = Array.isArray(dealsRes) ? dealsRes : [];
    
    processDebts();
  } catch(e) {
    console.error('Qarzdorlar yuklashda xato:', e);
  }
}

function processDebts() {
  consolidatedDebts = [];
  const pad = n => String(n).padStart(2, '0');
  
  // 1. Manual client debts
  allClients.forEach(c => {
    if (c.debt && c.debt > 0) {
      const contactDt = c.debtDate ? new Date(c.debtDate) : (c.updatedAt ? new Date(c.updatedAt) : null);
      const lastContactAtFormatted = contactDt && !isNaN(contactDt)
        ? `${pad(contactDt.getDate())}.${pad(contactDt.getMonth()+1)}.${contactDt.getFullYear()} ${pad(contactDt.getHours())}:${pad(contactDt.getMinutes())}`
        : 'Kiritilmagan';
      const lastContactAtIso = contactDt && !isNaN(contactDt)
        ? `${contactDt.getFullYear()}-${pad(contactDt.getMonth()+1)}-${pad(contactDt.getDate())}T${pad(contactDt.getHours())}:${pad(contactDt.getMinutes())}`
        : '';

      let mgrName = 'Ko\'rsatilmadi';
      if (c.owner && c.owner.fullName) {
        mgrName = c.owner.fullName;
      } else if (c.debtNotes && c.debtNotes.includes('Menejer:')) {
        const match = c.debtNotes.match(/Menejer:\s*([^)\n|]+)/);
        if (match && match[1]) mgrName = match[1].trim();
      }

      consolidatedDebts.push({
        type: 'manual',
        id: c.id,
        name: c.name,
        phone: c.phone || '',
        city: c.city || '',
        date: c.debtDate ? String(c.debtDate).slice(0, 10) : '',
        lastContactAtFormatted,
        lastContactAtIso,
        amount: c.debt || 0,
        notes: c.debtNotes || 'Manual kiritilgan qarz',
        managerName: mgrName,
        isEditable: true
      });
    }
  });

  // 2. Deal debts (Nasiya / installments)
  allDeals.forEach(d => {
    const remainingDebt = (d.amount || 0) - (d.paidAmount || 0);
    if (remainingDebt > 0) {
      const contactDt = d.stageUpdatedAt ? new Date(d.stageUpdatedAt) : (d.updatedAt ? new Date(d.updatedAt) : (d.createdAt ? new Date(d.createdAt) : null));
      const lastContactAtFormatted = contactDt && !isNaN(contactDt)
        ? `${pad(contactDt.getDate())}.${pad(contactDt.getMonth()+1)}.${contactDt.getFullYear()} ${pad(contactDt.getHours())}:${pad(contactDt.getMinutes())}`
        : 'Kiritilmagan';
      const lastContactAtIso = contactDt && !isNaN(contactDt)
        ? `${contactDt.getFullYear()}-${pad(contactDt.getMonth()+1)}-${pad(contactDt.getDate())}T${pad(contactDt.getHours())}:${pad(contactDt.getMinutes())}`
        : '';

      let mgrName = 'Ko\'rsatilmadi';
      if (d.manager && d.manager.fullName) {
        mgrName = d.manager.fullName;
      } else if (d.notes && d.notes.includes('Menejer:')) {
        const match = d.notes.match(/Menejer:\s*([^)\n|]+)/);
        if (match && match[1]) mgrName = match[1].trim();
      }

      consolidatedDebts.push({
        type: 'nasiya',
        id: d.id,
        name: d.client ? d.client.name : 'Noma\'lum',
        phone: d.client ? d.client.phone : '',
        city: d.client ? d.client.city : '',
        date: d.createdAt ? String(d.createdAt).slice(0, 10) : '',
        lastContactAtFormatted,
        lastContactAtIso,
        amount: remainingDebt,
        notes: `${d.productName || 'Sdelka'} qarzi`,
        managerName: mgrName,
        isEditable: false
      });
    }
  });

  filterDebtors();
}

function filterDebtors() {
  const query = document.getElementById('debtorSearch').value.toLowerCase().trim();
  const sort = document.getElementById('debtorSort').value;
  
  let filtered = [...consolidatedDebts];
  
  // Filter
  if (query) {
    filtered = filtered.filter(d => 
      d.name.toLowerCase().includes(query) ||
      d.phone.includes(query) ||
      d.city.toLowerCase().includes(query) ||
      d.managerName.toLowerCase().includes(query)
    );
  }
  
  // Sort
  if (sort === 'amount-desc') {
    filtered.sort((a, b) => b.amount - a.amount);
  } else if (sort === 'amount-asc') {
    filtered.sort((a, b) => a.amount - b.amount);
  } else if (sort === 'date-asc') {
    filtered.sort((a, b) => new Date(a.date || 0) - new Date(b.date || 0));
  } else if (sort === 'date-desc') {
    filtered.sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
  } else if (sort === 'days-overdue') {
    filtered.sort((a, b) => {
      const aDays = getOverdueDays(a.date);
      const bDays = getOverdueDays(b.date);
      return bDays - aDays; // Max overdue first
    });
  }

  // Update Summary Stats
  const totalAmount = filtered.reduce((sum, d) => sum + d.amount, 0);
  const totalDebtors = filtered.length;
  const overdueCount = filtered.filter(d => getOverdueDays(d.date) > 0).length;

  document.getElementById('totalDebtAmount').textContent = totalAmount.toLocaleString('uz-UZ') + ' so\'m';
  document.getElementById('overdueDebtsCount').textContent = overdueCount + ' ta mijoz';
  document.getElementById('totalDebtorsCount').textContent = totalDebtors + ' ta mijoz';

  renderDebtorsGrid(filtered);
}

function getOverdueDays(dateStr) {
  if (!dateStr) return 0;
  const due = new Date(dateStr);
  due.setHours(0,0,0,0);
  const now = new Date();
  now.setHours(0,0,0,0);
  const diffTime = now - due;
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays > 0 ? diffDays : 0;
}

function renderDebtorsGrid(items) {
  const container = document.getElementById('debtorsContainer');
  if (items.length === 0) {
    container.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-tertiary);"><i class="fas fa-user-slash" style="font-size:32px; opacity:0.3; margin-bottom:10px;"></i><br>Qarzdorlar topilmadi</div>';
    return;
  }

  container.innerHTML = items.map(d => {
    const editBtn = d.isEditable ? `
      <button class="debt-action-btn" onclick="openEditClientDebt(${d.id})">
        <i class="fas fa-edit"></i> Tahrirlash
      </button>
    ` : '';

    return `
      <div class="debtor-card">
        <span class="debtor-badge badge-manager" title="Menejer"><i class="fas fa-user-tie" style="margin-right: 4px;"></i>${escHtml(d.managerName)}</span>
        
        <div style="padding-right: 110px;">
          <h4 style="margin: 0; font-size: 14.5px; font-weight: 700; color: var(--text-primary);">${escHtml(d.name)}</h4>
          <div style="font-size: 11px; color: var(--text-tertiary); margin-top: 3px;">
            <i class="fas fa-phone-alt" style="margin-right: 4px;"></i>${escHtml(d.phone || 'Telefon kiritilmagan')}
          </div>
          <div style="font-size: 11px; color: var(--text-tertiary); margin-top: 2px;">
            <i class="fas fa-map-marker-alt" style="margin-right: 4px;"></i>${escHtml(d.city || 'Shahar kiritilmagan')}
          </div>
        </div>

        <div style="margin-top: 12px; background: var(--bg-tertiary); padding: 10px; border-radius: 8px; border: 1px solid var(--border);">
          <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-tertiary);">Qarz summasi</div>
          <div style="font-size: 16px; font-weight: 800; color: var(--danger); margin-top: 2px;">${d.amount.toLocaleString('uz-UZ')} so'm</div>
          <div style="font-size: 10.5px; color: var(--text-secondary); margin-top: 4px; font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escHtml(d.notes)}">
            <i class="fas fa-quote-left" style="font-size: 8px; margin-right: 4px; opacity: 0.5;"></i>${escHtml(d.notes)}
          </div>
        </div>

        <!-- 📞 OXIRGI ALOQA KUNI VA VAQTI (QO'LDA SOZLANADIGAN) -->
        <div style="margin-top: 10px; background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
          <div style="font-size: 11px; color: var(--text-secondary);">
            <i class="far fa-clock" style="color: var(--accent); margin-right: 4px;"></i>
            <span>Oxirgi aloqa:</span>
            <strong style="color: var(--text-primary); font-weight: 700; margin-left: 3px;" id="lastContactTxt-${d.id}-${d.type}">${d.lastContactAtFormatted}</strong>
          </div>
          <button class="btn btn-ghost btn-sm" onclick="toggleEditLastContact(${d.id}, '${d.type}')" style="padding: 2px 6px; font-size: 10.5px; color: var(--brand); font-weight: 700;" title="Vaqtni o'zgartirish">
            <i class="fas fa-edit"></i> O'zgartirish
          </button>
        </div>

        <div id="edit-last-contact-${d.id}-${d.type}" class="schedule-container" style="display: none; background: var(--bg-secondary); margin-top: 6px; padding: 8px; border-radius: 6px;">
          <div style="font-size: 11px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">Oxirgi aloqa kuni va vaqtini kiriting:</div>
          <div style="display: flex; gap: 6px; align-items: center;">
            <input type="datetime-local" id="last-contact-input-${d.id}-${d.type}" class="form-control form-control-sm" style="flex: 1; height: 30px; font-size: 11.5px;" value="${d.lastContactAtIso}">
            <button class="btn btn-primary btn-sm" onclick="saveLastContactDate(${d.id}, '${d.type}')" style="height: 30px; font-size: 11px; padding: 0 10px; font-weight: 700;">Saqlash</button>
          </div>
        </div>

        <div class="action-panel-row">
          <button class="debt-action-btn" onclick="showScheduleCallPanel(${d.id}, '${d.type}', this)">
            <i class="fas fa-calendar-plus"></i> Sana belgilash
          </button>
          <button class="debt-action-btn" style="border-color: #34c759; color: #34c759;" onclick="closeDebtDirectly(${d.id}, '${d.type}', ${d.amount})">
            <i class="fas fa-check"></i> Yopish
          </button>
          ${editBtn}
        </div>
        
        <div id="schedule-panel-${d.id}-${d.type}" class="schedule-container" style="display: none;">
          <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);">Qayta aloqa sanasini belgilang:</div>
          <div style="display: flex; gap: 8px; align-items: center;">
            <input type="date" id="schedule-date-${d.id}-${d.type}" class="form-control form-control-sm" style="flex: 1; height: 32px;">
            <button class="btn btn-primary btn-sm" onclick="saveScheduledCall(${d.id}, '${d.type}')" style="height: 32px; font-size:11px; padding: 0 10px;">Belgilash</button>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

function toggleEditLastContact(id, type) {
  const panel = document.getElementById(`edit-last-contact-${id}-${type}`);
  if (!panel) return;
  panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
}

async function saveLastContactDate(id, type) {
  const input = document.getElementById(`last-contact-input-${id}-${type}`);
  if (!input || !input.value) {
    alert("Iltimos, kun va vaqtni kiritishingiz shart!");
    return;
  }

  const dtVal = input.value;
  try {
    if (type === 'manual') {
      await fetch('/api/clients/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ debtDate: dtVal })
      });
    } else {
      await fetch('/api/deals/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ stageUpdatedAt: new Date(dtVal).toISOString() })
      });
    }

    if (typeof showToast === 'function') showToast("Oxirgi aloqa kuni va vaqti saqlandi!", "success");
    loadData();
  } catch(e) {
    alert("Saqlashda xatolik: " + e.message);
  }
}

function escHtml(str) {
  if (!str) return '';
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}

function showScheduleCallPanel(id, type, btn) {
  const panel = document.getElementById(`schedule-panel-${id}-${type}`);
  if (!panel) return;
  if (panel.style.display === 'none') {
    panel.style.display = 'flex';
    btn.classList.add('active');
  } else {
    panel.style.display = 'none';
    btn.classList.remove('active');
  }
}

async function saveScheduledCall(id, type) {
  const dateInput = document.getElementById(`schedule-date-${id}-${type}`);
  if (!dateInput || !dateInput.value) {
    alert("Iltimos, sanani tanlang!");
    return;
  }
  
  const targetDate = dateInput.value;
  
  try {
    // Dynamic callback registrar: creates a task on the specified date to notify/remind about this debt callback!
    // Since task has a deadline and reminder, we link it to the selected date.
    let debtorName = '';
    let description = '';
    
    if (type === 'manual') {
      const client = allClients.find(c => c.id === id);
      debtorName = client ? client.name : 'Mijoz';
      description = `Qarzdorlik bo'yicha qayta aloqaga chiqish. Izoh: ${client ? client.debtNotes : ''}`;
    } else {
      const deal = allDeals.find(d => d.id === id);
      debtorName = deal && deal.client ? deal.client.name : 'Mijoz';
      description = `Nasiya to'lovi bo'yicha aloqa. Mahsulot: ${deal ? deal.productName : ''}`;
    }
    
    const taskPayload = {
      title: `${debtorName} bilan qayta aloqa (Qarz nazorati)`,
      description: description,
      deadline: new Date(targetDate).toISOString(),
      completed: false,
      clientId: type === 'manual' ? id : undefined,
      dealId: type === 'nasiya' ? id : undefined
    };

    const r = await fetch('/api/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(taskPayload)
    });
    
    if (!r.ok) throw new Error("Vazifa yaratishda xato yuz berdi");

    // Also update client debtDate / note if manual
    if (type === 'manual') {
      await fetch('/api/clients/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ debtDate: targetDate })
      });
    }
    
    showToast("Muvaffaqiyatli belgilandi! Vazifa va eslatma kiritildi.", "success");
    document.getElementById(`schedule-panel-${id}-${type}`).style.display = 'none';
    
    loadData();
  } catch(e) {
    alert(e.message);
  }
}

async function closeDebtDirectly(id, type, amount) {
  const confirmMsg = type === 'manual' 
    ? `Ushbu mijozning qarzdorlik summasini (${amount.toLocaleString()} so'm) to'liq to'langan deb yopmoqchimisiz?`
    : `Ushbu sdelkaning qolgan barcha qarzdorligini (${amount.toLocaleString()} so'm) to'liq to'langan deb yopmoqchimisiz?`;
    
  if (!confirm(confirmMsg)) return;

  try {
    if (type === 'manual') {
      const r = await fetch('/api/clients/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ debt: 0, debtNotes: 'Qarz yopildi' })
      });
      if (!r.ok) throw new Error();
    } else {
      // close sdelka debt via patch
      const deal = allDeals.find(d => d.id === id);
      const r = await fetch('/api/deals/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paidAmount: deal.amount })
      });
      if (!r.ok) throw new Error();
    }
    
    showToast("Qarzdorlik yopildi!", "success");
    loadData();
  } catch(e) {
    showToast("Xatolik yuz berdi", "error");
  }
}

// Dialog management
window.openQuickClientCreate = function() {
  document.getElementById('debtClientId').value = '';
  document.getElementById('debtClientName').value = '';
  document.getElementById('debtClientPhone').value = '';
  document.getElementById('debtClientCity').value = '';
  document.getElementById('debtClientAmount').value = '';
  document.getElementById('debtClientDate').value = new Date().toISOString().slice(0, 10);
  document.getElementById('debtClientNotes').value = '';

  document.getElementById('clientDebtModalTitle').innerHTML = '<i class="fas fa-user-plus text-brand" style="margin-right:8px;"></i>Yangi mijoz va qarz yaratish';
  document.getElementById('clientDebtModal').style.display = 'flex';
};

window.openEditClientDebt = function(clientId) {
  const client = allClients.find(c => c.id === clientId);
  if (!client) return;

  document.getElementById('debtClientId').value = client.id;
  document.getElementById('debtClientName').value = client.name || '';
  document.getElementById('debtClientPhone').value = client.phone || '';
  document.getElementById('debtClientCity').value = client.city || '';
  document.getElementById('debtClientAmount').value = client.debt || '';
  document.getElementById('debtClientDate').value = client.debtDate ? client.debtDate.slice(0, 10) : '';
  document.getElementById('debtClientNotes').value = client.debtNotes || '';

  document.getElementById('clientDebtModalTitle').innerHTML = '<i class="fas fa-edit text-brand" style="margin-right:8px;"></i>Qarzdorlikni tahrirlash';
  document.getElementById('clientDebtModal').style.display = 'flex';
};

window.closeClientDebtModal = function() {
  document.getElementById('clientDebtModal').style.display = 'none';
};

window.submitClientDebtForm = async function() {
  const id = document.getElementById('debtClientId').value;
  const name = document.getElementById('debtClientName').value.trim();
  const phone = document.getElementById('debtClientPhone').value.trim();
  const city = document.getElementById('debtClientCity').value.trim();
  const debt = Number(document.getElementById('debtClientAmount').value) || 0;
  const debtDate = document.getElementById('debtClientDate').value;
  const debtNotes = document.getElementById('debtClientNotes').value.trim();

  if (!name) { alert("Mijoz ismini kiriting!"); return; }
  if (debt <= 0) { alert("Iltimos, to'g'ri qarz summasini kiriting!"); return; }

  const saveBtn = document.querySelector('#clientDebtModal .btn-primary');
  if (saveBtn) saveBtn.disabled = true;

  try {
    const payload = { name, phone, city, debt, debtDate, debtNotes };
    let r;
    if (id) {
      r = await fetch('/api/clients/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
    } else {
      r = await fetch('/api/clients', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
    }
    
    if (!r.ok) {
      const err = await r.json();
      throw new Error(err.message || 'Saqlashda xatolik yuz berdi');
    }
    
    showToast("Saqlandi!", "success");
    closeClientDebtModal();
    loadData();
  } catch(e) {
    alert(e.message);
  } finally {
    if (saveBtn) saveBtn.disabled = false;
  }
};

document.addEventListener('DOMContentLoaded', loadData);
</script>

