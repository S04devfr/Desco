    </div>
  </div>
</div>
<div id="toastContainer"></div>
<script src="/js/main.js"></script>

<!-- ── SMART OPERATOR PRESENCE & 10-MIN IDLE DETECTOR (amoCRM style) ── -->
<script>
(function() {
  var PING_URL = '/api/telephony/heartbeat';
  var INTERVAL_MS = 30 * 1000; // Har 30 soniyada ping
  var IDLE_TIMEOUT_MS = 10 * 60 * 1000; // 10 daqiqa harakatsizlik
  var lastUserActionTime = Date.now();
  var _timer = null;

  function markActive() {
    lastUserActionTime = Date.now();
  }

  // Global user activity event listeners
  ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function(evt) {
    window.addEventListener(evt, markActive, { passive: true });
  });

  function sendHeartbeat() {
    var idleTimeMs = Date.now() - lastUserActionTime;
    var isDocumentHidden = document.hidden;
    var isIdle = idleTimeMs >= IDLE_TIMEOUT_MS || isDocumentHidden;

    fetch(PING_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        isIdle: isIdle,
        idleSeconds: Math.floor(idleTimeMs / 1000)
      }),
      credentials: 'same-origin'
    }).catch(function() {});
  }

  setTimeout(function() {
    sendHeartbeat();
    _timer = setInterval(sendHeartbeat, INTERVAL_MS);
  }, 2000);

  window.addEventListener('beforeunload', function() {
    if (_timer) clearInterval(_timer);
  });
})();
</script>
</body>
</html>
