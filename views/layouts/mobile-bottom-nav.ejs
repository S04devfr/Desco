<!-- Mobile Bottom Navigation Bar -->
<nav class="mobile-bottom-nav">
  <a href="/" class="mobile-nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
    <i class="fas fa-chart-line"></i>
    <span>Tahlil</span>
  </a>

  <a href="/deals" class="mobile-nav-item <%= activePage === 'deals' ? 'active' : '' %>">
    <i class="fas fa-handshake"></i>
    <span>Sdelkalar</span>
  </a>

  <button type="button" class="mobile-nav-item quick-add-item" onclick="openNewDealModal()" title="Yangi Sdelka">
    <i class="fas fa-plus"></i>
    <span>Yangi</span>
  </button>

  <a href="/tasks" class="mobile-nav-item <%= activePage === 'tasks' ? 'active' : '' %>">
    <i class="fas fa-check-circle"></i>
    <span>Vazifalar</span>
  </a>

  <button type="button" class="mobile-nav-item" onclick="openMobileSearchModal()" title="Qidiruv">
    <i class="fas fa-search"></i>
    <span>Qidiruv</span>
  </button>
</nav>

<!-- Mobile Fullscreen Search Overlay -->
<div class="mobile-search-modal" id="mobileSearchModal">
  <div class="mobile-search-header">
    <div class="mobile-search-input-wrap">
      <i class="fas fa-search"></i>
      <input type="text" id="mobileGlobalSearch" placeholder="Mijoz, sdelka, telefon..." autocomplete="off" onkeyup="handleMobileGlobalSearch(event)">
    </div>
    <button type="button" class="btn btn-secondary" onclick="closeMobileSearchModal()" style="padding:10px 14px; border-radius:12px;">
      Yopish
    </button>
  </div>
  <div id="mobileSearchResults" style="flex:1; overflow-y:auto; padding:8px 0;">
    <div style="text-align:center; color:var(--text-tertiary); padding:32px 0;">
      Qidirish uchun sdelka yoki mijoz nomini kiriting...
    </div>
  </div>
</div>

<script>
function openMobileSearchModal() {
  const modal = document.getElementById('mobileSearchModal');
  if (modal) {
    modal.classList.add('active');
    document.body.classList.add('mobile-nav-open');
    setTimeout(() => {
      document.getElementById('mobileGlobalSearch')?.focus();
    }, 150);
  }
}

function closeMobileSearchModal() {
  const modal = document.getElementById('mobileSearchModal');
  if (modal) {
    modal.classList.remove('active');
    document.body.classList.remove('mobile-nav-open');
  }
}

function handleMobileGlobalSearch(e) {
  const query = e.target.value.trim();
  const resultsDiv = document.getElementById('mobileSearchResults');
  if (!resultsDiv) return;
  
  if (query.length < 2) {
    resultsDiv.innerHTML = '<div style="text-align:center; color:var(--text-tertiary); padding:32px 0;">Qidirish uchun kamida 2 ta belgi kiriting...</div>';
    return;
  }

  fetch('/api/deals/search?q=' + encodeURIComponent(query))
    .then(res => res.json())
    .then(data => {
      if (!data.success || !data.deals || data.deals.length === 0) {
        resultsDiv.innerHTML = '<div style="text-align:center; color:var(--text-tertiary); padding:32px 0;">Natija topilmadi</div>';
        return;
      }

      let html = '';
      data.deals.forEach(d => {
        const clientName = d.client ? d.client.name : 'Noma\'lum';
        const phone = d.client ? d.client.phone : '';
        html += '<div onclick="window.location.href=\'/deals?dealId=' + d.id + '\'; closeMobileSearchModal();" style="padding:14px; border-bottom:1px solid var(--border); background:var(--bg-surface); margin-bottom:8px; border-radius:12px; cursor:pointer;">' +
                  '<div style="font-weight:700; color:var(--text-primary); font-size:14px;">' + (d.productName || 'Sdelka #' + d.id) + '</div>' +
                  '<div style="font-size:12.5px; color:var(--text-secondary); margin-top:4px;">' + clientName + ' (' + phone + ')</div>' +
                '</div>';
      });
      resultsDiv.innerHTML = html;
    })
    .catch(() => {
      resultsDiv.innerHTML = '<div style="text-align:center; color:var(--danger); padding:16px;">Qidiruvda xatolik</div>';
    });
}
</script>
