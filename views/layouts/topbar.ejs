<header class="topbar">

  <!-- Left: menu toggle + page title -->
  <div class="flex items-center gap-3">
    <button class="topbar-btn mobile-menu-toggle hidden" onclick="toggleMobileMenu()" aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>
    <div class="breadcrumb" id="pageTitle"></div>
  </div>

  <!-- Right: search, theme, notifs, avatar -->
  <div class="topbar-right">

    <!-- Search -->
    <div class="topbar-search" style="position:relative; display:flex; align-items:center; width:280px;">
      <i class="fas fa-search"></i>
      <input type="text" id="globalSearch" placeholder="Mijoz, sdelka, telefon qidirish..." autocomplete="off">
      <div id="globalSearchResults" class="search-dropdown-panel hidden" style="position:absolute; top:calc(100% + 8px); left:0; right:0; min-width:340px; max-height:420px; overflow-y:auto; background:var(--bg-primary); border:1px solid var(--border); border-radius:12px; box-shadow:0 12px 36px rgba(0,0,0,0.22); z-index:999; padding:8px 0; display:none;"></div>
    </div>

    <!-- Structured Commodity Indicator: Live Tashkent Time & Region -->
    <div class="topbar-commodity-indicator" style="display:inline-flex; align-items:center; gap:8px; padding:4px 12px; background:var(--bg-surface); border:1px solid var(--border); border-radius:99px; font-size:11.5px; font-weight:700; color:var(--text-primary); box-shadow:0 2px 6px rgba(0,0,0,0.03);">
      <span style="width:7px; height:7px; border-radius:50%; background:#10B981; display:inline-block; box-shadow:0 0 8px rgba(16,185,129,0.6); animation:pulse-green 2s infinite;"></span>
      <i class="far fa-clock" style="color:var(--primary); font-size:11px;"></i>
      <span id="topbarTashkentClock">10-Avgust, 2026 | 15:55</span>
    </div>

    <!-- Theme toggle -->
    <button class="topbar-btn" id="themeToggleBtn" title="Mavzuni o'zgartirish" onclick="toggleTheme()">
      <i class="fas fa-moon" id="themeIcon"></i>
    </button>

    <!-- Notifications -->
    <div style="position:relative;" id="notifWrap">
      <button class="topbar-btn" id="notifBtn" title="Bildirishnomalar" onclick="toggleNotifPanel()">
        <i class="fas fa-bell"></i>
        <span class="notif-badge hidden" id="notifCount">0</span>
      </button>

      <div class="notif-panel hidden" id="notifPanel">
        <div class="notif-panel-header">
          <span>Bildirishnomalar</span>
          <button class="notif-read-all" onclick="markAllRead()">Hammasini o'qildi</button>
        </div>
        <div class="notif-list" id="notifList">
          <div class="empty-state" style="padding:24px;">Bildirishnoma yo'q</div>
        </div>
      </div>
    </div>

    <!-- Profile -->
    <div style="position:relative;" id="profileWrap">
      <div class="topbar-avatar" id="profileBtn" onclick="toggleProfileMenu()" title="<%= user.fullName %>" style="cursor:pointer; overflow:hidden; display:flex; align-items:center; justify-content:center;">
        <% if (typeof user !== 'undefined' && user.avatar) { %>
          <img src="<%= user.avatar %>" alt="Avatar" style="width:100%; height:100%; object-fit:cover;">
        <% } else { %>
          <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
        <% } %>
      </div>

      <div class="profile-dropdown hidden" id="profileMenu" style="width:240px;">
        <div class="dropdown-profile-header" onclick="openUserProfileModal()" style="cursor:pointer; padding:12px 14px;">
          <div class="topbar-avatar" style="width:40px;height:40px;font-size:15px;flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;">
            <% if (typeof user !== 'undefined' && user.avatar) { %>
              <img src="<%= user.avatar %>" alt="Avatar" style="width:100%; height:100%; object-fit:cover;">
            <% } else { %>
              <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
            <% } %>
          </div>
          <div style="overflow:hidden;">
            <div style="font-size:13px;font-weight:700;color:var(--text-900);text-overflow:ellipsis;overflow:hidden;white-space:nowrap;">
              <%= user.fullName || 'Foydalanuvchi' %>
            </div>
            <div style="font-size:11px;color:var(--text-500);text-overflow:ellipsis;overflow:hidden;white-space:nowrap;">
              <%= user.email %>
            </div>
          </div>
        </div>

        <div class="dropdown-divider"></div>

        <div class="dropdown-section">
          <button class="dropdown-item" onclick="openUserProfileModal()">
            <i class="fas fa-user-circle dropdown-item-icon" style="color:var(--brand);"></i> Mening profilim
          </button>
          <button class="dropdown-item" onclick="openPasswordModal()">
            <i class="fas fa-key dropdown-item-icon" style="color:#F59E0B;"></i> Parol o'zgartirish
          </button>
        </div>

        <div class="dropdown-divider"></div>

        <div class="dropdown-section">
          <button class="dropdown-item danger" onclick="logout()">
            <i class="fas fa-sign-out-alt dropdown-item-icon"></i> Chiqish
          </button>
        </div>
      </div>
    </div>

  </div>
</header>

<!-- Enterprise Profile Drawer Modal (amoCRM / Bitrix24 / Salesforce Style) -->
<div class="modal-overlay hidden" id="userProfileModal" onclick="if(event.target===this)closeUserProfileModal()" style="z-index:2000; position:fixed; inset:0; background:rgba(0,0,0,0.55); backdrop-filter:blur(6px); display:flex; justify-content:flex-end;">
  <div class="modal-dialog" style="width:100%; max-width:860px; height:100vh; margin:0; border-radius:0; background:var(--bg-primary); border-left:1px solid var(--border); box-shadow:-10px 0 40px rgba(0,0,0,0.3); display:flex; flex-direction:column; overflow:hidden; animation: slideInRight 0.25s ease-out;">
    
    <!-- Cover Banner Header -->
    <div style="position:relative; height:150px; background:linear-gradient(135deg, #007AFF 0%, #6366F1 50%, #8B5CF6 100%); padding:20px 24px; display:flex; justify-content:space-between; align-items:flex-start; flex-shrink:0;">
      <div style="color:#fff; font-size:13px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; opacity:0.9; display:flex; align-items:center; gap:8px;">
        <i class="fas fa-id-card" style="font-size:16px;"></i> DESCO CRM Foydalanuvchi Markazi
      </div>
      <button class="modal-close" onclick="closeUserProfileModal()" style="border:none; background:rgba(255,255,255,0.2); color:#fff; width:34px; height:34px; border-radius:50%; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); transition:all 0.2s;">&times;</button>
    </div>

    <!-- Floating Avatar Bar -->
    <div style="padding:0 32px; margin-top:-55px; display:flex; align-items:flex-end; justify-content:space-between; flex-shrink:0; position:relative; z-index:2;">
      <div style="display:flex; align-items:flex-end; gap:20px;">
        <div style="position:relative;">
          <div id="profileAvatarPreview" style="width:108px; height:108px; border-radius:50%; background:var(--brand); color:#fff; font-size:42px; font-weight:800; display:flex; align-items:center; justify-content:center; overflow:hidden; border:4px solid var(--bg-primary); box-shadow:0 8px 24px rgba(0,0,0,0.2);">
            <% if (typeof user !== 'undefined' && user.avatar) { %>
              <img src="<%= user.avatar %>" id="profileAvatarImg" alt="Avatar" style="width:100%; height:100%; object-fit:cover;">
            <% } else { %>
              <span id="profileAvatarInitial"><%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
          </div>
          <label title="Rasm yuklash" style="position:absolute; bottom:4px; right:4px; width:34px; height:34px; border-radius:50%; background:var(--brand); color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 2px 8px rgba(0,0,0,0.3); border:2px solid #fff;">
            <i class="fas fa-camera" style="font-size:14px;"></i>
            <input type="file" id="avatarFileInput" accept="image/*" style="display:none;" onchange="handleAvatarFileSelect(this)">
          </label>
        </div>

        <div style="margin-bottom:8px;">
          <h2 style="margin:0; font-size:22px; font-weight:800; color:var(--text-primary); display:flex; align-items:center; gap:10px;">
            <%= user.fullName || 'Foydalanuvchi' %>
            <span style="font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; background:rgba(16,185,129,0.12); color:#10B981; border:1px solid rgba(16,185,129,0.2); display:inline-flex; align-items:center; gap:5px;">
              <span style="width:7px; height:7px; border-radius:50%; background:#10B981;"></span> Online
            </span>
          </h2>
          <div style="font-size:13px; color:var(--text-secondary); margin-top:2px;">
            <%= user.email %> &bull; 
            <% if (user.role === 'admin') { %>
              <span style="color:#10B981; font-weight:700;">🛡️ Administrator</span>
            <% } else { %>
              <span style="color:#007AFF; font-weight:700;">💼 Sotuv Menejeri</span>
            <% } %>
          </div>
        </div>
      </div>

      <div style="display:flex; gap:10px; margin-bottom:8px;">
        <button type="button" class="btn btn-ghost btn-sm" onclick="resetProfileAvatar()" style="border:1px solid var(--border); font-size:12px;">
          <i class="fas fa-trash-alt" style="color:var(--danger); margin-right:4px;"></i> Rasmni o'chirish
        </button>
        <button type="button" class="btn btn-primary btn-sm" onclick="submitUserProfileSave()">
          <i class="fas fa-save" style="margin-right:4px;"></i> Saqlash
        </button>
      </div>
    </div>

    <!-- Navigation Tabs Bar -->
    <div style="padding:20px 32px 0 32px; border-bottom:1px solid var(--border); display:flex; gap:24px; flex-shrink:0;">
      <button type="button" class="profile-tab-btn active" id="pTab1" onclick="switchProfileTab('info')" style="padding:10px 0; font-size:14px; font-weight:700; color:var(--brand); border:none; background:none; border-bottom:2px solid var(--brand); cursor:pointer;">
        <i class="fas fa-user-circle" style="margin-right:6px;"></i> Shaxsiy ma'lumotlar
      </button>
      <button type="button" class="profile-tab-btn" id="pTab2" onclick="switchProfileTab('security')" style="padding:10px 0; font-size:14px; font-weight:600; color:var(--text-secondary); border:none; background:none; border-bottom:2px solid transparent; cursor:pointer;">
        <i class="fas fa-shield-alt" style="margin-right:6px;"></i> Xavfsizlik & Parol
      </button>
    </div>

    <!-- Tab Content Scrollable Area -->
    <div style="flex:1; overflow-y:auto; padding:32px;">
      
      <!-- TAB 1: INFO -->
      <div id="profileTabInfo" style="display:flex; flex-direction:column; gap:24px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          <div class="form-group" style="margin:0;">
            <label class="form-label" style="font-weight:700; font-size:13px; margin-bottom:6px;">Ism va Familiya <span style="color:var(--danger)">*</span></label>
            <input type="text" id="profileFullNameInput" class="form-control" value="<%= user.fullName || '' %>" placeholder="Ism Familiya" style="height:42px; font-size:14px;">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label" style="font-weight:700; font-size:13px; margin-bottom:6px;">Email (Login manzil)</label>
            <input type="text" class="form-control" value="<%= user.email %>" readonly style="height:42px; font-size:14px; background:var(--bg-secondary); cursor:not-allowed;">
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
          <div style="padding:16px; background:var(--bg-secondary); border-radius:12px; border:1px solid var(--border);">
            <div style="font-size:12px; color:var(--text-tertiary); font-weight:600; text-transform:uppercase;">Lavozim</div>
            <div style="font-size:14px; font-weight:800; color:var(--text-primary); margin-top:4px;">
              <%= user.role === 'admin' ? '🛡️ Administrator' : '💼 Operator / Manager' %>
            </div>
          </div>
          <div style="padding:16px; background:var(--bg-secondary); border-radius:12px; border:1px solid var(--border);">
            <div style="font-size:12px; color:var(--text-tertiary); font-weight:600; text-transform:uppercase;">Tizimdagi status</div>
            <div style="font-size:14px; font-weight:800; color:#10B981; margin-top:4px;">🟢 Aktiv Akkont</div>
          </div>
          <div style="padding:16px; background:var(--bg-secondary); border-radius:12px; border:1px solid var(--border);">
            <div style="font-size:12px; color:var(--text-tertiary); font-weight:600; text-transform:uppercase;">Xavfsizlik darajasi</div>
            <div style="font-size:14px; font-weight:800; color:#6366F1; margin-top:4px;">🔒 Yuqori (Encrypted)</div>
          </div>
        </div>

        <div style="padding:20px; background:var(--bg-secondary); border-radius:12px; border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-size:14px; font-weight:700; color:var(--text-primary);">Akkount xavfsizligi va Parol</div>
            <div style="font-size:12px; color:var(--text-tertiary); margin-top:2px;">Parolingizni vaqtida yangilab turish tavsiya etiladi</div>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" onclick="switchProfileTab('security')" style="font-weight:700; font-size:12.5px;">
            <i class="fas fa-key" style="color:#F59E0B; margin-right:4px;"></i> Parolni o'zgartirish
          </button>
        </div>
      </div>

      <!-- TAB 2: SECURITY -->
      <div id="profileTabSecurity" class="hidden" style="display:flex; flex-direction:column; gap:20px;">
        <div style="padding:20px; background:var(--bg-secondary); border-radius:12px; border:1px solid var(--border); display:flex; flex-direction:column; gap:16px;">
          <h4 style="margin:0; font-size:15px; font-weight:700; color:var(--text-primary);">Tizimga kirish parolini yangilash</h4>
          
          <div class="form-group" style="margin:0;">
            <label class="form-label" style="font-weight:600; font-size:13px;">Hozirgi amaldagi parol</label>
            <input type="password" id="profilePwCurrent" class="form-control" placeholder="••••••••" style="height:42px;">
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="form-group" style="margin:0;">
              <label class="form-label" style="font-weight:600; font-size:13px;">Yangi parol</label>
              <input type="password" id="profilePwNew" class="form-control" placeholder="••••••••" style="height:42px;">
            </div>
            <div class="form-group" style="margin:0;">
              <label class="form-label" style="font-weight:600; font-size:13px;">Yangi parolni qayta takrorlang</label>
              <input type="password" id="profilePwConfirm" class="form-control" placeholder="••••••••" style="height:42px;">
            </div>
          </div>
          <div style="display:flex; justify-content:flex-end;">
            <button type="button" class="btn btn-primary" onclick="submitProfilePasswordChange()" style="font-size:13px; font-weight:700;">
              <i class="fas fa-lock" style="margin-right:4px;"></i> Parolni saqlash
            </button>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- Password change modal -->
<div class="modal-overlay hidden" id="passwordModal">
  <div class="modal-box">
    <div class="modal-header">
      <h2>Parol o'zgartirish</h2>
      <button class="modal-close" onclick="closePasswordModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Joriy parol</label>
        <input type="password" id="pwCurrent" class="form-control" placeholder="••••••••">
      </div>
      <div class="form-group">
        <label class="form-label">Yangi parol</label>
        <input type="password" id="pwNew" class="form-control" placeholder="••••••••">
      </div>
      <div class="form-group">
        <label class="form-label">Yangi parolni takrorlang</label>
        <input type="password" id="pwConfirm" class="form-control" placeholder="••••••••">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closePasswordModal()">Bekor</button>
      <button class="btn btn-primary" onclick="submitPasswordChange()">Saqlash</button>
    </div>
  </div>
</div>

<script>
async function loadNotifications() {
  try {
    const res = await fetch('/api/notifications');
    if (!res.ok) return;
    const notifs = await res.json();
    const unread = notifs.filter(n => !n.read).length;
    const countEl = document.getElementById('notifCount');
    if (unread > 0) {
      countEl.textContent = unread > 9 ? '9+' : unread;
      countEl.classList.remove('hidden');
    } else {
      countEl.classList.add('hidden');
    }

    const list = document.getElementById('notifList');
    if (!notifs.length) {
      list.innerHTML = "<div class='empty-state' style='padding:24px;'>Bildirishnoma yo'q</div>";
      return;
    }
    list.innerHTML = notifs.map(n => `
      <div class="notif-item ${n.read ? '' : 'notif-unread'}"
           ${n.read ? '' : `onclick="markAsRead('${n.id}',this)"`}
           style="cursor:${n.read ? 'default' : 'pointer'}">
        <div style="font-size:16px;color:${n.type==='overdue'?'var(--danger)':'var(--warning)'};flex-shrink:0;margin-top:1px;">
          <i class="fas fa-${n.type==='overdue'?'exclamation-circle':'clock'}"></i>
        </div>
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--text-900);margin-bottom:2px;">${n.title}</div>
          <div style="font-size:12px;color:var(--text-500);">${n.message}</div>
        </div>
      </div>`).join('');
  } catch(e) {}
}

function toggleNotifPanel() {
  document.getElementById('profileMenu').classList.add('hidden');
  document.getElementById('notifPanel').classList.toggle('hidden');
  if (!document.getElementById('notifPanel').classList.contains('hidden')) loadNotifications();
}

async function markAllRead() {
  await fetch('/api/notifications/read-all', { method: 'POST' });
  document.getElementById('notifCount').classList.add('hidden');
  loadNotifications();
}

async function markAsRead(id, el) {
  if (!el.classList.contains('notif-unread')) return;
  await fetch('/api/notifications/' + id + '/read', { method: 'POST' });
  el.classList.remove('notif-unread');
  el.style.opacity = '0';
  el.style.transition = 'opacity 0.25s';
  setTimeout(() => {
    el.remove();
    const countEl = document.getElementById('notifCount');
    let count = parseInt(countEl.textContent) || 0;
    if (--count > 0) { countEl.textContent = count > 9 ? '9+' : count; }
    else { countEl.classList.add('hidden'); }
    const list = document.getElementById('notifList');
    if (!list.querySelector('.notif-item')) {
      list.innerHTML = "<div class='empty-state' style='padding:24px;'>Bildirishnoma yo'q</div>";
    }
  }, 250);
}

// ── Profile dropdown ──
function toggleProfileMenu() {
  document.getElementById('notifPanel').classList.add('hidden');
  document.getElementById('profileMenu').classList.toggle('hidden');
}

document.addEventListener('click', (e) => {
  const pw = document.getElementById('profileWrap');
  const nw = document.getElementById('notifWrap');
  if (pw && !pw.contains(e.target)) document.getElementById('profileMenu')?.classList.add('hidden');
  if (nw && !nw.contains(e.target)) document.getElementById('notifPanel')?.classList.add('hidden');
});

// ── Password modal ──
function openPasswordModal() {
  document.getElementById('profileMenu').classList.add('hidden');
  document.getElementById('passwordModal').classList.remove('hidden');
}

function closePasswordModal() {
  document.getElementById('passwordModal').classList.add('hidden');
  ['pwCurrent','pwNew','pwConfirm'].forEach(id => { document.getElementById(id).value = ''; });
}

async function submitPasswordChange() {
  const current = document.getElementById('pwCurrent').value;
  const newPw   = document.getElementById('pwNew').value;
  const confirm = document.getElementById('pwConfirm').value;
  if (!current || !newPw) return showToast("Barcha maydonlarni to'ldiring", 'error');
  if (newPw !== confirm)  return showToast('Yangi parollar mos kelmadi', 'error');
  if (newPw.length < 6)   return showToast("Parol kamida 6 ta belgi bo'lishi kerak", 'error');
  try {
    const res = await fetch('/api/auth/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ currentPassword: current, newPassword: newPw })
    });
    const data = await res.json();
    if (!res.ok) return showToast(data.message || 'Xatolik yuz berdi', 'error');
    showToast("Parol muvaffaqiyatli o'zgartirildi", 'success');
    closePasswordModal();
  } catch(e) { showToast("Server bilan bog'lanishda xatolik", 'error'); }
}

// ── Mobile menu ──
function toggleMobileMenu() {
  document.querySelector('.sidebar').classList.toggle('mobile-open');
}

// ── Profile Modal Handlers ──
let currentAvatarBase64 = null;

function switchProfileTab(tab) {
  const t1 = document.getElementById('pTab1');
  const t2 = document.getElementById('pTab2');
  const i1 = document.getElementById('profileTabInfo');
  const i2 = document.getElementById('profileTabSecurity');

  if (tab === 'info') {
    t1.classList.add('active');
    t1.style.color = 'var(--brand)';
    t1.style.borderBottomColor = 'var(--brand)';
    t2.classList.remove('active');
    t2.style.color = 'var(--text-secondary)';
    t2.style.borderBottomColor = 'transparent';
    i1.classList.remove('hidden');
    i2.classList.add('hidden');
  } else {
    t2.classList.add('active');
    t2.style.color = 'var(--brand)';
    t2.style.borderBottomColor = 'var(--brand)';
    t1.classList.remove('active');
    t1.style.color = 'var(--text-secondary)';
    t1.style.borderBottomColor = 'transparent';
    i2.classList.remove('hidden');
    i1.classList.add('hidden');
  }
}
window.switchProfileTab = switchProfileTab;

async function submitProfilePasswordChange() {
  const current = document.getElementById('profilePwCurrent')?.value;
  const newPw   = document.getElementById('profilePwNew')?.value;
  const confirm = document.getElementById('profilePwConfirm')?.value;

  if (!current || !newPw) return showToast("Barcha maydonlarni to'ldiring", 'error');
  if (newPw !== confirm)  return showToast('Yangi parollar mos kelmadi', 'error');
  if (newPw.length < 6)   return showToast("Parol kamida 6 ta belgi bo'lishi kerak", 'error');

  try {
    const res = await fetch('/api/auth/change-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ currentPassword: current, newPassword: newPw })
    });
    const data = await res.json();
    if (!res.ok) return showToast(data.message || 'Xatolik yuz berdi', 'error');
    showToast("Parol muvaffaqiyatli o'zgartirildi", 'success');
    if (document.getElementById('profilePwCurrent')) document.getElementById('profilePwCurrent').value = '';
    if (document.getElementById('profilePwNew')) document.getElementById('profilePwNew').value = '';
    if (document.getElementById('profilePwConfirm')) document.getElementById('profilePwConfirm').value = '';
  } catch(e) { showToast("Server bilan bog'lanishda xatolik", 'error'); }
}
window.submitProfilePasswordChange = submitProfilePasswordChange;

function openUserProfileModal() {
  document.getElementById('profileMenu').classList.add('hidden');
  document.getElementById('userProfileModal').classList.remove('hidden');
}

function closeUserProfileModal() {
  document.getElementById('userProfileModal').classList.add('hidden');
}

function handleAvatarFileSelect(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    if (typeof showToast === 'function') showToast("Rasm hajmi 5MB dan kichik bo'lishi kerak", 'error');
    return;
  }
  const reader = new FileReader();
  reader.onload = function(e) {
    currentAvatarBase64 = e.target.result;
    const preview = document.getElementById('profileAvatarPreview');
    preview.innerHTML = `<img src="${currentAvatarBase64}" style="width:100%; height:100%; object-fit:cover;">`;
  };
  reader.readAsDataURL(file);
}

function resetProfileAvatar() {
  currentAvatarBase64 = '';
  const preview = document.getElementById('profileAvatarPreview');
  const initial = (document.getElementById('profileFullNameInput')?.value || 'U').charAt(0).toUpperCase();
  preview.innerHTML = `<span>${initial}</span>`;
}

async function submitUserProfileSave() {
  const fullName = document.getElementById('profileFullNameInput')?.value.trim();
  if (!fullName) {
    if (typeof showToast === 'function') showToast("Ism va familiya majburiy", 'error');
    return;
  }

  const payload = { fullName };
  if (currentAvatarBase64 !== null) {
    payload.avatar = currentAvatarBase64;
  }

  try {
    const res = await fetch('/api/auth/profile', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok) {
      if (typeof showToast === 'function') showToast(data.message || 'Xatolik', 'error');
      return;
    }
    if (typeof showToast === 'function') showToast("Profil muvaffaqiyatli saqlandi", 'success');
    closeUserProfileModal();
    setTimeout(() => window.location.reload(), 500);
  } catch(e) {
    if (typeof showToast === 'function') showToast("Server bilan ulanishda xatolik", 'error');
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadNotifications();
  setInterval(loadNotifications, 2 * 60 * 1000);

  function updateTopTashkentClock() {
    const clockEl = document.getElementById('topbarTashkentClock');
    if (!clockEl) return;
    const now = new Date();
    const optionsDate = { timeZone: 'Asia/Tashkent', day: '2-digit', month: 'long', year: 'numeric' };
    const optionsTime = { timeZone: 'Asia/Tashkent', hour: '2-digit', minute: '2-digit', hour12: false };
    const dateStr = now.toLocaleDateString('uz-UZ', optionsDate);
    const timeStr = now.toLocaleTimeString('uz-UZ', optionsTime);
    clockEl.textContent = `${dateStr} | ${timeStr}`;
  }
  updateTopTashkentClock();
  setInterval(updateTopTashkentClock, 1000);
});
</script>
