async function saveClientDetails(clientId) {
  const btn = document.getElementById('btnSaveDetails');
  btn.disabled = true;
  btn.textContent = 'Saqlanmoqda...';

  const payload = {
    clientId,
    name: document.getElementById('editClientName').value.trim(),
    phone: document.getElementById('editClientPhone').value.trim(),
    email: document.getElementById('editClientEmail').value.trim(),
    city: document.getElementById('editClientCity').value.trim(),
    notes: document.getElementById('editClientNotes').value.trim()
  };

  try {
    const res = await fetch('/api/instagram/update-client', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      _toast('Mijoz ma\'lumotlari saqlandi!', 'success');
      loadClientDetails(clientId);
      loadClients(); // Reload chat list to reflect updated name
    } else {
      const err = await res.json();
      _toast(err.error || 'Saqlashda xatolik', 'error');
    }
  } catch (err) {
    console.error(err);
    _toast('Saqlashda tarmoq xatosi yuz berdi', 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Saqlash';
  }
}

function escapeQuotes(str) {
  if (!str) return '';
  return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
}

async function loadMessages(clientId) {
  try {
    const res = await fetch('/api/instagram/messages/' + clientId);
    const messages = await res.json();
    
    const isComment = messages.some(m => m.messageId && m.messageId.startsWith('comment_'));
    const statusEl = document.getElementById('chatHeaderStatus');
    if (statusEl) {
      statusEl.innerHTML = `
        <span class="active-dot-green"></span>
        ${isComment ? 'Instagram Comment orqali bog\'langan' : 'Instagram Direct orqali bog\'langan'}
      `;
    }
    
    // Refresh sidebar unread counts dynamically
    if (typeof window.updateSidebarChatBadges === 'function') {
      window.updateSidebarChatBadges();
    }
    
    const container = document.getElementById('chatMessages');
    container.innerHTML = '';
    
    if (messages.length === 0) {
      container.innerHTML = '<div style="text-align: center; color: var(--text-300); padding: 20px;">Xabarlar yo\'q</div>';
      return;
    }
    
    let lastDateStr = '';
    
    messages.forEach(m => {
      const date = new Date(m.timestamp);
      const dateStr = date.toLocaleDateString('uz-UZ', { day: 'numeric', month: 'long', year: 'numeric' });
      
      if (dateStr !== lastDateStr) {
        const divider = document.createElement('div');
        divider.className = 'chat-date-divider';
        
        const today = new Date().toLocaleDateString('uz-UZ', { day: 'numeric', month: 'long', year: 'numeric' });
        const yesterday = new Date(Date.now() - 86400000).toLocaleDateString('uz-UZ', { day: 'numeric', month: 'long', year: 'numeric' });
        
        let label = dateStr;
        if (dateStr === today) label = 'Bugun';
        else if (dateStr === yesterday) label = 'Kecha';
        
        divider.innerHTML = `<span>${label}</span>`;
        container.appendChild(divider);
        lastDateStr = dateStr;
      }
      
      const div = document.createElement('div');
      div.className = `msg-bubble ${m.isOutgoing ? 'msg-out' : 'msg-in'}`;
      
      let contentHtml = '';
      if (m.attachmentType === 'image' && m.attachmentUrl) {
        contentHtml = `
          <div class="msg-attachment-container" style="max-width: 250px; overflow: hidden; border-radius: 8px;">
            <img src="${m.attachmentUrl}" class="msg-img-attachment" onclick="openImageModal('${m.attachmentUrl}')" alt="Instagram Rasm" style="max-width: 100%; border-radius: 8px; cursor: pointer; display: block;">
            ${m.text ? `<div style="margin-top: 8px; padding: 4px; font-size:12.5px;">${m.text}</div>` : ''}
          </div>
        `;
      } else if (m.attachmentType === 'audio' && m.attachmentUrl) {
        contentHtml = `
          <div class="msg-attachment-container" style="max-width: 280px; padding: 4px;">
            <audio controls src="${m.attachmentUrl}" class="msg-audio-attachment" style="max-width: 100%; height: 36px; border-radius: 18px;"></audio>
            ${m.text ? `<div style="margin-top: 8px; font-size:12.5px;">${m.text}</div>` : ''}
          </div>
        `;
      } else if (m.attachmentType === 'video' && m.attachmentUrl) {
        contentHtml = `
          <div class="msg-attachment-container" style="max-width: 250px; overflow: hidden; border-radius: 8px;">
            <video controls src="${m.attachmentUrl}" class="msg-video-attachment" style="max-width: 100%; max-height: 240px; border-radius: 8px; display: block;"></video>
            ${m.text ? `<div style="margin-top: 8px; padding: 4px; font-size:12.5px;">${m.text}</div>` : ''}
          </div>
        `;
      } else {
        // Auto-linkify text
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        const linkedText = (m.text || '').replace(urlRegex, function(url) {
          return '<a href="' + url + '" target="_blank" style="color: inherit; text-decoration: underline;">' + url + '</a>';
        });
        contentHtml = `<div>${linkedText}</div>`;
      }
      
      const time = new Date(m.timestamp).toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' });
      div.innerHTML = `
        ${contentHtml}
        <div class="msg-time">${time}</div>
      `;
      container.appendChild(div);
    });
    
    container.scrollTop = container.scrollHeight;
  } catch (error) {
    console.error('Error loading messages:', error);
  }
}

// ── FILE ATTACHMENT UPLOAD FUNKSIONALI ──
let selectedFileBase64 = null;
let selectedFileName = '';
let selectedFileType = '';

function handleFileSelect(input) {
  const file = input.files[0];
  if (!file) return;

  // Validate size (max 15MB)
  if (file.size > 15 * 1024 * 1024) {
    _toast('Fayl hajmi 15MB dan oshmasligi kerak!', 'error');
    input.value = '';
    return;
  }

  const reader = new FileReader();
  reader.onload = function(e) {
    const rawBase64 = e.target.result.split(',')[1];
    selectedFileBase64 = rawBase64;
    selectedFileName = file.name;

    // Determine type
    if (file.type.startsWith('image/')) {
      selectedFileType = 'image';
    } else if (file.type.startsWith('video/')) {
      selectedFileType = 'video';
    } else if (file.type.startsWith('audio/')) {
      selectedFileType = 'audio';
    } else {
      selectedFileType = 'document';
    }

    // Show preview
    const preview = document.getElementById('attachmentPreview');
    const content = document.getElementById('attachmentPreviewContent');
    preview.style.display = 'flex';
    content.innerHTML = `
      <i class="fas ${selectedFileType === 'image' ? 'fa-image' : selectedFileType === 'video' ? 'fa-video' : 'fa-music'}" style="color: var(--brand); font-size: 14px;"></i>
      <span>${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)</span>
    `;
  };
  reader.readAsDataURL(file);
}

function clearAttachment() {
  selectedFileBase64 = null;
  selectedFileName = '';
  selectedFileType = '';
  document.getElementById('msgFileInput').value = '';
  document.getElementById('attachmentPreview').style.display = 'none';
}

async function sendMessage() {
  if (!currentClientId) return;
  
  const input = document.getElementById('msgInput');
  const text = input.value.trim();

  // Make sure we have text or an attachment to send
  if (!text && !selectedFileBase64) return;
  
  input.value = '';
  
  const container = document.getElementById('chatMessages');
  const div = document.createElement('div');
  div.className = 'msg-bubble msg-out';
  const time = new Date().toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' });
  
  // Show temporary status
  div.innerHTML = `
    <div>${text || `[Fayl yuklanmoqda: ${selectedFileName}]`}</div>
    <div class="msg-time">${time} <i class="fas fa-clock" style="font-size: 8px;"></i></div>
  `;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;

  // Local backups for file upload payload
  const b64 = selectedFileBase64;
  const fName = selectedFileName;
  const fType = selectedFileType;

  clearAttachment(); // Clear preview immediately for UI responsiveness
  
  try {
    let attachmentUrl = null;

    // 1. Upload file if selected
    if (b64) {
      const uploadRes = await fetch('/api/instagram/upload-base64', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ base64Data: b64, fileName: fName })
      });

      if (!uploadRes.ok) {
        throw new Error('Faylni serverga yuklashda xatolik yuz berdi');
      }
      const uploadData = await uploadRes.json();
      attachmentUrl = uploadData.fileUrl;
    }

    // 2. Send message via CRM API
    const res = await fetch('/api/instagram/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        clientId: currentClientId,
        text,
        attachmentUrl,
        attachmentType: attachmentUrl ? fType : null
      })
    });
    
    if (res.ok) {
      div.querySelector('.fa-clock').className = 'fas fa-check';
      loadClients();
      loadMessages(currentClientId); // Reload to display uploaded content properly
    } else {
      const errorData = await res.json();
      div.querySelector('.fa-clock').className = 'fas fa-exclamation-circle';
      div.querySelector('.fa-exclamation-circle').style.color = '#ff5e5e';
      const errMsg = errorData.error || 'Yuborishda xatolik yuz berdi';
      _toast(`Instagram API Xatosi: ${errMsg}`, 'error');
    }
  } catch (error) {
    console.error('Error sending message:', error);
    div.querySelector('.fa-clock').className = 'fas fa-exclamation-circle';
    div.querySelector('.fa-exclamation-circle').style.color = '#ff5e5e';
    _toast(error.message || 'Tarmoqda xatolik yuz berdi', 'error');
  }
}

function openImageModal(url) {
  const modal = document.getElementById('imageModal');
  const img = document.getElementById('modalImg');
  img.src = url;
  modal.classList.remove('hidden');
}

function closeImageModal() {
  document.getElementById('imageModal').classList.add('hidden');
}

function openCreateDealModal(clientId, clientName) {
  document.getElementById('dealClientId').value = clientId;
  document.getElementById('dealClientName').value = clientName;
  document.getElementById('dealProductName').value = '';
  document.getElementById('dealAmount').value = '0';
  document.getElementById('dealNotes').value = '';
  
  const pipelineSelect = document.getElementById('dealPipelineId');
  pipelineSelect.innerHTML = '';
  
  allPipelines.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.id;
    opt.textContent = p.name;
    if (p.isDefault) opt.selected = true;
    pipelineSelect.appendChild(opt);
  });
  
  onPipelineChange();
  
  document.getElementById('dealModal').classList.remove('hidden');
}

function onPipelineChange() {
  const pipelineId = Number(document.getElementById('dealPipelineId').value);
  const stageSelect = document.getElementById('dealStageId');
  stageSelect.innerHTML = '';
  
  const pipeline = allPipelines.find(p => p.id === pipelineId);
  if (pipeline && pipeline.stages) {
    pipeline.stages.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = s.name;
      if (s.isDefault) opt.selected = true;
      stageSelect.appendChild(opt);
    });
  }
}

function closeDealModal() {
  document.getElementById('dealModal').classList.add('hidden');
}

async function submitCreateDeal() {
  const clientId = Number(document.getElementById('dealClientId').value);
  const productName = document.getElementById('dealProductName').value.trim();
  const amount = Number(document.getElementById('dealAmount').value);
  const pipelineId = Number(document.getElementById('dealPipelineId').value);
  const stageId = Number(document.getElementById('dealStageId').value);
  const notes = document.getElementById('dealNotes').value.trim();
  
  if (!productName) {
    _toast('Mahsulot nomi majburiy!', 'error');
    return;
  }
  
  try {
    const res = await fetch('/api/deals', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        productName,
        amount,
        pipelineId,
        stageId,
        clientId,
        notes,
        status: 'new'
      })
    });
    
    if (res.ok) {
      _toast('Sdelka muvaffaqiyatli yaratildi!', 'success');
      closeDealModal();
      loadClientDetails(clientId);
    } else {
      const err = await res.json();
      _toast(err.message || 'Sdelka yaratishda xatolik', 'error');
    }
  } catch (error) {
    console.error('Error creating deal:', error);
    _toast('Tarmoq xatoligi yuz berdi', 'error');
  }
}

function _toast(msg, type) {
  if (typeof showToast === 'function') {
    showToast(msg, type);
  } else {
    alert(msg);
  }
}

let isWazzupIframeActive = false;

async function toggleWazzupIframe(clientId) {
  const chatMessages = document.getElementById('chatMessages');
  const chatInputArea = document.querySelector('.chat-input-area');
  const toggleBtn = document.getElementById('toggleWazzupBtn');
  
  let iframeContainer = document.getElementById('wazzupIframeContainer');
  
  if (isWazzupIframeActive) {
    if (iframeContainer) iframeContainer.style.display = 'none';
    chatMessages.style.display = 'block';
    chatInputArea.style.display = 'flex';
    toggleBtn.style.background = 'var(--surface-card)';
    isWazzupIframeActive = false;
  } else {
    chatMessages.style.display = 'none';
    chatInputArea.style.display = 'none';
    
    if (!iframeContainer) {
      iframeContainer = document.createElement('div');
      iframeContainer.id = 'wazzupIframeContainer';
      iframeContainer.style.flex = '1';
      iframeContainer.style.width = '100%';
      iframeContainer.style.height = 'calc(100% - 55px)';
      iframeContainer.style.display = 'flex';
      iframeContainer.style.alignItems = 'center';
      iframeContainer.style.justifyContent = 'center';
      chatMessages.parentNode.insertBefore(iframeContainer, chatInputArea);
    }
    
    iframeContainer.style.display = 'flex';
    iframeContainer.innerHTML = '<div style="color: var(--text-300); font-size: 13.5px;"><i class="fas fa-spinner fa-spin" style="margin-right: 6px;"></i> Wazzup asl chat oynasi yuklanmoqda...</div>';
    toggleBtn.style.background = 'var(--surface-elevated)';
    
    try {
      const res = await fetch('/api/instagram/iframe-url', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ clientId, chatType: 'instagram' })
      });
      
      if (!res.ok) throw new Error('Failed to load Wazzup iframe URL');
      const data = await res.json();
      
      iframeContainer.innerHTML = `
        <iframe src="${data.url}" 
                allow="microphone *; clipboard-write *" 
                style="width: 100%; height: 100%; border: none; background: var(--bg-primary);"
                frameborder="0">
        </iframe>
      `;
      isWazzupIframeActive = true;
    } catch (err) {
      console.error(err);
      iframeContainer.innerHTML = `
        <div style="color: var(--danger); font-size: 13px; text-align: center; padding: 20px;">
          <i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i>
          Wazzup oynasini yuklab bo'lmadi. API kalit yoki ulanishni tekshiring.
        </div>
      `;
    }
  }
}
</script>
