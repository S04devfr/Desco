// ── Bulk Actions Logic ─────────────────────────────────────────
function onCardSelect(checkbox) {
  const id = parseInt(checkbox.value, 10);
  if (checkbox.checked) {
    if (!_selectedDeals.includes(id)) {
      _selectedDeals.push(id);
    }
  } else {
    _selectedDeals = _selectedDeals.filter(x => x !== id);
  }
  updateBulkActionBar();
}

function updateBulkActionBar() {
  const bar = document.getElementById('bulkActionBar');
  const countSpan = document.getElementById('bulkSelectCount');
  if (!bar) return;
  
  if (_selectedDeals.length > 0) {
    bar.classList.remove('hidden');
    if (countSpan) countSpan.textContent = _selectedDeals.length;
  } else {
    bar.classList.add('hidden');
  }
}

function clearBulkSelection() {
  _selectedDeals = [];
  document.querySelectorAll('.dcard-checkbox').forEach(cb => {
    cb.checked = false;
  });
  updateBulkActionBar();
}

function selectBulkInColumn(stageId, count) {
  const stageDeals = _deals.filter(d => d.stageId === stageId);
  const sortOrder = _stageSorts[stageId] || 'newest';
  if (sortOrder === 'newest') {
    stageDeals.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  } else if (sortOrder === 'oldest') {
    stageDeals.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
  }
  
  const toSelect = stageDeals.slice(0, count);
  toSelect.forEach(d => {
    if (!_selectedDeals.includes(d.id)) {
      _selectedDeals.push(d.id);
    }
  });
  
  updateBulkActionBar();
  renderKanban();
}

async function bulkMoveToOtkaz() {
  if (!_selectedDeals.length) return;
  
  if (_usingMockStages) {
    _toast("Bu namuna bosqich — avval voronkani sozlang", 'error');
    return;
  }
  
  const count = _selectedDeals.length;
  if (!confirm(`${count} ta sdelkani 'Otkaz' (rad etilgan) holatiga o'tkazishni tasdiqlaysizmi?`)) {
    return;
  }
  
  const btn = document.getElementById('bulkMoveBtn');
  if (btn) btn.disabled = true;
  
  const targetStage = _stages.find(s => {
    const n = (s.name || '').toLowerCase();
    return n.includes('rad') || n.includes('otkaz') || n.includes('yo\'qotilgan') || n.includes('lost') || n.includes('отказ') || n.includes('рад');
  });
  
  const targetStageId = targetStage ? targetStage.id : null;
  
  try {
    const res = await apiFetch('/api/deals/bulk/stage', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        ids: _selectedDeals,
        stageId: targetStageId,
        status: 'lost'
      })
    });
    
    _toast(res.message || "Sdelkalar otkazga o'tkazildi", 'success');
    _selectedDeals = [];
    updateBulkActionBar();
    await loadDeals();
  } catch (err) {
    _toast(err.message, 'error');
  } finally {
    if (btn) btn.disabled = false;
  }
}

function toggleSelectionMode() {
  _selectionMode = !_selectionMode;
  document.querySelector('.deals-page').classList.toggle('selection-mode-active', _selectionMode);
  const btn = document.getElementById('btnSelectMode');
  if (btn) btn.classList.toggle('active', _selectionMode);
  if (!_selectionMode) {
    clearBulkSelection();
  }
}

