  }
  .kb-col-hdr-quickadd-btn:hover {
    color: var(--accent);
    background: var(--bg-primary);
  }
  .kb-col-qadd-container {
    padding: 8px 10px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    display: none;
    flex-direction: column;
    gap: 8px;
  }
  .kb-col-qadd-container.open {
    display: flex;
  }
  .kb-col-qadd-input {
    width: 100%;
    height: 28px;
    font-size: 12px;
    padding: 0 8px;
