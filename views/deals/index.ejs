async function moveDeal(dealId, stageId) {
  if (_usingMockStages && stageId !== null && stageId !== undefined && Number(stageId) < 0) {
    _toast("Bu namuna bosqich — avval voronkani sozlang", 'error');
    return;
  }
  
  const targetStage = _stages.find(s => s.id === Number(stageId));
  const tStageName = targetStage ? targetStage.name.toLowerCase() : '';
  const isCallback = tStageName.includes('qayta') || tStageName.includes('aloqa') || tStageName.includes('ko\'tarmadi') || tStageName.includes('kotarmadi');
  
  if (isCallback) {
    // Re-render Kanban immediately to reset the card position visually while we prompt the user
    renderKanban();
    // Open detail drawer and trigger callback scheduler box
    openDetail(dealId);
    setTimeout(() => {
      changeDrawerStage(stageId);
    }, 280);
    return;
  }

  try {
    const updated = await apiFetch('/api/deals/' + dealId + '/stage', {
      method:'PATCH', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ stageId })
    });
    
    // Optimistic UI update instead of reloading everything
    const deal = _deals.find(d => d.id === dealId);
    if (deal) {
      Object.assign(deal, updated);
      renderKanban();
    }
    
    _toast('Bosqich o\'zgartirildi', 'success');

    // Nasiya Desco: muddatli to'lov modal
    const tStage = _stages.find(s => s.id === Number(stageId));
    if (tStage && /nasiya.?desco/i.test(tStage.name)) {
      const deal = _deals.find(d => d.id === dealId);
      if (deal) openNasiyaDescoModal(deal);
    }

    closeDetail();
  } catch(e) { _toast(e.message, 'error'); }
}

