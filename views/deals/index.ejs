      <td style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${d.manager?_esc(d.manager.fullName||d.manager.email):''}">${d.manager?_esc(d.manager.fullName||d.manager.email):'—'}</td>
      <td onclick="event.stopPropagation()">
