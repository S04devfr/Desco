      <!-- Avatar + Client Info -->
      <div style="display:flex; align-items:center; gap:10px;">
        <div class="dcard-av" style="background:linear-gradient(135deg, ${stageColor}, ${stageColor}bb); flex-shrink:0; color:#fff; border:none; width:26px; height:26px; font-size:11px;">${initials}</div>
        <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:2px;">
