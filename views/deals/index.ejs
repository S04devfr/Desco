    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 12px;
  }
  .drawer-back-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .drawer-back-btn:hover {
    background: var(--bg-secondary);
    color: var(--accent);
  }
  .drawer-title-input {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
