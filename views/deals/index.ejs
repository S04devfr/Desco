  .drawer-tab:hover {
    color: var(--text-primary);
  }
  .drawer-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Drawer Tab Contents */
  .drawer-tab-content {
    display: none;
  }
  .drawer-tab-content.active {
    display: block;
  }

  /* Field details */
  .detail-field-group {
    margin-bottom: 14px;
  }
  .detail-field-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .detail-field-value {
    font-size: 13.5px;
    color: var(--text-primary);
  }

  /* Contact and company card containers */
  .drawer-card-box {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    background: var(--bg-secondary);
    margin-bottom: 16px;
  }
  .drawer-card-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Timeline on the right */
  .timeline-header {
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(15, 23, 42, 0.2);
  }
  .timeline-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px 24px 24px 38px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
