          <i class="far fa-clock" style="color:var(--accent); font-size:13px; animation: live-clock-pulse 2s infinite ease-in-out;"></i>
          <span id="clockDate" style="letter-spacing:0.5px;">07.07.2026</span>
          <span style="color:var(--border); font-weight:400;">|</span>
          <span id="clockTime" style="color:var(--accent); letter-spacing:0.5px;">18:43:35</span>
