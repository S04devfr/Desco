function renderTimelineAndTasks(deal) {
  const timelineBody = document.getElementById('drawerTimelineBody');
  timelineBody.innerHTML = '';
  window._currentDeal = deal;

  const comments = [];
  const pendingTasks = [];
  const completedItems = [];

  if (deal.activities) {
    deal.activities.forEach(a => {
      const isComment = a.action === "Izoh qoldirildi" || 
                        a.action === "Izoh yozildi" || 
                        a.action === "Yangi izoh" || 
                        a.action === "Izoh qo'shildi";
      if (isComment) {
        comments.push({
          date: new Date(a.createdAt),
          author: a.user ? (a.user.fullName || a.user.email) : 'Tizim',
          details: a.details || '',
          id: a.id
        });
      }
    });
  }

  if (deal.tasks) {
    deal.tasks.forEach(t => {
      const item = {
        type: 'task',
        date: new Date(t.dueDate || t.createdAt),
        completed: t.completed,
        assignedTo: t.assignedTo ? (t.assignedTo.fullName || t.assignedTo.email) : 'Menejer',
        actionType: (t.actionType === 'Связаться' || !t.actionType) ? 'Aloqaga chiqish' : t.actionType,
        title: t.title || 'Vazifa',
        description: t.description || '',
        result: t.result || '',
        id: t.id
      };
      if (t.completed) {
        completedItems.push(item);
      } else {
        pendingTasks.push(item);
      }
    });
  }

  comments.sort((a, b) => a.date - b.date);

  // Sort pending tasks: NEAREST / OVERDUE FIRST (most urgent at top!)
  pendingTasks.sort((a, b) => a.date - b.date);

  // Sort completed items newest first
  completedItems.sort((a, b) => b.date - a.date);

  let html = '';

  // 1. Comments notebook
  html += `
    <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 18px; box-shadow: 0 2px 5px rgba(0,0,0,0.04); margin-bottom: 20px;">
      <div style="font-size: 11.5px; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
        <i class="fas fa-file-alt" style="color: #6366f1;"></i> Izohlar Daftari
      </div>
      <div id="comments-document-flow" style="display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto; padding-right: 4px;">
  `;

  if (comments.length > 0) {
    comments.forEach((c, idx) => {
      const isLast = idx === comments.length - 1;
      const borderStyle = isLast ? '' : 'border-bottom: 1px dashed #e2e8f0; padding-bottom: 10px;';
      html += `
        <div style="${borderStyle}">
          <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
            <span style="font-weight: 700; color: #6366f1;">✍️ ${c.author}</span>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>${c.date.toLocaleString('uz-UZ', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
              <button onclick="deleteDealComment(${c.id})" style="background:none; border:none; color:#cbd5e1; cursor:pointer; font-size:11px; padding:0;" title="Izohni o'chirish"><i class="fas fa-trash-alt"></i></button>
            </div>
          </div>
          <div style="white-space: pre-wrap; font-size: 12.5px; color: #334155; line-height: 1.4;">${_esc(c.details)}</div>
        </div>
      `;
    });
  } else {
    html += `<div style="text-align: center; padding: 20px 10px; color: #94a3b8; font-size: 12px; font-style: italic;">Hozircha izohlar yozilmagan.</div>`;
  }
  html += `</div></div>`;

  // 2. ACTIVE PENDING TASKS AT THE VERY TOP
  if (pendingTasks.length > 0) {
    html += `
      <div style="font-size: 11.5px; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display:flex; align-items:center; gap:6px;">
        <i class="fas fa-clock" style="color:var(--accent);"></i> Bajarilishi kerak bo'lgan vazifa
      </div>
    `;

    pendingTasks.forEach(item => {
      const today = new Date().setHours(0,0,0,0);
      const taskTime = new Date(item.date).setHours(0,0,0,0);
      const diffDays = Math.round((taskTime - today) / (1000 * 60 * 60 * 24));
      const dayText = diffDays === 0 ? 'Bugun' : diffDays === 1 ? 'Ertaga' : diffDays === -1 ? 'Kecha' : diffDays < 0 ? `${Math.abs(diffDays)} KUN MUDDAT O'TDI` : `${diffDays} kun qoldi`;
      const isOverdue = diffDays < 0;
      const colorClass = isOverdue ? 'color:#ef4444; font-weight:800;' : 'color:#a78bfa; font-weight:800;';

      const isoDate = item.date.getFullYear() + '-' + String(item.date.getMonth() + 1).padStart(2, '0') + '-' + String(item.date.getDate()).padStart(2, '0');
      const isoTime = String(item.date.getHours()).padStart(2, '0') + ':' + String(item.date.getMinutes()).padStart(2, '0');

      html += `
        <div class="timeline-task-card" style="border-color:${isOverdue ? '#ef4444' : 'rgba(88,86,214,0.3)'}; margin-bottom:16px;" id="task-${item.id}">
          <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 6px;">
            <div class="timeline-task-header" style="margin-bottom:0">
              <i class="far fa-clock" style="${colorClass}"></i>
              <span style="${colorClass}"> KEYINGI VAZIFA: ${dayText} (${isoTime})</span>
            </div>
            <button class="btn btn-ghost btn-sm" onclick="toggleRescheduleForm(${item.id})" style="font-size:11px; padding:2px 6px; height:22px; color:var(--text-secondary); cursor:pointer;">
              <i class="fas fa-calendar-alt"></i> O'zgartirish
            </button>
          </div>
          
          <div id="reschedule-form-${item.id}" class="hidden" style="display:none; margin: 8px 0; padding: 10px; background: var(--bg-tertiary); border-radius: 6px; border: 1px solid var(--border); flex-direction: column; gap: 8px;">
            <div style="font-size: 11px; font-weight: 700; color: var(--text-secondary);">Vazifa vaqtini tahrirlash:</div>
            <div style="display: flex; gap: 6px;">
              <input type="date" id="reschedule-date-${item.id}" class="form-control" style="font-size:12px; padding:4px 8px; height:28px; flex:1;" value="${isoDate}">
              <input type="time" id="reschedule-time-${item.id}" class="form-control" style="font-size:12px; padding:4px 8px; height:28px; width:75px;" value="${isoTime}">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 6px;">
              <button class="btn btn-ghost btn-sm" style="font-size:11px; padding:2px 8px;" onclick="toggleRescheduleForm(${item.id})">Bekor qilish</button>
              <button class="btn btn-primary btn-sm" style="font-size:11px; padding:2px 10px; background:var(--brand);" onclick="saveRescheduledTask(${item.id})">Saqlash</button>
            </div>
          </div>

          <div class="timeline-task-title" style="margin-top:4px; font-size:13.5px;">${_esc(item.actionType)}: ${_esc(item.title)}</div>
          ${item.description ? `<div style="font-size:12px; color:var(--text-secondary); margin-bottom:6px;">${_esc(item.description)}</div>` : ''}
          <div class="timeline-task-result-box">
            <input type="text" id="task-res-${item.id}" class="timeline-task-input" placeholder="Natijani yozing...">
            <button class="btn btn-primary btn-sm" style="padding:2px 12px; font-size:12px; height:32px; font-weight:700;" onclick="completeTimelineTask(${item.id})">Bajarildi</button>
          </div>
        </div>
      `;
    });
  }

  // 3. COMPLETED HISTORY LOGS
  if (completedItems.length > 0) {
    html += `
      <div style="font-size: 11.5px; font-weight: 700; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 14px; margin-bottom: 10px;">
        📜 Bajarilgan Vazifalar va Tarix
      </div>
    `;

    completedItems.forEach(item => {
      html += `
        <div class="timeline-entry" style="border-left: 3px solid #10b981; margin-bottom:8px;" id="task-${item.id}">
          <div class="timeline-entry-meta">
            <span class="timeline-entry-author" style="color:#10b981;">${_esc(item.assignedTo)}</span>
            <span>Vazifa bajarildi · ${item.date.toLocaleDateString('uz-UZ')} ${item.date.toLocaleTimeString('uz-UZ', {hour: '2-digit', minute:'2-digit'})}</span>
          </div>
          <div><strong>${_esc(item.actionType)}</strong>: ${_esc(item.title)}</div>
          ${item.result ? `<div style="margin-top:4px; font-size:11px; padding:3px 8px; background:rgba(16,185,129,0.06); border-radius:4px; color:#10b981;"><b>Natija:</b> ${_esc(item.result)}</div>` : ''}
        </div>
      `;
    });
  }

  timelineBody.innerHTML = html || '<div style="text-align:center; padding:40px; color:var(--text-tertiary);">Tarix bo\'sh</div>';
  document.getElementById('dw-participants-count').textContent = `Vazifalar: ${pendingTasks.length}`;
}

function closeDetail() {
  document.body.classList.remove('detail-modal-open');
  document.getElementById('detailModal').classList.add('hidden');
  _detailId = null;
  window._currentDeal = null;
}

// ── Drawer Helper Functions ──
function switchDrawerTab(tabName, tabEl) {
  const tabs = document.querySelectorAll('.drawer-tab');
  tabs.forEach(t => t.classList.remove('active'));
  tabEl.classList.add('active');

  const contents = document.querySelectorAll('.drawer-tab-content');
  contents.forEach(c => c.classList.remove('active'));
  document.getElementById('tab-' + tabName).classList.add('active');
}

function toggleNasiyaCustomInputs() {
  const monthsSelect = document.getElementById('dw-nasiyaMonths')?.value;
  const customMonthsWrap = document.getElementById('dw-customMonthsWrap');
  if (customMonthsWrap) {
    customMonthsWrap.style.display = (monthsSelect === 'custom') ? 'flex' : 'none';
  }

  const dueDaySelect = document.getElementById('dw-nasiyaDueDay')?.value;
  const customDueDayWrap = document.getElementById('dw-customDueDayWrap');
  if (customDueDayWrap) {
    customDueDayWrap.style.display = (dueDaySelect === 'custom_date') ? 'flex' : 'none';
  }
}

function getNasiyaMonthsCount() {
  const monthsVal = document.getElementById('dw-nasiyaMonths')?.value;
  if (monthsVal === 'custom') {
    const customVal = Number(document.getElementById('dw-customMonthsInput')?.value);
    return (customVal && customVal > 0) ? customVal : 6;
  }
  return Number(monthsVal) || 6;
}

function recalculateDrawerNasiyaPlan() {
  const months = getNasiyaMonthsCount();
  const totalAmount = Number(document.getElementById('dw-amount')?.value) || 0;
  const downPayment = Number(document.getElementById('dw-nasiyaDownPayment')?.value) || 0;

  const remaining = Math.max(0, totalAmount - downPayment);
  const monthly = Math.round(remaining / months);

  const calcInput = document.getElementById('dw-nasiyaMonthlyVal');
  if (calcInput) {
    calcInput.value = monthly;
  }
}

async function saveDrawerNasiyaPlan(e) {
  if (e) e.stopPropagation();
  if (!_detailId) return;

  const months = getNasiyaMonthsCount();
  const totalAmount = Number(document.getElementById('dw-amount')?.value) || 0;
  const downPayment = Number(document.getElementById('dw-nasiyaDownPayment')?.value) || 0;
  const dueDayVal = document.getElementById('dw-nasiyaDueDay')?.value;
  const customDueDateVal = document.getElementById('dw-customDueDateInput')?.value;
  const customNote = document.getElementById('dw-nasiyaCustomNote')?.value?.trim() || '';

  const userCustomMonthly = Number(document.getElementById('dw-nasiyaMonthlyVal')?.value);
  const remaining = Math.max(0, totalAmount - downPayment);
  const monthly = (userCustomMonthly && userCustomMonthly > 0) ? userCustomMonthly : Math.round(remaining / months);

  const btn = document.getElementById('dwSaveNasiyaPlanBtn');
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saqlanmoqda...';
  }

  try {
    const installments = [];
    let dateObj = new Date();

    if (downPayment > 0) {
      installments.push({
        dueDate: dateObj.toISOString(),
        amount: downPayment,
        paid: true,
        month: '1-chi To\'lov (Boshlang\'ich)',
        notes: customNote ? `Boshlang'ich to'lov (${customNote})` : 'Boshlang\'ich to\'lov'
      });
    }

    const monthNames = ["Yanvar", "Fevral", "Mart", "Aprel", "May", "Iyun", "Iyul", "Avgust", "Sentabr", "Oktabr", "Noyabr", "Dekabr"];

    // Handle custom first due date if chosen
    let startDate = new Date();
    if (dueDayVal === 'custom_date' && customDueDateVal) {
      startDate = new Date(customDueDateVal);
    }

    for (let i = 0; i < months; i++) {
      let dueDateObj;
      if (dueDayVal === 'custom_date' && customDueDateVal) {
        dueDateObj = new Date(startDate.getFullYear(), startDate.getMonth() + i, startDate.getDate());
      } else {
        const targetDay = Number(dueDayVal) || 23;
        dueDateObj = new Date(startDate.getFullYear(), startDate.getMonth() + i + 1, targetDay);
      }

      const amount = (i === months - 1 && !userCustomMonthly) ? (remaining - (monthly * (months - 1))) : monthly;
      const noteSuffix = customNote ? ` - ${customNote}` : '';

      installments.push({
        dueDate: dueDateObj.toISOString(),
        amount: Math.max(0, amount),
        paid: false,
        month: monthNames[dueDateObj.getMonth()],
        notes: `${i + 1}-oylik to'lov (${dueDateObj.getDate()}-kuni)${noteSuffix}`
      });
    }

    await apiFetch('/api/deals/' + _detailId + '/installments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ installments })
    });

    _toast(`Nasiya Desco rejasi saqlandi! (${months} oy x ${monthly.toLocaleString()} so'm)`, 'success');
    await loadDeals();
  } catch (err) {
    _toast('Saqlashda xatolik: ' + err.message, 'error');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Nasiya Plani Saqlash & Oylarga Bo\'lish';
    }
  }
}

async function updateDrawerDealTitle(newTitle) {
  if (!newTitle || !newTitle.trim()) return;
  try {
    await apiFetch('/api/deals/' + _detailId, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productName: newTitle.trim() })
    });
    _toast("Sdelka nomi yangilandi", "success");
    loadDeals();
  } catch (e) {
    _toast(e.message, "error");
  }
}

async function saveDrawerField(field, value) {
  try {
    const body = {};
    body[field] = field === 'amount' ? Number(value) : value;
    await apiFetch('/api/deals/' + _detailId, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    _toast("Sdelka yangilandi", "success");
    loadDeals();
  } catch (e) {
    _toast(e.message, "error");
  }
}

async function saveDrawerClientField(field, value) {
  try {
    const body = {};
    body[field] = value;
    await apiFetch('/api/deals/' + _detailId, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    _toast("Mijoz yangilandi", "success");
    
    // Update local UI immediately
    if (field === 'companyName') {
      const companyLabelEl = document.getElementById('dw-contactCompanyLabel');
      if (companyLabelEl) {
        companyLabelEl.textContent = value ? value : 'o\'zim_uchun';
      }
    } else if (field === 'contactName') {
      const avatarEl = document.getElementById('dw-contactAvatar');
      if (avatarEl) {
        avatarEl.textContent = value ? value.charAt(0).toUpperCase() : '?';
      }
    }
    
    loadDeals();
  } catch (e) {
    _toast(e.message, "error");
  }
}

async function saveAllDrawerFieldsAndClose(event) {
  await saveAllDrawerFields(event);
  closeDetail();
}

async function saveAllDrawerFields(event) {
  if (window._pendingCallbackStageId) {
    _toast("Iltimos, avval qayta aloqa sanasi va vaqtini belgilab, o'ng tomondagi binafsharang 'Saqlash' tugmasini bosing!", "error");
    return;
  }
