function dealModalAutoGenerateInstallments(months) {
  const container = document.getElementById('dealModalInstRowsContainer');
  const amountInput = document.getElementById('f-amount');
  let totalAmount = Number(amountInput.value) || 0;
  
  if (totalAmount === 0) {
    if (typeof _toast === 'function') _toast('Iltimos, avval umumiy summani kiriting', 'error');
  }
  
  const paidInput = document.getElementById('f-paidAmount');
  const paidAmount = Number(paidInput.value) || 0;
  let remainingDebt = totalAmount - paidAmount;
  if (remainingDebt < 0) remainingDebt = 0;
  
  container.innerHTML = '';
  
  if (months > 0) {
    const monthlyAmount = Math.round(remainingDebt / months);
    let dateObj = new Date();
    
    for (let i = 0; i < months; i++) {
      dateObj.setMonth(dateObj.getMonth() + 1);
      const dateStr = dateObj.toISOString().slice(0, 10);
      const amount = (i === months - 1) ? (remainingDebt - (monthlyAmount * i)) : monthlyAmount;
      const pName = document.getElementById('f-name').options[document.getElementById('f-name').selectedIndex]?.text || 'Nasiya';
      
      const div = document.createElement('div');
      div.innerHTML = getDealModalInstallmentRowHtml(i, dateStr, amount, false, pName, `${i+1}-oy`, '');
      container.appendChild(div.firstElementChild);
    }
  }
}

function dealModalAddInstallmentRow() {
  const container = document.getElementById('dealModalInstRowsContainer');
  const index = container.querySelectorAll('.installment-row').length;
  const pName = document.getElementById('f-name').options[document.getElementById('f-name').selectedIndex]?.text || 'Nasiya';
  
  let dateStr = new Date().toISOString().slice(0, 10);
  if (index > 0) {
    const lastRow = container.lastElementChild;
    const lastDate = lastRow.querySelector('.inst-date').value;
    if (lastDate) {
      const d = new Date(lastDate);
      d.setMonth(d.getMonth() + 1);
      dateStr = d.toISOString().slice(0, 10);
    }
  }
  
  const div = document.createElement('div');
  div.innerHTML = getDealModalInstallmentRowHtml(index, dateStr, 0, false, pName, `${index+1}-oy`, '');
  container.appendChild(div.firstElementChild);
}

function getDealModalInstallmentRowHtml(index, dateVal, amountVal, paidVal, productVal, monthVal, notesVal) {
  return `
    <div class="installment-row" style="display:grid; grid-template-columns:100px 1fr auto; gap:6px; background:var(--bg-primary); padding:6px; border-radius:6px; border:1px solid var(--border); align-items:center;">
      <input type="date" class="form-control inst-date" style="font-size:11px; padding:4px; height:26px;" value="${dateVal}">
      <div style="display:flex; flex-direction:column; gap:4px;">
        <div style="display:flex; gap:4px;">
          <input type="text" class="form-control inst-month" style="font-size:11px; padding:4px; height:24px; width:50px; text-align:center" value="${monthVal}" placeholder="Oy">
          <input type="number" class="form-control inst-amount" style="font-size:11px; padding:4px; height:24px; font-weight:600; color:var(--brand)" value="${amountVal}" placeholder="Summa">
        </div>
        <div style="display:flex; gap:4px;">
          <input type="text" class="form-control inst-product" style="font-size:10px; padding:4px; height:22px; flex:1;" value="${productVal}" placeholder="Mahsulot nomi">
          <input type="text" class="form-control inst-notes" style="font-size:10px; padding:4px; height:22px; flex:1;" value="${notesVal}" placeholder="Izoh">
        </div>
      </div>
      <div style="display:flex; align-items:center; gap:6px; padding:0 4px;">
        <label style="display:flex; align-items:center; gap:4px; font-size:10px; cursor:pointer;">
          <input type="checkbox" class="inst-paid" ${paidVal ? 'checked' : ''} style="width:14px; height:14px;"> To'langan
        </label>
        <button type="button" class="btn btn-sm btn-ghost text-danger" onclick="this.closest('.installment-row').remove()" style="padding:2px 6px;"><i class="fas fa-trash-alt"></i></button>
      </div>
    </div>
  `;
}

// ── Deal modal ─────────────────────────────────────────────────
function openDealModal(defaultStageId, editId) {
  const modal = document.getElementById('dealModal');
  const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val !== undefined && val !== null ? val : ''; };

  setVal('f-id', editId || '');
  setVal('f-name', '');
  setVal('f-amount', '');
  setVal('f-paidAmount', '');
  setVal('f-clientId', '');
  setVal('f-deadline', '');
  setVal('f-createdAt', '');
  setVal('f-notes', '');
  setVal('f-contactName', '');
  setVal('f-contactPhone', '');
  setVal('f-city', '');
  setVal('f-warehouse', '');
  setVal('f-color', 'oddiy');
  setVal('f-driverPhone', '');
  setVal('f-source', '');
  
  const titleEl = document.getElementById('dealModalTitle');
  if (titleEl) titleEl.textContent = editId ? 'Sdelkani tahrirlash' : 'Yangi sdelka';

  const stageEl = document.getElementById('f-stageId');
  if (stageEl) {
    if (defaultStageId && !_usingMockStages) {
      stageEl.value = defaultStageId;
    } else if (!editId && _stages.length && !_usingMockStages) {
      stageEl.value = _stages[0].id;
    } else {
      stageEl.value = '';
    }
  }

  if (editId) {
    const deal = _deals?.find(d => d?.id === editId);
    if (deal) {
      setVal('f-name', deal?.productName || deal?.name || '');
      setVal('f-contactName', deal?.client?.name || '');
      setVal('f-contactPhone', deal?.client?.phone || '');
      setVal('f-city', deal?.client?.city || '');
      setVal('f-amount', deal?.amount || '');
      setVal('f-paidAmount', deal?.paidAmount || '');
      if (deal?.deadline) {
        const dDate = new Date(deal.deadline);
        if (!isNaN(dDate.getTime())) {
          const pad = (n) => String(n).padStart(2, '0');
          const fmt = `${dDate.getFullYear()}-${pad(dDate.getMonth()+1)}-${pad(dDate.getDate())}T${pad(dDate.getHours())}:${pad(dDate.getMinutes())}`;
          setVal('f-deadline', fmt);
        } else {
          setVal('f-deadline', '');
        }
      } else {
        setVal('f-deadline', '');
      }
      if (deal?.createdAt) {
        const cDate = new Date(deal.createdAt);
        if (!isNaN(cDate.getTime())) {
          const pad = (n) => String(n).padStart(2, '0');
          const fmt = `${cDate.getFullYear()}-${pad(cDate.getMonth()+1)}-${pad(cDate.getDate())}T${pad(cDate.getHours())}:${pad(cDate.getMinutes())}`;
          setVal('f-createdAt', fmt);
        } else {
          setVal('f-createdAt', '');
        }
      } else {
        setVal('f-createdAt', '');
      }
      if (stageEl) stageEl.value = deal?.stageId || '';
      setVal('f-notes', cleanLeadNotesJS(deal?.notes || ''));
      setVal('f-warehouse', deal?.warehouse || '');
      setVal('f-color', deal?.productColor || 'oddiy');
      setVal('f-driverPhone', deal?.driverPhone || '');
      setVal('f-source', deal?.source || '');
    }
  }

  // 🔒 YANGI LEAD MUZLATISH (LOCKED READ-ONLY MODAL)
  const banner = document.getElementById('yangiLeadLockBanner');
  const saveBtn = document.getElementById('dealSaveBtn');
  const inputsToLock = [
    'f-name', 'f-contactName', 'f-contactPhone', 'f-city',
    'f-amount', 'f-paidAmount', 'f-notes', 'f-warehouse',
    'f-color', 'f-driverPhone', 'f-source', 'f-deadline'
  ];

  if (editId) {
    const deal = _deals?.find(d => d?.id === editId);
    const currentStage = _stages?.find(s => s.id === deal?.stageId);
    const isYangiStage = currentStage && currentStage.name.toLowerCase().includes('yangi');

    if (isYangiStage && _userRole !== 'admin') {
      if (banner) banner.classList.remove('hidden');
      inputsToLock.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });

      const stageEl = document.getElementById('f-stageId');
      if (stageEl) {
        stageEl.disabled = false;
        stageEl.onchange = function() {
          const selectedStageId = Number(this.value);
          if (selectedStageId !== deal.stageId) {
            if (saveBtn) {
              saveBtn.disabled = false;
              saveBtn.innerHTML = '<i class="fas fa-hand-holding-usd"></i> Sdelkani O\'zlashtirish va O\'tkazish';
              saveBtn.classList.remove('btn-secondary');
              saveBtn.classList.add('btn-primary');
            }
          } else {
            if (saveBtn) {
              saveBtn.disabled = true;
              saveBtn.textContent = 'Saqlash';
            }
          }
          dealModalStageChanged();
        };
      }
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saqlash';
      }
    } else {
      if (banner) banner.classList.add('hidden');
      inputsToLock.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
      const stageEl = document.getElementById('f-stageId');
      if (stageEl) {
        stageEl.disabled = false;
        stageEl.onchange = dealModalStageChanged;
      }
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Saqlash';
      }
    }
  } else {
    if (banner) banner.classList.add('hidden');
    inputsToLock.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.disabled = false;
    });
    const stageEl = document.getElementById('f-stageId');
    if (stageEl) {
      stageEl.disabled = false;
      stageEl.onchange = dealModalStageChanged;
    }
    if (saveBtn) {
      saveBtn.disabled = false;
      saveBtn.innerHTML = 'Saqlash';
    }
  }

  if (modal) modal.classList.remove('hidden');
  setTimeout(() => { const el = document.getElementById('f-name'); if (el) el.focus(); }, 100);
}

function closeDealModal() {
  document.getElementById('dealModal').classList.add('hidden');
}

async function saveDeal() {
  const id    = document.getElementById('f-id').value;
  const name  = document.getElementById('f-name').value.trim();
  if (!name) { _toast('Sdelka nomi majburiy', 'error'); document.getElementById('f-name').focus(); return; }

  const sourceVal = document.getElementById('f-source').value;
  if (!sourceVal || sourceVal.trim() === '') {
    _toast('Iltimos, sdelka manbasini tanlang (Majburiy)', 'error');
    const sourceEl = document.getElementById('f-source');
    sourceEl.focus();
    sourceEl.style.border = '2px solid var(--danger)';
    return;
  } else {
    document.getElementById('f-source').style.border = '';
  }

  // Belt-and-suspenders: never send a negative (mock/local-only) stage id
  // to the API, even if some UI path slipped one into the form.
  let rawStageId = document.getElementById('f-stageId').value ? Number(document.getElementById('f-stageId').value) : null;
  if (rawStageId !== null && rawStageId <= 0) rawStageId = null;

  const body = {
    productName: name,
    contactName: document.getElementById('f-contactName').value.trim() || null,
    contactPhone: document.getElementById('f-contactPhone').value.trim() || null,
    city:        document.getElementById('f-city').value.trim() || null,
    amount:      Number(document.getElementById('f-amount').value) || 0,
    paidAmount:  Number(document.getElementById('f-paidAmount').value) || 0,
    deadline:    document.getElementById('f-deadline')?.value ? new Date(document.getElementById('f-deadline').value).toISOString() : null,
    createdAt:   document.getElementById('f-createdAt').value ? new Date(document.getElementById('f-createdAt').value).toISOString() : null,
    stageId:     rawStageId,
    pipelineId:  _activePid,
    notes:       document.getElementById('f-notes').value.trim() || null,
    warehouse:   document.getElementById('f-warehouse').value || null,
    productColor: document.getElementById('f-color').value || 'oddiy',
    driverPhone:  document.getElementById('f-driverPhone').value.trim() || null,
    source:       sourceVal
  };

  const btn = document.getElementById('dealSaveBtn');
  btn.disabled = true;
  try {
    let savedDealId = id;
    if (id) {
      await apiFetch('/api/deals/' + id, { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
      _toast('Yangilandi', 'success');
    } else {
      const newDeal = await apiFetch('/api/deals', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
      savedDealId = newDeal.id;
      _toast("Qo'shildi", 'success');
    }
    
    const block = document.getElementById('dealModalNasiyaBlock');
    if (block && !block.classList.contains('hidden') && savedDealId) {
      const container = document.getElementById('dealModalInstRowsContainer');
      const rows = container.querySelectorAll('.installment-row');
      if (rows.length > 0) {
        const installments = [];
        for (const row of rows) {
          const dueDate = row.querySelector('.inst-date').value;
          const amt = Number(row.querySelector('.inst-amount').value) || 0;
          const paid = row.querySelector('.inst-paid').checked;
          const pName = row.querySelector('.inst-product').value;
          const month = row.querySelector('.inst-month').value;
          const rNotes = row.querySelector('.inst-notes').value;
          if (dueDate) {
            installments.push({ dueDate, amount: amt, paid, productName: pName, month, notes: rNotes });
          }
        }
        if (installments.length > 0) {
          await apiFetch('/api/deals/' + savedDealId + '/installments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ installments })
          });
          _toast("Nasiya rejasi ham saqlandi", 'success');
        }
      }
    }
    
    closeDealModal();
    await loadDeals();
  } catch(e) { _toast(e.message, 'error'); }
  finally { btn.disabled = false; }
}

// ── Detail modal ───────────────────────────────────────────────
// ── Detail drawer (amoCRM level) ────────────────────────────────
async function openDetail(id) {
  document.body.classList.add('detail-modal-open');
  _detailId = id;
  const modal = document.getElementById('detailModal');
  modal.classList.remove('hidden');
  
  // Set default active tab
  document.querySelectorAll('.drawer-tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.drawer-tab').classList.add('active');
  document.querySelectorAll('.drawer-tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-main').classList.add('active');

  try {
    const deal = await apiFetch('/api/deals/' + id);
    window._currentDeal = deal;

    // Header values
    document.getElementById('drawerDealTitle').value = deal.productName || deal.name || '';
    document.getElementById('drawerDealId').textContent = '#' + deal.id;
    
    const pipelineObj = _pipelines.find(p => p.id === deal.pipelineId) || (_pipelines.length ? _pipelines[0] : null);
    
    // Calculate stage duration
    const now = new Date();
    const stageDate = deal.stageUpdatedAt ? new Date(deal.stageUpdatedAt) : new Date(deal.updatedAt || deal.createdAt);
    const diffTime = Math.abs(now - stageDate);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    const stageDurationText = `${diffDays} kun`;
    
    document.getElementById('drawerDealPipeline').textContent = (pipelineObj ? pipelineObj.name : 'Voronka');

    // Populate active stage info (amoCRM style)
    const currentStage = pipelineObj ? pipelineObj.stages.find(s => s.id === deal.stageId) : null;
    const stageName = currentStage ? currentStage.name : 'Noma’lum';
    const stageColor = currentStage ? currentStage.color : '#007AFF';
    
    document.getElementById('drawerActiveStage').textContent = stageName;
    document.getElementById('drawerStageDuration').textContent = `(${stageDurationText})`;
    const colorLine = document.getElementById('drawerStageColorLine');
    if (colorLine) {
      colorLine.style.backgroundColor = stageColor;
    }

    // Populate tags
    const tagsContainer = document.getElementById('drawerTagsContainer');
    tagsContainer.innerHTML = '';
    const tags = (deal.tags || '').split(/[,\s]+/).filter(t => t.trim() !== '');
    if (tags.length === 0) {
      tagsContainer.innerHTML = '<span style="font-size:11px; color:var(--text-tertiary)">Teglar yo\'q. Qo\'shish uchun bosing</span>';
    } else {
      tags.forEach(t => {
        tagsContainer.innerHTML += `
          <span class="badge" style="font-size:11px; padding:3px 8px; border-radius:6px; background:rgba(0,122,255,0.1); color:var(--accent); font-weight:600; margin-right:6px; margin-bottom:4px; display:inline-flex; align-items:center; gap:4px;">
            #${_esc(t)}
            <i class="fas fa-times" style="font-size:9px; cursor:pointer;" onclick="removeDrawerTag('${_esc(t)}')"></i>
          </span>
        `;
      });
    }
    tagsContainer.innerHTML += `
      <button class="btn btn-secondary btn-xs" onclick="addDrawerTagPrompt()" style="padding:2px 6px; font-size:10px; border-radius:4px; margin-top:2px;">+ Teg qo'shish</button>
    `;

    // Progress Bar & Stage Select Dropdown
    const progressBar = document.getElementById('drawerProgressBar');
    progressBar.innerHTML = '';
    const stageSelect = document.getElementById('drawerStageSelect');
    if (stageSelect) stageSelect.innerHTML = '';
    
    const customMenu = document.getElementById('drawerStageDropdownMenu');
    if (customMenu) customMenu.innerHTML = '';
    
    if (pipelineObj && pipelineObj.stages) {
      const sortedStages = [...pipelineObj.stages].sort((a, b) => a.order - b.order);
      let passed = true;
      
      if (stageSelect) {
        stageSelect.innerHTML = sortedStages.map(st => `
          <option value="${st.id}" ${st.id === deal.stageId ? 'selected' : ''}>
            ${_esc(st.name)}
          </option>
        `).join('');
      }
      
      if (customMenu) {
        customMenu.innerHTML = sortedStages.map(st => {
          const isActive = st.id === deal.stageId;
          const activeClass = isActive ? ' active' : '';
          const color = st.color || '#007AFF';
          return `
            <div class="stage-dropdown-item${activeClass}" onclick="changeDrawerStage(${st.id}); closeStageDropdown();" style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; transition: background 0.15s; text-align: left; background: ${isActive ? 'var(--accent-soft)' : 'transparent'}; color: ${isActive ? 'var(--accent)' : 'var(--text-primary)'};" onmouseover="if(!${isActive}) this.style.background='var(--bg-secondary)'" onmouseout="if(!${isActive}) this.style.background='transparent'">
              <span class="stage-item-dot" style="width: 8px; height: 8px; border-radius: 50%; background: ${color}; flex-shrink: 0;"></span>
              <span style="flex:1;">${_esc(st.name)}</span>
            </div>
          `;
        }).join('');
      }
      
      const activeStage = sortedStages.find(s => s.id === deal.stageId);
      if (activeStage) {
        const btnText = document.getElementById('drawerStageBtnText');
        const btnDot = document.getElementById('drawerStageBtnDot');
        if (btnText) btnText.textContent = activeStage.name;
        if (btnDot) btnDot.style.backgroundColor = activeStage.color || '#007AFF';
      }
      
      sortedStages.forEach(st => {
        const isActive = st.id === deal.stageId;
        const color = st.color || '#007AFF';
        const classes = `progress-segment${isActive ? ' active' : passed ? ' passed' : ''}`;
        
        progressBar.innerHTML += `
          <div class="${classes}" style="--_sc: ${color}; cursor:pointer;" onclick="changeDrawerStage(${st.id})" title="${_esc(st.name)}"></div>
        `;
        if (isActive) passed = false;
      });
    }

    // Populate managers dropdown
    const managerSelect = document.getElementById('dw-managerId');
    managerSelect.innerHTML = '<option value="">— Menejersiz —</option>' +
      _managers.map(u => `<option value="${u.id}" ${u.id===deal.managerId?'selected':''}>${_esc(u.fullName||u.email)}</option>`).join('');

    // Amount
    document.getElementById('dw-amount').value = deal.amount || 0;

    // Core fields
    document.getElementById('dw-productName').value = deal.productName || deal.title || '';
    document.getElementById('dw-contactCity').value = deal.client ? deal.client.city || '' : '';
    document.getElementById('dw-notes').value = deal.notes || '';

    // Contact client fields
    const contactName = deal.client ? deal.client.name || '' : '';
    document.getElementById('dw-contactName').value = contactName;
    document.getElementById('dw-contactPhone').value = deal.client ? deal.client.phone || '' : '';
    document.getElementById('dw-contactEmail').value = deal.client ? deal.client.email || '' : '';

    // Set contact avatar text
    const avatarEl = document.getElementById('dw-contactAvatar');
    if (avatarEl) {
      avatarEl.textContent = contactName ? contactName.charAt(0).toUpperCase() : '?';
    }

    // Set contact company label
    const companyName = deal.client ? deal.client.company || '' : '';
    const companyLabelEl = document.getElementById('dw-contactCompanyLabel');
    if (companyLabelEl) {
      companyLabelEl.textContent = companyName ? companyName : 'o\'zim_uchun';
    }

    // Company client fields
    document.getElementById('dw-companyName').value = companyName;
    document.getElementById('dw-companyPhone').value = deal.client ? deal.client.companyPhone || '' : '';
    document.getElementById('dw-companyEmail').value = deal.client ? deal.client.companyEmail || '' : '';
    document.getElementById('dw-companyWebsite').value = deal.client ? deal.client.companyWebsite || '' : '';
    document.getElementById('dw-companyAddress').value = deal.client ? deal.client.companyAddress || '' : '';

    // Statistics fields
    document.getElementById('st-createdAt').textContent = _date(deal.createdAt) + ' ' + new Date(deal.createdAt).toLocaleTimeString('uz-UZ', {hour:'2-digit',minute:'2-digit'});
    document.getElementById('st-updatedAt').textContent = _date(deal.updatedAt) + ' ' + new Date(deal.updatedAt).toLocaleTimeString('uz-UZ', {hour:'2-digit',minute:'2-digit'});
    document.getElementById('st-duration').textContent = stageDurationText + ' в текущем этапе';
    document.getElementById('st-source').textContent = deal.source ? deal.source.toUpperCase() : 'ODDIY';
    document.getElementById('st-warehouse').textContent = deal.warehouse || 'Kiritilmagan';
    document.getElementById('st-color').textContent = deal.productColor || 'Oddiy';

    // Populate timeline and active tasks
    renderTimelineAndTasks(deal);

    // Dynamic Nasiya Desco Section (Only visible on Nasiya Desco stage)
    window._drawerNasiyaForceEdit = false;
    renderDrawerNasiyaSection(deal);

    // Trigger pending stage change from Drag & Drop if any
    if (window._pendingStageChangeAfterOpen) {
      const pendingStageId = window._pendingStageChangeAfterOpen;
      window._pendingStageChangeAfterOpen = null;
      changeDrawerStage(pendingStageId);
    } else {
      // Hide the prompt by default
      const container = document.getElementById('stageReasonPromptContainer');
      if (container) container.classList.add('hidden');
    }

  } catch(e) {
    console.error('Drawer population error:', e);
    _toast('Drawer yuklanmadi: ' + e.message, 'error');
  }
}

function renderDrawerNasiyaSection(deal) {
  const block = document.getElementById('drawerNasiyaDescoBlock');
  if (!block) return;

  const activeStage = _stages.find(s => s.id === deal.stageId);
  const stageName = activeStage ? (activeStage.name || '').toLowerCase() : '';
  const isNasiyaStage = stageName.includes('nasiya') || stageName.includes('desco');

  if (!isNasiyaStage) {
    block.style.display = 'none';
    return;
  }

  block.style.display = 'block';

  const insts = deal.installments || [];
  const hasPlan = insts.length > 0;
  const isForceEdit = window._drawerNasiyaForceEdit === true;

  if (hasPlan && !isForceEdit) {
    const paidInsts = insts.filter(i => i.paid);
    const paidAmount = paidInsts.reduce((sum, i) => sum + (i.amount || 0), 0);
    const remainingDebt = Math.max(0, deal.amount - paidAmount);
    const progressPct = deal.amount > 0 ? Math.min(100, Math.round((paidAmount / deal.amount) * 100)) : 0;
    
    const now = new Date();
    const nextUnpaid = insts.find(i => !i.paid);
    const isOverdue = nextUnpaid && new Date(nextUnpaid.dueDate) < now;

    const firstRegInst = insts.find(i => i.notes && i.notes.includes('oylik')) || insts[1] || insts[0];
    const monthlyAmt = firstRegInst ? firstRegInst.amount : Math.round(remainingDebt / Math.max(1, insts.length));
    const monthsCount = insts.filter(i => !i.notes || !i.notes.includes('Boshlang\'ich')).length || insts.length;

    block.innerHTML = `
      <div style="font-size: 11.5px; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between;">
        <span><i class="fas fa-file-invoice-dollar" style="margin-right: 6px;"></i> Nasiya Desco — To'lov Qismi</span>
        <button type="button" class="btn btn-ghost btn-sm" onclick="window._drawerNasiyaForceEdit=true; renderDrawerNasiyaSection(window._currentDeal);" style="font-size:11px; padding:2px 8px; color:var(--text-secondary); font-weight:600;"><i class="fas fa-edit"></i> Planni Tahrirlash</button>
      </div>

      <div style="background:var(--bg-primary); border:1px solid var(--border); border-radius:8px; padding:10px 12px; margin-bottom:10px;">
        <div style="font-size:12.5px; font-weight:800; color:var(--text-primary); display:flex; justify-content:space-between; align-items:center;">
          <span>📅 ${monthsCount} oylik muddatli to'lov</span>
          <span style="color:var(--brand); font-size:13px;">${monthlyAmt.toLocaleString('uz-UZ')} so'm / oy</span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:11.5px; font-weight:700; margin-top:8px; margin-bottom:4px;">
          <span style="color:#10b981;">To'langan: ${paidAmount.toLocaleString('uz-UZ')} so'm</span>
          <span style="color:${remainingDebt > 0 ? '#ef4444' : '#10b981'};">Qolgan: ${remainingDebt.toLocaleString('uz-UZ')} so'm</span>
        </div>
        <div style="height:6px; background:var(--bg-secondary); border-radius:3px; overflow:hidden;">
          <div style="width:${progressPct}%; height:100%; background:${remainingDebt === 0 ? '#007AFF' : isOverdue ? '#ef4444' : '#10b981'}; border-radius:3px; transition:width 0.3s;"></div>
        </div>
      </div>

      ${nextUnpaid ? `
        <div style="background:${isOverdue ? 'rgba(239,68,68,0.08)' : 'rgba(0,122,255,0.08)'}; border:1px solid ${isOverdue ? 'rgba(239,68,68,0.25)' : 'rgba(0,122,255,0.2)'}; border-radius:8px; padding:10px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-size:10.5px; font-weight:800; text-transform:uppercase; color:${isOverdue ? '#ef4444' : '#007AFF'};">
              ${isOverdue ? '🔴 Kechikayotgan To\'lov' : '🔵 Navbatdagi To\'lov'}
            </div>
