}

function closeWonLostModal() {
  document.getElementById('wonLostReasonModal').classList.add('hidden');
  if (_activeWlDeal) {
    _activeWlDeal.stageId = _activeWlPreviousStageId;
    renderKanban();
  }
  _activeWlDeal = null;
  _activeWlStage = null;
  _activeWlPreviousStageId = null;
}

async function submitWonLostReason() {
  const dealId = document.getElementById('wl-dealId').value;
  const stageId = document.getElementById('wl-stageId').value;
  const reason = document.getElementById('wl-reason').value.trim();
  const isWon = _activeWlStage && (_activeWlStage.isWon || _activeWlStage.name.toLowerCase().includes('won') || _activeWlStage.name.toLowerCase().includes('yopildi') || _activeWlStage.name.toLowerCase().includes('yetib') || _activeWlStage.name.toLowerCase().includes('yetkazildi'));

  if (!isWon && !reason) {
    _toast('Bekor qilinish sababi kiritilishi shart!', 'error');
    return;
  }

  document.getElementById('wonLostReasonModal').classList.add('hidden');

  try {
    const updated = await apiFetch('/api/deals/' + dealId + '/stage', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        stageId: Number(stageId),
        status: isWon ? 'won' : 'lost',
        reason: reason || null
      })
    });

    Object.assign(_activeWlDeal, updated);
    _toast('Bosqich va holat muvaffaqiyatli yangilandi', 'success');

    if (_activeWlStage && /nasiya.?desco/i.test(_activeWlStage.name)) {
      openNasiyaDescoModal(_activeWlDeal);
    }

    _activeWlDeal = null;
    _activeWlStage = null;
    _activeWlPreviousStageId = null;
    renderKanban();
  } catch(e) {
    _toast(e.message || 'Xato', 'error');
    closeWonLostModal();
  }
}

// ── Custom Stage Dropdown (amoCRM style) ──
function toggleStageDropdown(e) {
  if (e) e.stopPropagation();
  const menu = document.getElementById('drawerStageDropdownMenu');
  if (!menu) return;
  const isHidden = menu.classList.contains('hidden') || menu.style.display === 'none';
  
  document.querySelectorAll('.stage-dropdown-menu').forEach(m => {
    m.classList.add('hidden');
    m.style.display = 'none';
  });
  
  if (isHidden) {
    menu.classList.remove('hidden');
    menu.style.display = 'flex';
  } else {
    menu.classList.add('hidden');
    menu.style.display = 'none';
  }
}

function closeStageDropdown() {
  const menu = document.getElementById('drawerStageDropdownMenu');
  if (menu) {
    menu.classList.add('hidden');
    menu.style.display = 'none';
  }
}

document.addEventListener('click', (e) => {
  const dropdown = document.getElementById('drawerStageCustomDropdown');
  if (dropdown && !dropdown.contains(e.target)) {
    closeStageDropdown();
  }
});
</script>

