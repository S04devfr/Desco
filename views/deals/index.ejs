      <td style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${stage ? `<span class="badge" style="background:${stage.color}22;color:${stage.color}">${_esc(stage.name)}</span>` : '—'}</td>
      <td style="font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${_fmt(d.amount)}</td>
