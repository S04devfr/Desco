    border-color: var(--accent);
  }

  /* Quick-add inside each column */
  .kb-col-hdr-quickadd-btn {
    margin-left: auto;
    font-size: 12px;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
