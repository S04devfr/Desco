          <strong class="dcard-name" style="font-size:13.5px; font-weight:700; color:var(--text-primary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; padding-right:0;" title="${_esc(d.productName || d.name || '')}">${_esc(d.productName || d.name || 'Belgilanmagan')}</strong>
        </div>
