async function changeDrawerStage(stageId) {
  const stage = _stages.find(s => s.id === Number(stageId));
  const stageName = stage ? stage.name.toLowerCase() : '';
  const isCallback = stageName.includes('qayta') || stageName.includes('aloqa') || stageName.includes('ko\'tarmadi') || stageName.includes('kotarmadi');

  if (isCallback) {
    // Show Callback Schedule Box
    window._pendingCallbackStageId = stageId;
    const box = document.getElementById('drawerCallbackScheduleBox');
    if (box) {
      box.style.display = 'flex';
      box.classList.remove('hidden');
      
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const pad = n => String(n).padStart(2, '0');
      document.getElementById('cb-schedule-date').value = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth()+1)}-${pad(tomorrow.getDate())}`;
      document.getElementById('cb-schedule-time').value = '10:00';
      document.getElementById('cb-schedule-notes').value = `Qayta aloqa: ${stage ? stage.name : ''}`;
      document.getElementById('cb-schedule-notes').focus();
    }
    
    // Temporarily update select text
    if (stage) {
      const btnText = document.getElementById('drawerStageBtnText');
      const btnDot = document.getElementById('drawerStageBtnDot');
      if (btnText) btnText.textContent = stage.name;
      if (btnDot) btnDot.style.backgroundColor = stage.color || '#007AFF';
    }
    return;
  }

  try {
    await apiFetch('/api/deals/' + _detailId + '/stage', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ stageId: Number(stageId), reason: null })
    });
    
    _toast("Bosqich yangilandi", "success");
    
    const updatedDeal = await apiFetch('/api/deals/' + _detailId);
