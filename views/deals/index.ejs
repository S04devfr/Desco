  [data-theme="light"] .timeline-footer {
    background: #f8fafc;
  }

  /* Group headers */
  .timeline-group-hdr {
    text-align: left;
    position: relative;
    margin: 8px 0 0px -18px;
    z-index: 2;
  }
  .timeline-group-title {
    display: inline-block;
    padding: 2px 10px;
    background: #1e293b;
    color: var(--text-secondary);
    font-size: 10.5px;
    font-weight: 700;
    border-radius: 20px;
    border: 1px solid var(--border);
  }
  [data-theme="light"] .timeline-group-title {
    background: #f1f5f9;
  }

  /* Timeline entry */
  .timeline-entry {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
