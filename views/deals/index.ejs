window.setTimelineInputTab = function(tab) {
  const btnComment = document.getElementById('tab-btn-comment');
  const btnTask = document.getElementById('tab-btn-task');
  const btnTransport = document.getElementById('tab-btn-transport');
  const panelComment = document.getElementById('timeline-panel-comment');
  const panelTask = document.getElementById('timeline-panel-task');
  const panelTransport = document.getElementById('timeline-panel-transport');

  const resetBtn = (btn) => {
    if (!btn) return;
    btn.style.background = 'transparent';
    btn.style.color = 'var(--text-secondary)';
    btn.classList.add('btn-ghost');
  };
  const activeBtn = (btn, bg) => {
    if (!btn) return;
    btn.style.background = bg || 'var(--accent)';
    btn.style.color = '#fff';
    btn.classList.remove('btn-ghost');
  };

  resetBtn(btnComment);
  resetBtn(btnTask);
  resetBtn(btnTransport);

  if (panelComment) panelComment.style.display = 'none';
  if (panelTask) panelTask.style.display = 'none';
  if (panelTransport) panelTransport.style.display = 'none';

  if (tab === 'comment') {
    activeBtn(btnComment, 'var(--accent)');
    if (panelComment) panelComment.style.display = 'flex';
  } else if (tab === 'task') {
    activeBtn(btnTask, 'var(--accent)');
    if (panelTask) panelTask.style.display = 'flex';

    // Set default date to today
    const today = new Date();
    const localDate = new Date(today.getTime() - (today.getTimezoneOffset() * 60000)).toISOString().slice(0, 10);
    const dateInput = document.getElementById('tl-task-date');
    if (dateInput) dateInput.value = localDate;
  } else if (tab === 'transport') {
    activeBtn(btnTransport, '#f59e0b');
    if (panelTransport) panelTransport.style.display = 'flex';
  }
};

