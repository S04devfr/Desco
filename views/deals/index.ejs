  }
  .selection-mode-active .kb-col-select-btns {
    display: inline-flex !important;
  }
  .dcard-checkbox {
    display: none !important;
    width: 14px;
    height: 14px;
    cursor: pointer;
    accent-color: var(--accent);
    flex-shrink: 0;
  }
  .selection-mode-active .dcard-checkbox {
    display: inline-block !important;
  }

  body.detail-modal-open .sidebar {
    display: none !important;
  }
  body.detail-modal-open .topbar {
    display: none !important;
  }
  body.detail-modal-open .main-area {
    width: 100vw !important;
    max-width: 100vw !important;
  }
  body.detail-modal-open .page-content {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ── Premium Sliding Drawer Styles (amoCRM level) ── */
  #detailModal {
    position: fixed !important;
    inset: 0 !important;
    left: 0 !important;
    top: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    z-index: 99999 !important;
    transition: opacity 0.25s ease;
    padding: 0 !important;
    margin: 0 !important;
  }
  #detailModal.hidden {
    display: none !important;
  }
  #detailModal .modal-box {
    width: 100vw !important;
    max-width: 100vw !important;
    margin: 0 !important;
    height: 100vh !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
    display: flex;
    flex-direction: row;
    overflow: hidden;
    background: var(--bg-surface);
    transform: translateX(100%);
