            <div id="productCenterName" style="font-size:11px;color:var(--text-secondary);margin-top:4px;max-width:90px;word-break:break-word;"></div>
          </div>
        </div>
        <!-- Trading rows list -->
        <div id="productList" style="flex:1; display:flex; flex-direction:column; gap:6px; overflow-y:auto; max-height:180px; min-width: 200px;"></div>
      </div>
    </div>
  </div>
</div>



<!-- Fine Modal -->
<div id="fineModal" class="modal-overlay" style="display:none; overflow-y:auto; align-items:flex-start; padding: 40px 20px;" onclick="if(event.target===this)closeFineModal()">
