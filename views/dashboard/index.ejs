  const zakazList = document.getElementById('zakazBreakdownList');
  const zakazChevron = document.getElementById('zakazChevron');
  if (zakazList) {
    zakazList.style.display = 'none';
    if (zakazChevron) {
      zakazChevron.classList.remove('fa-chevron-up');
      zakazChevron.classList.add('fa-chevron-down');
    }
  }
});

function fmtDuration(sec) {
  if (!sec) return '0s';
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  const s = sec % 60;
  if (h > 0) return `${h}s ${m}m`;
  return m > 0 ? `${m}m ${s}s` : `${s}s`;
}

async function loadOperatorPresenceStats() {
  const tbody = document.getElementById('operatorPresenceTableBody');
  if (!tbody) return;
  try {
    const res = await dashFetch('/api/dashboard/operator-presence').catch(() => ({ summary: {}, operators: [] }));
    const summary = res.summary || {};
    const operators = res.operators || [];

    const bAct = document.getElementById('presenceBadgeActive');
    const bIdl = document.getElementById('presenceBadgeIdle');
    const bOff = document.getElementById('presenceBadgeOffline');

    if (bAct) bAct.textContent = `🟢 ${summary.totalActive || 0} Aktiv`;
    if (bIdl) bIdl.textContent = `🟡 ${summary.totalIdle || 0} Tanaffusda (10m+)`;
    if (bOff) bOff.textContent = `⚪ ${summary.totalOffline || 0} Offline`;

    if (!operators.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="tc" style="padding:20px; color:var(--text-tertiary);">Ma\'lumotlar mavjud emas</td></tr>';
      return;
    }

    tbody.innerHTML = operators.map(op => {
      const isOnline = op.status === 'online';
      const isBusy = op.status === 'busy';
      const isIdle = op.status === 'idle';
      const badgeCls = isBusy ? '#FF9500' : isIdle ? '#D97706' : isOnline ? '#10b981' : 'var(--text-tertiary)';

      return `
        <tr>
          <td style="font-weight:700;">
            <div style="display:flex; align-items:center; gap:8px;">
              <div style="width:28px; height:28px; border-radius:50%; background:var(--brand-soft); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700;">
                ${escHtml(op.name.charAt(0).toUpperCase())}
              </div>
              <div>
                <div>${escHtml(op.name)}</div>
                <div style="font-size:10px; color:var(--text-tertiary); font-weight:600;">${escHtml(op.role)}</div>
              </div>
            </div>
          </td>
          <td class="tc" style="font-size:12px; font-weight:700; color:${badgeCls};">
            ${escHtml(op.statusText)}
          </td>
          <td class="tc" style="font-size:12.5px; font-weight:700; color:var(--text-primary);">
            <i class="far fa-clock" style="color:var(--primary); font-size:11px; margin-right:4px;"></i>${escHtml(op.firstLoginTime || '—')}
          </td>
          <td class="tc" style="font-size:13px; font-weight:800; color:#10b981;">
            ${fmtDuration(op.onlineSec)}
          </td>
          <td class="tc" style="font-size:12px; font-weight:700; color:#FF9500;">
            ${fmtDuration(op.idleSec)}
          </td>
          <td>
            <div style="display:flex; align-items:center; gap:8px;">
              <div style="flex:1; height:6px; background:var(--bg-secondary); border-radius:3px; overflow:hidden;">
                <div style="width:${op.activeWorkRatio}%; height:100%; background:${op.activeWorkRatio >= 80 ? '#10b981' : op.activeWorkRatio >= 50 ? '#FF9500' : '#ef4444'}; border-radius:3px;"></div>
              </div>
              <span style="font-size:11.5px; font-weight:800; color:var(--text-primary);">${op.activeWorkRatio}%</span>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  } catch (e) {
    console.error('Operator presence load error:', e);
  }
}

