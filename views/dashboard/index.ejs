<!-- EDIT MANAGER MODAL -->
<div class="modal-overlay hidden" id="editManagerModal" style="z-index: 1200;">
  <div class="modal-box" style="max-width: 400px;">
    <div class="modal-header">
      <h2>Xodimni tahrirlash</h2>
      <button class="modal-close" onclick="closeEditManagerModal()">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="em-id">
      <div class="form-group" style="margin-bottom: 14px;">
        <label class="form-label" style="font-size:12.5px; font-weight:600; display:block; margin-bottom:6px; color:var(--text-secondary)">Ism-familiya *</label>
        <input type="text" id="em-fullName" class="form-control" placeholder="To'liq ism" style="border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-card); color: var(--text-primary); width:100%; height:38px; padding:0 12px; font-size:13.5px;">
      </div>
      <div class="form-group" style="margin-bottom: 14px;">
        <label class="form-label" style="font-size:12.5px; font-weight:600; display:block; margin-bottom:6px; color:var(--text-secondary)">Email *</label>
        <input type="email" id="em-email" class="form-control" placeholder="email@example.com" style="border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-card); color: var(--text-primary); width:100%; height:38px; padding:0 12px; font-size:13.5px;">
      </div>
