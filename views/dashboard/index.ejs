    if (igAvgWritersEl) igAvgWritersEl.textContent = "O'rtacha: " + (igStats.averageWritersPerDay || 0) + ' kishi';

    // Suhbatlar oqimi va Murojaatlar dual mini-chart
    const chatsVolContainer = document.getElementById('igChatsVolumeContainer');
    if (chatsVolContainer) {
      const dailyWriters = igStats.dailyIncomingWriters || [];
      
      if (dailyWriters.length === 0) {
        chatsVolContainer.innerHTML = '<div style="color: var(--text-tertiary); font-size: 11.5px; text-align: center; width: 100%; padding-bottom: 20px;">Ma\'lumot yo\'q</div>';
      } else {
        const allDates = dailyWriters.map(d => d.date).sort().slice(-7); // Last 7 days
        const maxWriters = Math.max(...dailyWriters.map(d => d.count), 1);
        
        chatsVolContainer.innerHTML = allDates.map(dateStr => {
          const writerItem = dailyWriters.find(d => d.date === dateStr);
          const writerCount = writerItem ? writerItem.count : 0;
          const pctWriter = Math.round((writerCount / maxWriters) * 100);
          
          const dateObj = new Date(dateStr);
          const label = dateObj.getDate().toString().padStart(2, '0') + '/' + (dateObj.getMonth()+1).toString().padStart(2, '0');
          
          return `
            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0;">
              <!-- Values on top -->
              <div style="display: flex; gap: 6px; font-size: 9px; font-weight: 700; color: var(--text-primary);">
                <span style="color: var(--brand);">${writerCount} kishi</span>
              </div>
              
              <!-- Single bar container -->
              <div style="width: 100%; height: 50px; display: flex; align-items: flex-end; justify-content: center; background: var(--surface-elevated); border-radius: 4px; padding: 2px;">
                <div style="width: 24px; height: ${Math.max(pctWriter, 8)}%; background: linear-gradient(180deg, var(--brand) 0%, #4F46E5 100%); border-radius: 3px;" title="${dateStr}: ${writerCount} kishi yozdi"></div>
              </div>
              
              <div style="font-size: 8.5px; color: var(--text-tertiary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">${label}</div>
            </div>
          `;
        }).join('');
      }
    }

    const prefs = igStats.paymentPreferences || { nasiya: 0, naqd: 0, unspecified: 0 };
    const totalPrefs = (prefs.nasiya + prefs.naqd + prefs.unspecified) || 1;
    const pctNasiya = Math.round((prefs.nasiya / totalPrefs) * 100);
    const pctNaqd = Math.round((prefs.naqd / totalPrefs) * 100);

    const igNasiyaTextEl = document.getElementById('igNasiyaText');
    const igNasiyaBarEl = document.getElementById('igNasiyaBar');
    if (igNasiyaTextEl) igNasiyaTextEl.textContent = `${prefs.nasiya} kishi (${pctNasiya}%)`;
    if (igNasiyaBarEl) igNasiyaBarEl.style.width = pctNasiya + '%';

    const igNaqdTextEl = document.getElementById('igNaqdText');
    const igNaqdBarEl = document.getElementById('igNaqdBar');
    if (igNaqdTextEl) igNaqdTextEl.textContent = `${prefs.naqd} kishi (${pctNaqd}%)`;
    if (igNaqdBarEl) igNaqdBarEl.style.width = pctNaqd + '%';

    const intents = igStats.purchaseIntent || { purchase: 0, inquiry: 0, other: 0 };
    const totalIntents = (intents.purchase + intents.inquiry + intents.other) || 1;
    const pctPurchase = Math.round((intents.purchase / totalIntents) * 100);
    const pctInquiry = Math.round((intents.inquiry / totalIntents) * 100);

    const igPurchaseTextEl = document.getElementById('igPurchaseText');
    const igPurchaseBarEl = document.getElementById('igPurchaseBar');
    if (igPurchaseTextEl) igPurchaseTextEl.textContent = `${intents.purchase} kishi (${pctPurchase}%)`;
    if (igPurchaseBarEl) igPurchaseBarEl.style.width = pctPurchase + '%';

    const igInquiryTextEl = document.getElementById('igInquiryText');
    const igInquiryBarEl = document.getElementById('igInquiryBar');
    if (igInquiryTextEl) igInquiryTextEl.textContent = `${intents.inquiry} kishi (${pctInquiry}%)`;
    if (igInquiryBarEl) igInquiryBarEl.style.width = pctInquiry + '%';

    // Rad sabablari (Lost Reasons)
    const lostRes = igStats.lostReasons || { price: 0, delivery: 0, thinking: 0, lateResponse: 0, other: 0 };
    const lostPriceEl = document.getElementById('lostReasonPrice');
    const lostDeliveryEl = document.getElementById('lostReasonDelivery');
    const lostThinkingEl = document.getElementById('lostReasonThinking');
    const lostLateEl = document.getElementById('lostReasonLateResponse');

    if (lostPriceEl) lostPriceEl.textContent = (lostRes.price || 0) + ' ta';
    if (lostDeliveryEl) lostDeliveryEl.textContent = (lostRes.delivery || 0) + ' ta';
    if (lostThinkingEl) lostThinkingEl.textContent = (lostRes.thinking || 0) + ' ta';
    if (lostLateEl) lostLateEl.textContent = (lostRes.lateResponse || 0) + ' ta';

    const opinionsContainer = document.getElementById('igOpinionsContainer');
    if (opinionsContainer) {
      const opinions = igStats.sampleOpinions || [];
      if (opinions.length === 0) {
        opinionsContainer.innerHTML = '<div style="color: var(--text-tertiary); font-size: 10px; font-style: italic; text-align: center; padding-top: 4px;">Yozishmalar fikri yo\'q</div>';
      } else {
        opinionsContainer.innerHTML = opinions.map(op => `
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 4px; padding: 4px 6px; font-size: 10px; color: var(--text-secondary); line-height: 1.3; border-left: 2px solid #cc2366; font-style: italic; text-align: left; margin-bottom: 2px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
            "${escHtml(op)}"
          </div>
        `).join('');
      }
    }

    // ── Render Funnel (Ultra-Sleek Real-Time Peregavor Design) ──
    const funnel = safeKpis.funnelStages || { yangi: 0, qaytaAloqa: 0, kotarilmadi: 0, peregavor: 0, muzokara: 0, won: 0, lost: 0, total: 0 };
    const total = Math.max(funnel.total || 1, 1);
    const peregavorCount = (funnel.peregavor !== undefined ? funnel.peregavor : funnel.muzokara) || 0;

    const pctYangi       = Math.round(((funnel.yangi || 0) / total) * 100);
    const pctPeregavor   = Math.round((peregavorCount / total) * 100);
    const pctKotarilmadi = Math.round(((funnel.kotarilmadi || 0) / total) * 100);
    const pctQaytaAloqa  = Math.round(((funnel.qaytaAloqa || 0) / total) * 100);
    const pctWon         = Math.round(((funnel.won || 0) / total) * 100);
    const pctLost        = Math.round(((funnel.lost || 0) / total) * 100);

    const funnelSteps = [
      { label: 'Yangi Lidlar',   icon: 'fa-user-plus',       count: funnel.yangi || 0,       pct: pctYangi,       color: '#6366F1', bg: 'rgba(99, 102, 241, 0.08)' },
      { label: 'Peregavor',      icon: 'fa-comments',        count: peregavorCount,          pct: pctPeregavor,   color: '#F59E0B', bg: 'rgba(245, 158, 11, 0.08)' },
      { label: 'Ko\'tarilmadi',  icon: 'fa-phone-slash',     count: funnel.kotarilmadi || 0, pct: pctKotarilmadi, color: '#EF4444', bg: 'rgba(239, 68, 68, 0.08)' },
      { label: 'Qayta Aloqa',    icon: 'fa-phone-alt',       count: funnel.qaytaAloqa || 0,  pct: pctQaytaAloqa,  color: '#0EA5E9', bg: 'rgba(14, 165, 233, 0.08)' },
      { label: 'Yutilgan',       icon: 'fa-check-circle',    count: funnel.won || 0,         pct: pctWon,         color: '#10B981', bg: 'rgba(16, 185, 129, 0.08)' },
      { label: 'Otmen Zakazlar', icon: 'fa-times-circle',    count: funnel.lost || 0,        pct: pctLost,        color: '#8E8E93', bg: 'rgba(142, 142, 147, 0.08)' }
    ];

    const funnelContainer = document.getElementById('funnelContainer');
    if (funnelContainer) {
      funnelContainer.innerHTML = `
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; padding: 4px 0;">
          ${funnelSteps.map((s) => `
            <div style="background: var(--surface-card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px; box-shadow: var(--shadow-xs); transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);" onmouseover="this.style.borderColor='${s.color}'; this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border)'; this.style.transform='none'">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 28px; height: 28px; border-radius: 8px; background: ${s.bg}; color: ${s.color}; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0;">
                    <i class="fas ${s.icon}"></i>
                  </div>
                  <span style="font-size: 12.5px; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${s.label}</span>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 2px;">
                <div style="font-size: 18px; font-weight: 800; color: var(--text-primary);">${s.count} <span style="font-size: 11px; font-weight: 600; color: var(--text-tertiary);">ta</span></div>
                <div style="width: 70px; height: 5px; background: var(--surface-input); border-radius: 99px; overflow: hidden;">
                  <div style="width: ${Math.max(s.pct, 4)}%; height: 100%; background: ${s.color}; border-radius: 99px;"></div>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    // ── Render Tasks section ──
    try {
      const myTasks = await dashFetch('/api/tasks?completed=false&mine=true');
      const tasksContainer = document.getElementById('myTasksContainer');
      const tasksCountEl = document.getElementById('myTasksCount');
      
      if (tasksContainer) {
        if (!myTasks || !myTasks.length) {
          tasksContainer.innerHTML = `
            <div class="empty-state" style="padding:40px; text-align:center; display:flex; flex-direction:column; justify-content:center; align-items:center; height:100%; gap:8px; flex:1;">
              <i class="fas fa-check-circle" style="font-size:32px; color:var(--success); opacity:0.8;"></i>
              <div style="font-size:13px; color:var(--text-primary); font-weight:600;">Hamma vazifalar bajarildi!</div>
              <div style="font-size:11px; color:var(--text-secondary);">Sizda faol vazifalar yo'q.</div>
            </div>
          `;
          if (tasksCountEl) tasksCountEl.textContent = '0 ta faol';
        } else {
          if (tasksCountEl) tasksCountEl.textContent = myTasks.length + ' ta faol';
          
          tasksContainer.innerHTML = myTasks.map(t => {
            const pColors = { high: '#FF3B30', medium: '#FF9500', low: '#34C759' };
            const pLabels = { high: 'Yuqori', medium: 'O\'rta', low: 'Past' };
            const pColor = pColors[t.priority] || '#8E8E93';
            const pLabel = pLabels[t.priority] || 'Noma’lum';
            
            const clientName = t.client?.name || 'Noma’lum mijoz';
            const clientPhone = t.client?.phone || '';
            
            const due = new Date(t.dueDate);
            const today = new Date();
            today.setHours(0,0,0,0);
            const isOverdue = due < today;
            const dueStr = due.toLocaleDateString('uz-UZ') + (t.dueTime ? ' ' + t.dueTime : '');
            const dueStyle = isOverdue ? 'color:#FF3B30; font-weight:600;' : 'color:var(--text-secondary);';
            
            const dealProduct = t.deal?.productName || 'Sdelka';
            const dealStage = t.deal?.stage?.name || 'Bosqichsiz';
            
            return `
              <div class="stat-card" style="padding: 10px 12px; margin: 0; border-radius: 8px; flex-shrink: 0; display: flex; flex-direction: column; gap: 6px; box-shadow: var(--shadow-xs); background: var(--surface-card); border: 1px solid var(--border); text-align: left;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                  <div style="font-weight: 700; font-size: 12.5px; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; flex: 1;">
                    ${escHtml(t.title)}
                  </div>
                  <span style="font-size: 9px; font-weight: 700; color: #fff; background: ${pColor}; padding: 1px 5px; border-radius: 4px; flex-shrink: 0;">
                    ${pLabel}
                  </span>
                </div>
                
                <div style="font-size: 11px; color: var(--text-secondary); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  ${escHtml(t.description || 'Izohsiz')}
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10.5px; border-top: 1px dashed var(--border); padding-top: 5px; margin-top: 2px;">
                  <div>
                    <i class="fas fa-user" style="color: var(--text-secondary); margin-right: 3px;"></i>
                    <strong style="color: var(--text-primary);">${escHtml(clientName)}</strong> ${clientPhone ? `<span style="color: var(--text-secondary); font-size: 10px;">(${escHtml(clientPhone)})</span>` : ''}
                  </div>
                  <div style="${dueStyle}">
                    <i class="far fa-clock" style="margin-right: 3px;"></i>${dueStr}
                  </div>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-secondary);">
                  <div>
                    <i class="fas fa-shopping-bag" style="margin-right: 3px;"></i>${escHtml(dealProduct)}
                    <span class="badge badge-brand" style="font-size: 8.5px; padding: 1px 4px; margin-left: 4px; vertical-align: middle;">${escHtml(dealStage)}</span>
                  </div>
                  <a href="/deals" style="color: var(--brand); font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 3px; font-size: 10.5px;">
                    Sdelkaga o'tish <i class="fas fa-arrow-right" style="font-size: 9px;"></i>
                  </a>
                </div>
              </div>
            `;
          }).join('');
        }
      }
    } catch (e) {
      console.error('[Dashboard Tasks Fetch error]', e);
    }


    // ── Render Manager KPI + Salary table ──
    const kpiBody = document.getElementById('managerKpiTableBody');
    if (kpiBody) {
      const managers = safeKpis.managersList || [];
      if (managers.length === 0) {
        kpiBody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:30px;color:var(--text-500)">Hozircha menejer ma\'lumotlari yo\'q</td></tr>';
      } else {
        // Activity stats map: userId -> {online, todayMin, todayHours}
        const actMgrs = (activityStats && activityStats.managers) ? activityStats.managers : [];
        const actMap  = {};
        actMgrs.forEach(function(a){ actMap[a.userId] = a; });

        // Har bir menejer uchun hisob-kitob
        const rows = managers.map(m => {
          const baseSalary  = m.baseSalary || 0;
          const kpiBonus    = m.kpiBonus || (m.wonCount * 100000);
          const totalFines  = m.totalFines || 0;
          const totalPay    = baseSalary + kpiBonus - totalFines;
          const winRate     = (m.winRate || 0).toFixed(0);
          const initials    = (m.name||'?').split(' ').slice(0,2).map(w=>w[0]||'').join('').toUpperCase();
          const winBadge    = winRate >= 60 ? 'badge-success' : winRate >= 35 ? 'badge-warning' : 'badge-danger';
          const perf        = winRate >= 60 ? 'high' : winRate >= 35 ? 'mid' : 'low';
          const finesDetail = (m.fines && m.fines.length)
            ? m.fines.map(f => '<div class="kpi-fine-item">−'+fmtMoney(f.amount)+(f.reason ? ' · '+escHtml(f.reason) : '')+'</div>').join('')
            : '';
          const tCount = m.todayCount || 0;
          const tWon   = m.todayWonCount || 0;
          const todayCell = tCount > 0
            ? '<div class="kpi-won" style="color:#10b981; font-weight:800;">'+tCount+' ta</div><div class="kpi-total-deals" style="color:var(--text-secondary);">'+(tWon > 0 ? tWon + ' sotuv' : 'buyurtma')+'</div>'
            : '<span style="font-size:11px; font-weight:600; color:var(--text-muted);">—</span>';
          const editBtn = USER_ROLE === 'admin'
            ? `<button class="btn btn-ghost btn-icon btn-sm text-brand" onclick="openEditManagerModal(${m.id}, '${escHtml(m.name)}', '${escHtml(m.email || '')}', '${m.role || 'manager'}', ${m.isActive !== false})" style="padding: 2px; margin-left: auto; display: inline-flex; border: none; background: transparent; cursor: pointer;" title="Tahrirlash"><i class="fas fa-edit" style="font-size: 11px;"></i></button>`
            : '';
          return '<tr class="kpi-row" data-perf="'+perf+'">'
            + '<td class="kpi-mgr-cell" style="display: flex; align-items: center; gap: 8px;">'
            +   '<div class="kpi-avatar" style="flex-shrink:0;">'+initials+'</div>'
            +   '<span class="kpi-mgr-name" style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">'+escHtml(m.name)+'</span>'
            +   editBtn
            + '</td>'
            + '<td class="tc">' + todayCell + '</td>'
            + '<td class="tc">'
            +   '<div class="kpi-won">'+m.wonCount+'</div>'
            +   '<div class="kpi-total-deals">/ '+m.totalCount+' jami</div>'
            + '</td>'
            + '<td class="tc"><span class="badge '+winBadge+' kpi-win-badge">'+winRate+'%</span></td>'
            + '<td class="tr"><input type="number" class="calc-input" value="'+baseSalary+'" step="100000" onchange="saveBaseSalary('+m.id+', this.value)"></td>'
            + '<td class="tr kpi-bonus-cell">'
            +   '<div class="kpi-bonus-val">'+fmtMoney(kpiBonus)+'</div>'
            +   '<div class="kpi-bonus-sub">'+m.wonCount+' × 100 000</div>'
            + '</td>'
            + '<td class="tc kpi-fine-cell">'
            +   (totalFines > 0
                  ? '<div class="kpi-fine-total">−'+fmtMoney(totalFines)+'</div>'+finesDetail
                  : '<span class="kpi-no-fine">—</span>')
            +   '<button class="kpi-add-fine" onclick="openFineModal('+m.id+',\''+escHtml(m.name)+'\')"><i class="fas fa-plus"></i> Jarima</button>'
            + '</td>'
            + '<td class="tr"><span class="kpi-payout" id="payout-'+m.id+'">'+fmtMoney(totalPay)+'</span></td>'
            + '</tr>';
        });

        // Jami byudjet qatori
        const grandTotal = managers.reduce(function(s, m) {
          const base = m.baseSalary || 0;
          const kpi  = m.kpiBonus || (m.wonCount * 100000);
          const fine = m.totalFines || 0;
          return s + base + kpi - fine;
        }, 0);
        const totalRow = '<tr class="kpi-total-row">'
          + '<td colspan="4" class="kpi-total-label"><i class="fas fa-wallet" style="margin-right:5px;color:var(--brand);"></i>Jami maosh byudjeti</td>'
          + '<td colspan="3"></td>'
          + '<td class="tr"><span class="kpi-payout">'+fmtMoney(grandTotal)+'</span></td>'
          + '</tr>';

        kpiBody.innerHTML = rows.join('') + totalRow;
      }
    }

    // Save base salary to DB
    window.saveBaseSalary = async function(managerId, val, inputEl) {
      try {
        const r = await fetch('/api/marketing/salary/' + managerId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ baseSalary: Number(val) || 0 })
        });
        if (!r.ok) throw new Error();
        if (typeof showToast === 'function') showToast('Maosh saqlandi', 'success');
      } catch(e) {
        if (typeof showToast === 'function') showToast('Saqlashda xato', 'error');
      }
    };

    window.openEditManagerModal = function(id, fullName, email, role, isActive) {
      document.getElementById('em-id').value = id;
      document.getElementById('em-fullName').value = fullName || '';
      document.getElementById('em-email').value = email || '';
      document.getElementById('em-password').value = '';
      document.getElementById('em-role').value = role || 'manager';
      document.getElementById('em-isActive').value = isActive ? 'true' : 'false';
      document.getElementById('editManagerModal').classList.remove('hidden');
    };

    window.closeEditManagerModal = function() {
      document.getElementById('editManagerModal').classList.add('hidden');
    };

    window.saveManagerDetails = async function() {
      const id = document.getElementById('em-id').value;
      const fullName = document.getElementById('em-fullName').value.trim();
      const email = document.getElementById('em-email').value.trim();
      const password = document.getElementById('em-password').value;
      const role = document.getElementById('em-role').value;
      const isActive = document.getElementById('em-isActive').value === 'true';

      if (!email) { showToast('Email majburiy', 'error'); return; }
      if (password && password.length < 8) { showToast('Parol kamida 8 ta belgi bo\'lishi kerak', 'error'); return; }

      const body = { fullName, email, role, isActive };
      if (password) body.password = password;

      const btn = document.getElementById('editManagerSaveBtn');
      btn.disabled = true;
      try {
        const r = await fetch('/api/settings/users/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const result = await r.json();
        if (!r.ok) throw new Error(result.message || 'Saqlashda xatolik');
        showToast('Xodim ma\'lumotlari yangilandi', 'success');
        closeEditManagerModal();
        loadDashboard();
      } catch(e) {
        showToast(e.message || 'Xatolik yuz berdi', 'error');
      } finally {
        btn.disabled = false;
      }
    };

    window.openFineModal = function(id, name) {
      document.getElementById('fineManagerId').value = id;
      document.getElementById('fineManagerName').value = name;
      document.getElementById('fineAmount').value = '';
      document.getElementById('fineReason').value = '';
      document.getElementById('fineModal').style.display = 'flex';
    };
    window.closeFineModal = function() {
      document.getElementById('fineModal').style.display = 'none';
    };
    window.submitFine = async function() {
      const managerId = document.getElementById('fineManagerId').value;
      const amount    = Number(document.getElementById('fineAmount').value) || 0;
      const reason    = document.getElementById('fineReason').value.trim();
      if (!amount) { alert("Jarima summasi kiriting"); return; }
      try {
        const r = await fetch('/api/marketing/fine', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ managerId, amount, reason })
        });
        if (!r.ok) throw new Error();
        closeFineModal();
        if (typeof showToast === 'function') showToast('Jarima qo\'shildi', 'success');
        loadDashboard();
      } catch(e) {
        if (typeof showToast === 'function') showToast('Xatolik', 'error');
      }
    };

    if (USER_ROLE === 'admin') {
      // ── Render Nasiya breakdown Tariffs ──
      const des = safeKpis.nasiyaDesco || { count: 0, amount: 0 };
      const ish = safeKpis.nasiyaIshonch || { count: 0, amount: 0 };
      const bar = safeKpis.nasiyaBaraka || { count: 0, amount: 0 };
      const shp = safeKpis.shopir || { count: 0, amount: 0, deals: [] };
      shopirDealsList = shp.deals || [];

      const nasiyaContainer = document.getElementById('nasiyaBreakdownContainer');
      if (nasiyaContainer) {
        nasiyaContainer.innerHTML = `
