        </div>
      </div>

      <div id="productEmpty" style="display:none;height:240px;align-items:center;justify-content:center;color:var(--text-tertiary);font-size:13px;flex-direction:column;gap:6px;">
        <i class="fas fa-box-open" style="font-size:28px;opacity:.3;"></i>
        <span>Ma'lumot yo'q</span>
      </div>
      
      <div id="productTrading" style="display:flex; align-items:center; gap:20px; flex-wrap:wrap; justify-content: center; margin-top: 10px;">
