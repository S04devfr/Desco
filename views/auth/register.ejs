<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ro'yxatdan o'tish — DESCO CRM</title>
  <!-- Favicon & Brand Icons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>(function(){const t=localStorage.getItem('crm-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <style>
    .logo-light-mode { display: block !important; }
    .logo-dark-mode { display: none !important; }
    [data-theme="dark"] .logo-light-mode { display: none !important; }
    [data-theme="dark"] .logo-dark-mode { display: block !important; }
    :root {
      --brand-primary: #6366F1;
      --brand-secondary: #8B5CF6;
      --brand-accent: #EC4899;
      --brand-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #D946EF 100%);
      
      --bg-gradient-light: radial-gradient(circle at 20% 20%, #F1F5F9 0%, #E2E8F0 50%, #CBD5E1 100%);
      --bg-gradient-dark: radial-gradient(circle at 20% 20%, #0F172A 0%, #090D16 50%, #030712 100%);

      --text-900: #0F172A;
      --text-700: #334155;
      --text-500: #64748B;
      --text-400: #94A3B8;

      --card-bg: rgba(255, 255, 255, 0.65);
      --card-border: rgba(255, 255, 255, 0.8);
      --input-bg: rgba(255, 255, 255, 0.5);
      --input-border: rgba(203, 213, 225, 0.6);
      
      --shadow-premium: 0 25px 50px -12px rgba(99, 102, 241, 0.15), 0 0 40px rgba(139, 92, 246, 0.1);
      
      --danger: #EF4444;
      --danger-bg: rgba(239, 68, 68, 0.08);
      --danger-border: rgba(239, 68, 68, 0.2);
    }

    [data-theme="dark"] {
      --text-900: #F8FAFC;
      --text-700: #E2E8F0;
      --text-500: #94A3B8;
      --text-400: #64748B;

      --card-bg: rgba(15, 23, 42, 0.65);
      --card-border: rgba(255, 255, 255, 0.12);
      --input-bg: rgba(30, 41, 59, 0.5);
      --input-border: rgba(255, 255, 255, 0.1);

      --shadow-premium: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 40px rgba(99, 102, 241, 0.2);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: var(--bg-gradient-light);
      color: var(--text-900);
      position: relative;
      transition: background 0.5s ease, color 0.3s ease;
    }
    [data-theme="dark"] body {
      background: var(--bg-gradient-dark);
    }

    #interactive-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
    }

    .mouse-spotlight {
      position: fixed;
      top: 0;
      left: 0;
      width: 600px;
      height: 600px;
      margin-top: -300px;
      margin-left: -300px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.05) 45%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
      transition: transform 0.08s ease-out;
      will-change: transform;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.55;
      pointer-events: none;
      z-index: 0;
      animation: floatOrb 20s ease-in-out infinite alternate;
    }
    .orb-1 {
      top: -10%; left: -5%;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.4), transparent 70%);
    }
    .orb-2 {
      bottom: -15%; right: -5%;
      width: 550px; height: 550px;
      background: radial-gradient(circle, rgba(236, 72, 153, 0.3), transparent 70%);
      animation-delay: -7s;
    }
    .orb-3 {
      top: 30%; right: 20%;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.25), transparent 70%);
      animation-delay: -14s;
    }
    @keyframes floatOrb {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(40px, -60px) scale(1.1); }
      100% { transform: translate(-30px, 40px) scale(0.95); }
    }

    .auth-wrapper {
      position: relative;
      z-index: 2;
      perspective: 1200px;
      width: 100%;
      max-width: 1020px;
    }

    .auth-container {
      display: flex;
      width: 100%;
      min-height: 620px;
      border-radius: 32px;
      background: var(--card-bg);
      backdrop-filter: blur(30px) saturate(190%);
      -webkit-backdrop-filter: blur(30px) saturate(190%);
      border: 1px solid var(--card-border);
      box-shadow: var(--shadow-premium);
      overflow: hidden;
      transform-style: preserve-3d;
      transition: transform 0.15s ease-out, box-shadow 0.3s ease;
      animation: cardAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes cardAppear {
      from { opacity: 0; transform: translateY(40px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .top-action-bar {
      position: absolute;
      top: 24px;
      right: 24px;
      z-index: 10;
      display: flex;
      gap: 10px;
    }
    .theme-toggle-btn {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      color: var(--text-700);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 16px;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      backdrop-filter: blur(10px);
    }
    .theme-toggle-btn:hover {
      transform: scale(1.08) rotate(12deg);
      background: rgba(99, 102, 241, 0.15);
      color: var(--brand-primary);
      border-color: rgba(99, 102, 241, 0.3);
    }

    .auth-left {
      width: 46%;
      padding: 52px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid var(--card-border);
      background: linear-gradient(145deg, rgba(99, 102, 241, 0.04) 0%, rgba(139, 92, 246, 0.08) 100%);
      position: relative;
    }

    .brand-header {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .brand-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      background: var(--brand-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFF;
      font-size: 22px;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
      position: relative;
      overflow: hidden;
    }
    .brand-icon-box::after {
      content: '';
      position: absolute;
      top: -50%; left: -50%; width: 200%; height: 200%;
      background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
      transform: rotate(45deg);
      animation: shine 4s infinite;
    }
    @keyframes shine {
      0% { transform: translateX(-100%) rotate(45deg); }
      20%, 100% { transform: translateX(100%) rotate(45deg); }
    }

    .brand-title {
      font-family: 'Outfit', sans-serif;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--text-900);
    }
    .brand-title span {
      background: var(--brand-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 30px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      color: #10B981;
      font-size: 12.5px;
      font-weight: 600;
      margin-top: 24px;
      width: fit-content;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
      animation: pulseDot 2s infinite;
    }
    @keyframes pulseDot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.3); opacity: 0.6; }
    }

    .hero-content {
      margin: 32px 0;
    }
    .hero-title {
      font-family: 'Outfit', sans-serif;
      font-size: 32px;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -1px;
      color: var(--text-900);
      margin-bottom: 14px;
    }
    .hero-title .gradient-text {
      background: var(--brand-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subtitle {
      font-size: 14.5px;
      line-height: 1.6;
      color: var(--text-500);
      margin-bottom: 28px;
    }

    .features-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .feature-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 16px;
      border-radius: 16px;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: default;
    }
    .feature-item:hover {
      transform: translateX(6px);
      background: rgba(99, 102, 241, 0.08);
      border-color: rgba(99, 102, 241, 0.25);
    }
    .feature-icon-wrapper {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(99, 102, 241, 0.12);
      color: var(--brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
      transition: transform 0.25s;
    }
    .feature-item:hover .feature-icon-wrapper {
      transform: scale(1.1) rotate(6deg);
      background: var(--brand-gradient);
      color: #FFF;
    }
    .feature-text {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-700);
    }

    .left-footer-text {
      font-size: 12px;
      color: var(--text-400);
    }

    .auth-right {
      flex: 1;
      padding: 48px 60px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }

    .form-header {
      margin-bottom: 28px;
    }
    .form-title {
      font-family: 'Outfit', sans-serif;
      font-size: 28px;
      font-weight: 800;
      color: var(--text-900);
      letter-spacing: -0.6px;
      margin-bottom: 6px;
    }
    .form-subtitle {
      font-size: 14px;
      color: var(--text-500);
    }

    .alert-banner {
      display: none;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-radius: 16px;
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: var(--danger);
      font-size: 13.5px;
      font-weight: 600;
      margin-bottom: 24px;
      animation: alertSlide 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .alert-banner.show { display: flex; }
    @keyframes alertSlide {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
      margin-bottom: 18px;
    }
    .form-label {
      display: block;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-700);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-icon {
      position: absolute;
      left: 16px;
      color: var(--text-400);
      font-size: 15px;
      pointer-events: none;
      transition: color 0.2s;
    }
    .form-input {
      width: 100%;
      padding: 13px 16px 13px 46px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 16px;
      font-size: 14.5px;
      color: var(--text-900);
      font-family: inherit;
      outline: none;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .form-input::placeholder {
      color: var(--text-400);
      opacity: 0.7;
    }
    .form-input:focus {
      border-color: var(--brand-primary);
      background: var(--card-bg);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15), 0 4px 16px rgba(99, 102, 241, 0.1);
    }
    .form-input:focus + .input-icon,
    .input-wrapper:focus-within .input-icon {
      color: var(--brand-primary);
    }

    .pw-toggle-btn {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: var(--text-400);
      cursor: pointer;
      font-size: 15px;
      padding: 6px;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .pw-toggle-btn:hover {
      color: var(--text-900);
      background: rgba(99, 102, 241, 0.1);
    }

    .submit-button {
      width: 100%;
      padding: 15px;
      margin-top: 10px;
      border: none;
      border-radius: 16px;
      background: var(--brand-gradient);
      color: #FFFFFF;
      font-size: 15.5px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .submit-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(99, 102, 241, 0.45);
    }
    .submit-button:active {
      transform: scale(0.98);
    }
    .submit-button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    .spinner-ring {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #FFF;
      border-radius: 50%;
      animation: spinRing 0.7s linear infinite;
    }
    @keyframes spinRing { to { transform: rotate(360deg); } }

    .switch-link-wrapper {
      margin-top: 24px;
      text-align: center;
      font-size: 13.5px;
      color: var(--text-500);
    }
    .switch-link-wrapper a {
      color: var(--brand-primary);
      font-weight: 700;
      text-decoration: none;
      transition: color 0.2s;
    }
    .switch-link-wrapper a:hover {
      color: var(--brand-secondary);
      text-decoration: underline;
    }

    @media (max-width: 900px) {
      .auth-left { display: none; }
      .auth-wrapper { max-width: 460px; }
      .auth-right { padding: 44px 32px; }
    }
    @media (max-width: 480px) {
      body { padding: 16px; }
      .auth-right { padding: 36px 20px; }
    }
  </style>
</head>
<body>

  <canvas id="interactive-canvas"></canvas>
  <div class="mouse-spotlight" id="spotlight"></div>

  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="top-action-bar">
    <button class="theme-toggle-btn" id="themeToggle" title="Mavzuni o'zgartirish">
      <i class="fas fa-moon" id="themeIcon"></i>
    </button>
  </div>

  <div class="auth-wrapper">
    <div class="auth-container" id="authCard">

      <div class="auth-left">
        <div>
          <div class="brand-header">
            <img src="/img/logo-light.png" alt="DESCO CRM" class="app-brand-logo" style="height: 48px; width: auto; object-fit: contain;">
          </div>
          <script>
            (function() {
              var t = localStorage.getItem('crm-theme') || 'light';
              var img = document.querySelector('.brand-header .app-brand-logo');
              if (img && t === 'dark') img.src = '/img/logo-dark.png';
            })();
          </script>

          <div class="status-badge">
            <span class="status-dot"></span>
            Real-vaqt Tizim 2.0
          </div>

          <div class="hero-content">
            <h1 class="hero-title">
              Biznes boshqaruvini<br>
              <span class="gradient-text">yangi darajaga</span><br>
              olib chiqing
            </h1>
            <p class="hero-subtitle">
              Sdelkalar, mijozlar ba'zasi, moliya va ombor nazoratini yagona aqlli platformada boshqaring.
            </p>

            <div class="features-list">
              <div class="feature-item">
                <div class="feature-icon-wrapper"><i class="fas fa-chart-pie"></i></div>
                <span class="feature-text">Analitika va daromad hisobotlari</span>
              </div>
              <div class="feature-item">
                <div class="feature-icon-wrapper"><i class="fas fa-handshake-angle"></i></div>
                <span class="feature-text">Sdelka va nasiyalar nazorati</span>
              </div>
              <div class="feature-item">
                <div class="feature-icon-wrapper"><i class="fas fa-boxes-stacked"></i></div>
                <span class="feature-text">Ombor va avtomatik zaxira</span>
              </div>
              <div class="feature-item">
                <div class="feature-icon-wrapper"><i class="fab fa-instagram"></i></div>
                <span class="feature-text">Instagram lead avtomatizatsiyasi</span>
              </div>
            </div>
          </div>
        </div>

        <div class="left-footer-text">
          &copy; <%= new Date().getFullYear() %> Desco CRM. Barcha huquqlar himoyalangan.
        </div>
      </div>

      <div class="auth-right">
        <div class="form-header">
          <h2 class="form-title">Yangi akkaunt</h2>
          <p class="form-subtitle">CRM xizmatidan foydalanish uchun ro'yxatdan o'ting</p>
        </div>

        <div class="alert-banner" id="errorBox">
          <i class="fas fa-circle-exclamation"></i>
          <span id="errorText"></span>
        </div>

        <form id="regForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="fullName">Ism-familiya</label>
            <div class="input-wrapper">
              <i class="fas fa-user input-icon"></i>
              <input type="text" id="fullName" name="fullName" class="form-input" placeholder="To'liq ismingiz" required autofocus>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Email Manzil</label>
            <div class="input-wrapper">
              <i class="fas fa-envelope input-icon"></i>
              <input type="email" id="email" name="email" class="form-input" placeholder="nomi@company.uz" required autocomplete="username">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Parol</label>
            <div class="input-wrapper">
              <i class="fas fa-lock input-icon"></i>
              <input type="password" id="password" name="password" class="form-input" placeholder="Kamida 6 ta belgi" required autocomplete="new-password">
              <button type="button" class="pw-toggle-btn" onclick="togglePassword()" tabindex="-1">
                <i class="fas fa-eye" id="pwIcon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="submit-button" id="regBtn">
            <i class="fas fa-user-plus" id="btnIcon"></i>
            <span id="btnText">Ro'yxatdan o'tish</span>
          </button>
        </form>

        <div class="switch-link-wrapper">
          Akkauntingiz bormi? <a href="/login">Kirish</a>
        </div>
      </div>

    </div>
  </div>

  <script>
    const themeBtn = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');

    function updateThemeIcon(theme) {
      if (theme === 'dark') {
        themeIcon.className = 'fas fa-sun';
      } else {
        themeIcon.className = 'fas fa-moon';
      }
    }

    const currentTheme = localStorage.getItem('crm-theme') || 'light';
    document.documentElement.setAttribute('data-theme', currentTheme);
    updateThemeIcon(currentTheme);
    document.querySelectorAll('.app-brand-logo').forEach(img => {
      img.src = currentTheme === 'dark' ? '/img/logo-dark.png' : '/img/logo-light.png';
    });

    themeBtn.addEventListener('click', () => {
      const activeTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('crm-theme', newTheme);
      updateThemeIcon(newTheme);
      document.querySelectorAll('.app-brand-logo').forEach(img => {
        img.src = newTheme === 'dark' ? '/img/logo-dark.png' : '/img/logo-light.png';
      });
    });

    const canvas = document.getElementById('interactive-canvas');
    const ctx = canvas.getContext('2d');
    const spotlight = document.getElementById('spotlight');

    let width = canvas.width = window.innerWidth;
    let height = canvas.height = window.innerHeight;

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initParticles();
    });

    const mouse = { x: width / 2, y: height / 2, targetX: width / 2, targetY: height / 2, isMoved: false };

    window.addEventListener('mousemove', (e) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
      mouse.isMoved = true;
      spotlight.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
    });

    class Particle {
      constructor() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.8;
        this.vy = (Math.random() - 0.5) * 0.8;
        this.radius = Math.random() * 2 + 1.5;
        this.baseAlpha = Math.random() * 0.4 + 0.2;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;

        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;

        if (mouse.isMoved) {
          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const maxDist = 180;
          if (dist < maxDist) {
            const force = (maxDist - dist) / maxDist;
            this.x -= (dx / dist) * force * 1.5;
            this.y -= (dy / dist) * force * 1.5;
          }
        }
      }

      draw() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = isDark ? `rgba(139, 92, 246, ${this.baseAlpha + 0.2})` : `rgba(99, 102, 241, ${this.baseAlpha})`;
        ctx.fill();
      }
    }

    let particles = [];
    function initParticles() {
      particles = [];
      const particleCount = Math.min(Math.floor((width * height) / 12000), 90);
      for (let i = 0; i < particleCount; i++) {
        particles.push(new Particle());
      }
    }
    initParticles();

    function animateParticles() {
      ctx.clearRect(0, 0, width, height);

      mouse.x += (mouse.targetX - mouse.x) * 0.1;
      mouse.y += (mouse.targetY - mouse.y) * 0.1;

      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

      for (let i = 0; i < particles.length; i++) {
        particles[i].update();
        particles[i].draw();

        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 130) {
            const alpha = (1 - dist / 130) * 0.25;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = isDark ? `rgba(168, 85, 247, ${alpha})` : `rgba(99, 102, 241, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        if (mouse.isMoved) {
          const mdx = particles[i].x - mouse.x;
          const mdy = particles[i].y - mouse.y;
          const mdist = Math.sqrt(mdx * mdx + mdy * mdy);

          if (mdist < 160) {
            const mAlpha = (1 - mdist / 160) * 0.45;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.strokeStyle = isDark ? `rgba(236, 72, 153, ${mAlpha})` : `rgba(139, 92, 246, ${mAlpha})`;
            ctx.lineWidth = 1.2;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animateParticles);
    }
    animateParticles();

    const authCard = document.getElementById('authCard');
    document.addEventListener('mousemove', (e) => {
      if (window.innerWidth <= 900) return;
      const rect = authCard.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const deltaX = e.clientX - centerX;
      const deltaY = e.clientY - centerY;

      const rotateX = (deltaY / (window.innerHeight / 2)) * -6;
      const rotateY = (deltaX / (window.innerWidth / 2)) * 6;

      authCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    document.addEventListener('mouseleave', () => {
      authCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
    });

    function togglePassword() {
      const passwordInput = document.getElementById('password');
      const pwIcon = document.getElementById('pwIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        pwIcon.className = 'fas fa-eye-slash';
      } else {
        passwordInput.type = 'password';
        pwIcon.className = 'fas fa-eye';
      }
    }

    function showError(text) {
      document.getElementById('errorText').textContent = text;
      document.getElementById('errorBox').classList.add('show');
    }
    function hideError() {
      document.getElementById('errorBox').classList.remove('show');
    }

    document.getElementById('regForm').addEventListener('submit', async e => {
      e.preventDefault();
      hideError();
      const fullName = document.getElementById('fullName').value.trim();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const btn = document.getElementById('regBtn');
      const btnText = document.getElementById('btnText');
      const btnIcon = document.getElementById('btnIcon');

      if (!fullName || !email || !password) {
        showError("Barcha maydonlarni to'ldiring");
        return;
      }

      btn.disabled = true;
      btnIcon.className = 'spinner-ring';
      btnText.textContent = 'Yuborilmoqda...';

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullName, email, password })
        });
        const data = await res.json();
        if (!res.ok) {
          showError(data.message || 'Xatolik yuz berdi');
          btn.disabled = false;
          btnIcon.className = 'fas fa-user-plus';
          btnText.textContent = "Ro'yxatdan o'tish";
          return;
        }
        window.location.href = '/';
      } catch {
        showError("Server bilan bog'lanishda xatolik yuz berdi");
        btn.disabled = false;
        btnIcon.className = 'fas fa-user-plus';
        btnText.textContent = "Ro'yxatdan o'tish";
      }
    });
  </script>
</body>
</html>
