<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kirish — DESCO CRM</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>document.documentElement.setAttribute('data-theme', 'light');</script>
  <style>
    :root {
      --brand: #4F46E5;
      --brand-hover: #4338CA;
      --brand-soft: rgba(79, 70, 229, 0.08);
      --text-900: #0F172A;
      --text-700: #334155;
      --text-500: #64748B;
      --text-300: #94A3B8;
      
      --surface-card: rgba(255, 255, 255, 0.45);
      --surface-input: rgba(255, 255, 255, 0.25);
      --border: rgba(255, 255, 255, 0.4);
      --border-strong: rgba(255, 255, 255, 0.6);
      
      --shadow-sm: 0 4px 12px rgba(31, 38, 135, 0.04);
      --shadow-md: 0 8px 32px rgba(31, 38, 135, 0.07);
      --shadow-lg: 0 12px 40px rgba(31, 38, 135, 0.12);
      
      --danger: #EF4444;
      --danger-bg: rgba(239, 68, 68, 0.1);
      --danger-border: rgba(239, 68, 68, 0.25);
    }
    [data-theme="dark"] {
      --text-900: #F8FAFC;
      --text-700: #CBD5E1;
      --text-500: #94A3B8;
      --text-300: #475569;
      
      --surface-card: rgba(18, 22, 33, 0.55);
      --surface-input: rgba(0, 0, 0, 0.2);
      --border: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.35);
      --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
    }
    
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }
    
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: radial-gradient(circle at top left, #EEF2F6, #DDE3EC) !important;
      color: var(--text-900);
      overflow-x: hidden;
      position: relative;
      transition: background 0.3s, color 0.3s;
    }
    [data-theme="dark"] body {
      background: radial-gradient(circle at top left, #0D0F17, #06070B) !important;
    }
    
    /* Background Ambient Glowing Blobs & Animated Particles */
    .glass-blobs {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: radial-gradient(circle at 50% 50%, #F8FAFC, #E2E8F0) !important;
    }
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.72;
      pointer-events: none;
    }
    .blob-1 {
      top: -10%; left: -10%;
      width: 45vw; height: 45vw;
      background: radial-gradient(circle, rgba(79, 70, 229, 0.35) 0%, transparent 75%);
      animation: morph-1 25s infinite alternate ease-in-out;
    }
    .blob-2 {
      bottom: -15%; right: -10%;
      width: 50vw; height: 50vw;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.3) 0%, transparent 75%);
      animation: morph-2 30s infinite alternate ease-in-out;
    }
    .blob-3 {
      top: 30%; left: 35%;
      width: 35vw; height: 35vw;
      background: radial-gradient(circle, rgba(236, 72, 153, 0.22) 0%, transparent 75%);
      animation: morph-3 20s infinite alternate ease-in-out;
    }
    .blob-4 {
      bottom: 40%; left: -15%;
      width: 40vw; height: 40vw;
      background: radial-gradient(circle, rgba(45, 212, 191, 0.25) 0%, transparent 75%);
      animation: morph-4 28s infinite alternate ease-in-out;
    }
    
    @keyframes morph-1 {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); }
      50% { transform: translate(80px, 60px) scale(1.15) rotate(180deg); }
      100% { transform: translate(-40px, 100px) scale(0.9) rotate(360deg); }
    }
    @keyframes morph-2 {
      0% { transform: translate(0, 0) scale(1.1) rotate(0deg); }
      50% { transform: translate(-100px, -40px) scale(0.85) rotate(-180deg); }
      100% { transform: translate(60px, -80px) scale(1.05) rotate(-360deg); }
    }
    @keyframes morph-3 {
      0% { transform: translate(0, 0) scale(0.9) rotate(0deg); }
      50% { transform: translate(50px, -90px) scale(1.1) rotate(120deg); }
      100% { transform: translate(-60px, 40px) scale(0.95) rotate(240deg); }
    }
    @keyframes morph-4 {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); }
      50% { transform: translate(120px, -60px) scale(0.9) rotate(-120deg); }
      100% { transform: translate(-80px, 80px) scale(1.2) rotate(-240deg); }
    }

    /* Floating Particles */
    .particles-container {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      overflow: hidden;
      z-index: 1;
    }
    .particle {
      position: absolute;
      bottom: -60px;
      background: radial-gradient(circle, rgba(79, 70, 229, 0.18) 0%, rgba(139, 92, 246, 0.04) 50%, transparent 100%);
      border-radius: 50%;
      pointer-events: none;
      animation: rise-up 20s infinite linear;
    }
    @keyframes rise-up {
      0% {
        transform: translateY(0) scale(0.5);
        opacity: 0;
      }
      10% {
        opacity: 0.6;
      }
      90% {
        opacity: 0.6;
      }
      100% {
        transform: translateY(-110vh) scale(1.2);
        opacity: 0;
      }
    }
    .p-1 { left: 10%; width: 80px; height: 80px; animation-duration: 22s; animation-delay: 0s; }
    .p-2 { left: 25%; width: 120px; height: 120px; animation-duration: 28s; animation-delay: -3s; }
    .p-3 { left: 40%; width: 60px; height: 60px; animation-duration: 18s; animation-delay: -6s; }
    .p-4 { left: 55%; width: 140px; height: 140px; animation-duration: 32s; animation-delay: -2s; }
    .p-5 { left: 70%; width: 90px; height: 90px; animation-duration: 25s; animation-delay: -8s; }
    .p-6 { left: 85%; width: 110px; height: 110px; animation-duration: 27s; animation-delay: -5s; }
    .p-7 { left: 15%; width: 70px; height: 70px; animation-duration: 20s; animation-delay: -10s; }
    .p-8 { left: 65%; width: 100px; height: 100px; animation-duration: 24s; animation-delay: -12s; }
    
    /* Center Glass Panel */
    .auth-container {
      display: flex;
      width: 100%;
      max-width: 960px;
      min-height: 580px;
      border-radius: 28px;
      background: var(--surface-card);
      backdrop-filter: blur(25px) saturate(190%);
      -webkit-backdrop-filter: blur(25px) saturate(190%);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      position: relative;
      z-index: 1;
      animation: containerIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    
    @keyframes containerIn {
      from { opacity: 0; transform: translateY(30px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    
    /* Left Panel (Logo + Info) */
    .auth-left {
      width: 48%;
      padding: 48px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid var(--border);
      background: rgba(79, 70, 229, 0.02);
      position: relative;
      z-index: 1;
    }
    [data-theme="dark"] .auth-left {
      background: rgba(79, 70, 229, 0.05);
    }
    
    .left-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .left-logo-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .left-logo-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .left-logo-text {
      font-size: 20px;
      font-weight: 800;
      color: var(--text-900);
      letter-spacing: -0.5px;
    }
    .left-logo-text span {
      color: var(--brand);
    }
    
    .left-content {
      margin: 40px 0;
    }
    .left-tagline {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-900);
      line-height: 1.25;
      letter-spacing: -0.8px;
      margin-bottom: 14px;
    }
    .left-tagline span {
      background: linear-gradient(135deg, #4F46E5, #9333EA);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .left-desc {
      font-size: 14px;
      color: var(--text-500);
      line-height: 1.6;
      margin-bottom: 24px;
    }
    
    .left-features {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .left-feature {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--text-700);
      font-size: 13.5px;
      background: rgba(255, 255, 255, 0.25);
      border: 1px solid var(--border);
      padding: 10px 14px;
      border-radius: 14px;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
    }
    [data-theme="dark"] .left-feature {
      background: rgba(255, 255, 255, 0.03);
    }
    .left-feature:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.35);
    }
    [data-theme="dark"] .left-feature:hover {
      background: rgba(255, 255, 255, 0.06);
    }
    .left-feature-icon {
      width: 28px;
      height: 28px;
      background: var(--brand-soft);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--brand);
      font-size: 12px;
      flex-shrink: 0;
    }
    
    .left-footer {
      font-size: 12px;
      color: var(--text-500);
      opacity: 0.8;
    }
    
    /* Right Panel (Form) */
    .auth-right {
      flex: 1;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }
    
    .auth-form-wrap {
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
    }
    
    .form-top {
      margin-bottom: 28px;
    }
    .form-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-900);
      letter-spacing: -0.6px;
      margin-bottom: 6px;
    }
    .form-subtitle {
      font-size: 14px;
      color: var(--text-500);
    }
    
    .error-box {
      background: var(--danger-bg);
      color: var(--danger);
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 13.5px;
      margin-bottom: 20px;
      display: none;
      border: 1px solid var(--danger-border);
      font-weight: 500;
      align-items: center;
      gap: 10px;
      animation: shake 0.4s ease-in-out;
    }
    .error-box.show { display: flex; }
    
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }
    
    .field {
      margin-bottom: 16px;
    }
    .field label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-700);
      margin-bottom: 6px;
      letter-spacing: 0.1px;
    }
    .field-inner {
      position: relative;
    }
    .field-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-500);
      font-size: 14px;
      pointer-events: none;
      opacity: 0.8;
    }
    
    .field input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      background: var(--surface-input);
      border: 1px solid var(--border);
      border-radius: 14px;
      font-size: 14px;
      color: var(--text-900);
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
    }
    .field input::placeholder { color: var(--text-300); opacity: 0.7; }
    .field input:focus {
      border-color: var(--brand);
      background: var(--surface-card);
      box-shadow: 0 0 0 3px var(--brand-soft);
    }
    
    .pw-toggle {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--text-500);
      cursor: pointer;
      font-size: 14px;
      padding: 4px;
      transition: color 0.15s;
      opacity: 0.8;
    }
    .pw-toggle:hover { color: var(--text-900); }
    
    .submit-btn {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
      color: #fff;
      border: none;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      box-shadow: 0 8px 24px rgba(79, 70, 229, 0.3);
      margin-top: 8px;
    }
    .submit-btn:hover {
      box-shadow: 0 12px 28px rgba(79, 70, 229, 0.38);
      transform: translateY(-1px);
    }
    .submit-btn:active {
      transform: scale(0.98);
    }
    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }
    
    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
      display: inline-block;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    
    .form-links {
      margin-top: 28px;
      text-align: center;
      font-size: 13px;
      color: var(--text-500);
    }
    .form-links a {
      color: var(--brand);
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.15s;
    }
    .form-links a:hover { opacity: 0.8; }
    .form-links-row {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 10px;
    }
    
    /* Top Header Controls (Theme switch) */
    .header-controls {
      position: absolute;
      top: 24px;
      right: 24px;
      display: flex;
      gap: 8px;
      z-index: 10;
    }
    .theme-toggle {
      width: 38px;
      height: 38px;
      background: var(--surface-input);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text-700);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      transition: background 0.15s, color 0.15s, transform 0.15s;
    }
    .theme-toggle:hover {
      color: var(--text-900);
      background: var(--surface-card);
      transform: translateY(-1px);
    }
    .theme-toggle:active {
      transform: scale(0.96);
    }
    
    /* Responsiveness */
    @media (max-width: 850px) {
      .auth-left { display: none; }
      .auth-container { max-width: 440px; min-height: auto; }
      .auth-right { padding: 40px 32px; }
    }
    @media (max-width: 480px) {
      body { padding: 16px; }
      .auth-right { padding: 36px 20px; }
    }
  </style>
</head>
<body>

<div class="glass-blobs">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <div class="blob blob-4"></div>
  <div class="particles-container">
    <div class="particle p-1"></div>
    <div class="particle p-2"></div>
    <div class="particle p-3"></div>
    <div class="particle p-4"></div>
    <div class="particle p-5"></div>
    <div class="particle p-6"></div>
    <div class="particle p-7"></div>
    <div class="particle p-8"></div>
  </div>
</div>

<div class="auth-container">
  <!-- Left Side: App Intro -->
  <div class="auth-left">
    <div class="left-logo">
      <div class="left-logo-icon">
        <img src="/img/logo.jpg" alt="Logo">
      </div>
      <div class="left-logo-text">Desco<span>.crm</span></div>
    </div>
    
    <div class="left-content">
      <div class="left-tagline">
        Biznes boshqaruvini<br>
        <span>yangi darajaga</span><br>
        olib chiqing
      </div>
      <p class="left-desc">Sdelkalar, mijozlar, moliya va omborni — barchasini bir tizimda, real vaqtda boshqaring.</p>
      
      <div class="left-features">
        <div class="left-feature">
          <div class="left-feature-icon"><i class="fas fa-chart-line"></i></div>
          <span>Real vaqtdagi tahlil va hisobotlar</span>
        </div>
        <div class="left-feature">
          <div class="left-feature-icon"><i class="fas fa-handshake"></i></div>
          <span>Sdelkalar va nasiya boshqaruvi</span>
        </div>
        <div class="left-feature">
          <div class="left-feature-icon"><i class="fas fa-warehouse"></i></div>
          <span>Ombor va mahsulot nazorati</span>
        </div>
        <div class="left-feature">
          <div class="left-feature-icon"><i class="fab fa-instagram"></i></div>
          <span>Instagram lead integratsiyasi</span>
        </div>
      </div>
    </div>
    
    <div class="left-footer">&copy; 2024 Desco CRM. Barcha huquqlar himoyalangan.</div>
  </div>
  
  <!-- Right Side: Login Form -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <div class="form-top">
        <h1 class="form-title">Xush kelibsiz</h1>
        <p class="form-subtitle">Davom etish uchun hisobingizga kiring</p>
      </div>
      
      <div class="error-box" id="errorBox">
        <i class="fas fa-exclamation-circle"></i>
        <span id="errorText"></span>
      </div>
      
      <form id="loginForm" novalidate>
        <div class="field">
          <label for="email">Email manzil</label>
          <div class="field-inner">
            <i class="fas fa-envelope field-icon"></i>
            <input type="email" id="email" name="email" placeholder="email@example.com" required autofocus autocomplete="username">
          </div>
        </div>
        
        <div class="field">
          <label for="password">Parol</label>
          <div class="field-inner">
            <i class="fas fa-lock field-icon"></i>
            <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
            <button type="button" class="pw-toggle" onclick="togglePw()" tabindex="-1">
              <i class="fas fa-eye" id="pwIcon"></i>
            </button>
          </div>
        </div>
        
        <button type="submit" class="submit-btn" id="loginBtn">
          <i class="fas fa-right-to-bracket"></i>
          <span id="btnText">Kirish</span>
        </button>
      </form>
      
      <div class="form-links">
        <span>Muammo? Bog'laning:</span>
        <div class="form-links-row">
          <a href="mailto:muhammedaminov169@gmail.com"><i class="fas fa-envelope"></i> Email</a>
          <a href="https://t.me/useraminov" target="_blank" rel="noopener noreferrer"><i class="fab fa-telegram"></i> Telegram</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function applyTheme(t){
  document.documentElement.setAttribute('data-theme','light');
}
applyTheme('light');

function togglePw(){
  const inp=document.getElementById('password');
  const icon=document.getElementById('pwIcon');
  if(inp.type==='password'){inp.type='text';icon.className='fas fa-eye-slash';}
  else{inp.type='password';icon.className='fas fa-eye';}
}

const params=new URLSearchParams(window.location.search);
const msg=params.get('msg');
if(msg) showError(msg);

function showError(text){
  document.getElementById('errorText').textContent=text;
  document.getElementById('errorBox').classList.add('show');
}
function hideError(){document.getElementById('errorBox').classList.remove('show');}

document.getElementById('loginForm').addEventListener('submit',async(e)=>{
  e.preventDefault();
  hideError();
  const email=document.getElementById('email').value.trim();
  const password=document.getElementById('password').value;
  const btn=document.getElementById('loginBtn');
  const btnText=document.getElementById('btnText');
  if(!email){showError("Emailni kiriting");return;}
  btn.disabled=true;
  btnText.innerHTML='<span class="spinner"></span> Kirilmoqda...';
  try{
    const res=await fetch('/api/auth/login',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({email,password})
    });
    const data=await res.json();
    if(!res.ok){
      showError(data.message||"Email yoki parol noto'g'ri");
      btn.disabled=false;
      btnText.innerHTML='<i class="fas fa-right-to-bracket"></i> Kirish';
      return;
    }
    window.location.href='/';
  }catch{
    showError("Server bilan bog'lanishda xatolik yuz berdi");
    btn.disabled=false;
    btnText.innerHTML='<i class="fas fa-right-to-bracket"></i> Kirish';
  }
});
</script>
</body>
</html>
