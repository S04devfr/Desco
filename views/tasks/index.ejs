<%- include('../layouts/header', {
  title: 'Vazifalar / Kanban — DESCO CRM',
  activePage: 'tasks',
  user: user
}) %>

<style>
/* ══════════════════════════════════════════════════════════════════════════════
   TRELLO-STYLE KANBAN & TASK WORKSPACE STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

.task-workspace {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 85px);
  overflow: hidden;
  position: relative;
}

/* ── Workspace Header ─────────────────────────────────────────────── */
.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 8px 0 16px 0;
  flex-wrap: wrap;
  flex-shrink: 0;
}

.task-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.board-select-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 12px;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  backdrop-filter: blur(10px);
}
.board-select-btn:hover {
  border-color: var(--accent);
  transform: translateY(-1px);
}

.task-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* ── View Toggle & Filter Pills ───────────────────────────────────── */
.view-switch {
  display: flex;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 2px;
  gap: 2px;
}
.view-switch-btn {
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  border-radius: 8px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s ease;
}
.view-switch-btn.active {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 2px 8px rgba(0, 122, 255, 0.3);
}

.task-search-input {
  height: 34px;
  padding: 0 12px 0 34px;
  font-size: 12.5px;
  border-radius: 10px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text-primary);
  width: 220px;
  transition: all 0.2s ease;
}
.task-search-input:focus {
  width: 260px;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.15);
  outline: none;
}

/* ── Filter Bar ───────────────────────────────────────────────────── */
.task-filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 12px;
  flex-shrink: 0;
  overflow-x: auto;
}
.task-filter-chip {
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  transition: all 0.15s ease;
}
.task-filter-chip:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}
.task-filter-chip.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 2px 6px rgba(0, 122, 255, 0.25);
}

/* ── Kanban Board Layout ─────────────────────────────────────────── */
.kanban-board-container {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  overflow-y: hidden;
  flex: 1;
  padding-bottom: 16px;
  align-items: flex-start;
  user-select: none;
}

.kanban-column {
  width: 320px;
  min-width: 320px;
  max-width: 320px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  max-height: 100%;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(14px);
  transition: transform 0.2s, box-shadow 0.2s;
}

.kanban-column-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px 10px 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  cursor: grab;
}

.kanban-column-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
}

.col-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.col-badge {
  font-size: 11px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 10px;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

.kanban-cards-list {
  padding: 10px 12px;
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 120px;
  transition: background 0.15s ease;
}

.kanban-cards-list.drag-over {
  background: rgba(0, 122, 255, 0.06);
  border-radius: 12px;
}

/* ── Task Card Design ─────────────────────────────────────────────── */
.task-card {
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  cursor: grab;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

.task-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  border-color: rgba(0, 122, 255, 0.4);
}

.task-card.dragging {
  opacity: 0.35;
  transform: rotate(2deg) scale(1.02);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
}

.task-card.completed {
  opacity: 0.65;
}
.task-card.completed .task-card-title {
  text-decoration: line-through;
  color: var(--text-tertiary);
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 6px;
  margin-bottom: 6px;
}

.task-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 6px;
}

.task-tag {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  text-transform: uppercase;
  letter-spacing: 0.2px;
}

.priority-badge-low { background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
.priority-badge-medium { background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }
.priority-badge-high { background: rgba(239, 68, 68, 0.12); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
.priority-badge-urgent { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3); }

.task-card-title {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 6px;
  word-break: break-word;
}

.task-card-client {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--accent);
  background: rgba(0, 122, 255, 0.08);
  padding: 3px 8px;
  border-radius: 6px;
  margin-bottom: 8px;
  text-decoration: none;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-card-checklist-bar {
  width: 100%;
  height: 4px;
  background: var(--bg-tertiary);
  border-radius: 2px;
  margin-bottom: 8px;
  overflow: hidden;
}
.task-card-checklist-fill {
  height: 100%;
  background: #10b981;
  border-radius: 2px;
  transition: width 0.3s ease;
}

.task-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
  color: var(--text-secondary);
  gap: 6px;
  margin-top: 4px;
}

.task-meta-left {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.task-due-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
  background: var(--bg-tertiary);
}
.task-due-badge.overdue {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.task-user-avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-soft), rgba(88,86,214,0.2));
  color: var(--brand);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 800;
  border: 1px solid rgba(0, 122, 255, 0.2);
}

/* ── Quick Card Creator ───────────────────────────────────────────── */
.quick-add-card-wrap {
  padding: 8px 12px 12px 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}
.quick-add-btn {
  width: 100%;
  padding: 8px;
  background: transparent;
  border: 1px dashed var(--border);
  border-radius: 10px;
  color: var(--text-secondary);
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  transition: all 0.15s ease;
}
.quick-add-btn:hover {
  background: rgba(0, 122, 255, 0.08);
  border-color: var(--accent);
  color: var(--accent);
}

.quick-add-form {
  display: none;
  flex-direction: column;
  gap: 8px;
}
.quick-add-input {
  width: 100%;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: 13px;
}
.quick-add-actions {
  display: flex;
  gap: 6px;
  justify-content: flex-end;
}

/* ── Add Column Button ────────────────────────────────────────────── */
.add-column-btn {
  min-width: 260px;
  height: 52px;
  border-radius: 14px;
  border: 2px dashed var(--border);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text-secondary);
  font-size: 13.5px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.add-column-btn:hover {
  background: rgba(0, 122, 255, 0.08);
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
}

/* ── Slide-Over Task Detail Drawer ─────────────────────────────────── */
.task-drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: none;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.task-drawer-overlay.active {
  display: block;
  opacity: 1;
}

.task-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 620px;
  max-width: 95vw;
  height: 100vh;
  background: var(--bg-primary);
  border-left: 1px solid var(--border);
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.2);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}
.task-drawer.active {
  transform: translateX(0);
}

.task-drawer-header {
  padding: 16px 22px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: var(--bg-secondary);
}

.task-drawer-body {
  padding: 22px;
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Drawer Detail Grid */
.drawer-props-grid {
  display: grid;
  grid-template-columns: 140px 1fr;
  row-gap: 14px;
  column-gap: 12px;
  align-items: center;
  font-size: 13px;
}
.drawer-prop-label {
  color: var(--text-secondary);
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
}

.drawer-section-title {
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

/* Checklist Items */
.checklist-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 8px;
  border-radius: 8px;
  transition: background 0.15s ease;
}
.checklist-row:hover {
  background: var(--bg-secondary);
}
.checklist-row.done .checklist-text {
  text-decoration: line-through;
  color: var(--text-tertiary);
}

/* Comments Feed */
.comment-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 10px;
}

/* List View Table */
.task-table {
  width: 100%;
  border-collapse: collapse;
}
.task-table th {
  background: var(--bg-secondary);
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 800;
  color: var(--text-secondary);
  text-align: left;
  border-bottom: 1px solid var(--border);
}
.task-table td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  color: var(--text-primary);
}
.task-table tr:hover {
  background: rgba(0, 122, 255, 0.03);
}

/* Responsive */
@media (max-width: 768px) {
  .task-drawer { width: 100vw; max-width: 100vw; }
  .kanban-column { width: 280px; min-width: 280px; }
}
</style>

<div class="task-workspace">

  <!-- ══════════════════════════════════════════════════════════════════════════
       1. WORKSPACE HEADER
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="task-header">
    <div class="task-header-left">
      <!-- Board Selector -->
      <div style="position: relative;">
        <button class="board-select-btn" id="activeBoardBtn" onclick="toggleBoardDropdown()">
          <i class="fas fa-clipboard-list" id="activeBoardIcon" style="color: var(--accent);"></i>
          <span id="activeBoardName">Asosiy Vazifalar</span>
          <i class="fas fa-chevron-down" style="font-size: 11px; opacity: 0.6; margin-left: 4px;"></i>
        </button>
        <!-- Board Dropdown Menu -->
        <div id="boardDropdownMenu" style="display:none; position:absolute; top:calc(100% + 6px); left:0; width:250px; background:var(--bg-secondary); border:1px solid var(--border); border-radius:12px; box-shadow:var(--shadow-lg); z-index:200; padding:6px;">
          <div id="boardDropdownList" style="display:flex; flex-direction:column; gap:2px; max-height:220px; overflow-y:auto;">
            <!-- Rendered dynamically -->
          </div>
          <div style="border-top:1px solid var(--border); margin-top:6px; padding-top:6px;">
            <button class="btn btn-ghost btn-sm" onclick="openCreateBoardModal()" style="width:100%; justify-content:flex-start; font-size:12px; color:var(--accent);">
              <i class="fas fa-plus"></i> Yangi board yaratish
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Search -->
      <div style="position: relative;">
        <i class="fas fa-search" style="position: absolute; left: 12px; top: 10px; font-size: 12px; color: var(--text-tertiary);"></i>
        <input type="text" id="taskSearchInput" class="task-search-input" placeholder="Qidirish... ( / )" oninput="onTaskSearchInput(this.value)">
      </div>
    </div>

    <div class="task-header-right">
      <!-- View Switch (Kanban / List) -->
      <div class="view-switch">
        <button class="view-switch-btn active" id="btnViewKanban" onclick="switchTaskView('kanban')">
          <i class="fas fa-columns"></i> Kanban
        </button>
        <button class="view-switch-btn" id="btnViewList" onclick="switchTaskView('list')">
          <i class="fas fa-list"></i> Ro'yxat
        </button>
      </div>

      <!-- Add Column Button (Admin / Manager) -->
      <button class="btn btn-secondary btn-sm" onclick="openCreateColumnModal()" title="Yangi ustun qo'shish">
        <i class="fas fa-plus"></i> Ustun
      </button>

      <!-- Add Task Button -->
      <button class="btn btn-primary btn-sm" onclick="openCreateTaskModal()">
        <i class="fas fa-plus-circle"></i> Yangi Vazifa
      </button>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       2. FILTER BAR
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="task-filter-bar">
    <button class="task-filter-chip active" id="filterAll" onclick="setTaskFilter('all', this)">
      Barchasi
    </button>
    <button class="task-filter-chip" id="filterMine" onclick="setTaskFilter('mine', this)">
      <i class="fas fa-user"></i> Mening vazifalarim
    </button>
    <button class="task-filter-chip" id="filterToday" onclick="setTaskFilter('today', this)">
      <i class="fas fa-sun"></i> Bugun
    </button>
    <button class="task-filter-chip" id="filterOverdue" onclick="setTaskFilter('overdue', this)">
      <i class="fas fa-exclamation-triangle" style="color: #ef4444;"></i> Muddati o'tgan
    </button>
    <button class="task-filter-chip" id="filterUrgent" onclick="setTaskFilter('urgent', this)">
      <i class="fas fa-bolt" style="color: #f59e0b;"></i> Shoshilinch
    </button>
    <button class="task-filter-chip" id="filterDone" onclick="setTaskFilter('done', this)">
      <i class="fas fa-check-circle" style="color: #10b981;"></i> Bajarilgan
    </button>

    <!-- Assignee Filter Selector -->
    <select id="filterAssigneeSelect" class="form-control" style="width: auto; height: 28px; font-size: 11.5px; padding: 0 8px; border-radius: 14px;" onchange="loadTasks()">
      <option value="">Barcha mas'ullar</option>
    </select>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       3. KANBAN BOARD VIEW
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="kanban-board-container" id="kanbanBoardView">
    <div style="padding: 40px; text-align: center; width: 100%;">
      <div class="spinner" style="margin: auto;"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       4. LIST VIEW
       ══════════════════════════════════════════════════════════════════════════ -->
  <div id="taskListView" style="display: none; flex: 1; overflow-y: auto; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 16px; padding: 14px;">
    <table class="task-table">
      <thead>
        <tr>
          <th style="width: 40px;"></th>
          <th>Vazifa nomi</th>
          <th>Ustun / Status</th>
          <th>Muhimlik</th>
          <th>Mas'ul</th>
          <th>Muddat</th>
          <th>Mijoz</th>
          <th style="text-align: right;">Amallar</th>
        </tr>
      </thead>
      <tbody id="taskListTableBody">
        <tr><td colspan="8" class="tc" style="padding: 30px;"><div class="spinner" style="margin: auto;"></div></td></tr>
      </tbody>
    </table>
  </div>

</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     5. RIGHT SLIDE-OVER TASK DETAIL DRAWER
     ══════════════════════════════════════════════════════════════════════════ -->
<div class="task-drawer-overlay" id="taskDrawerOverlay" onclick="closeTaskDrawer()"></div>
<div class="task-drawer" id="taskDrawer">
  <!-- Drawer Header -->
  <div class="task-drawer-header">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="badge badge-brand" id="drawerStatusBadge">Yangi</span>
      <span style="font-size: 12px; color: var(--text-tertiary);" id="drawerTaskId">#0</span>
    </div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <button class="btn btn-ghost btn-sm" onclick="archiveCurrentDrawerTask()" title="Arxivlash">
        <i class="fas fa-archive"></i>
      </button>
      <button class="btn btn-ghost btn-sm text-red" onclick="deleteCurrentDrawerTask()" title="O'chirish">
        <i class="fas fa-trash-alt"></i>
      </button>
      <button class="modal-close" onclick="closeTaskDrawer()" style="font-size: 22px; width: 32px; height: 32px;">&times;</button>
    </div>
  </div>

  <!-- Drawer Body -->
  <div class="task-drawer-body">
    <!-- Title -->
    <div>
      <input type="text" id="drawerTaskTitle" style="font-size: 18px; font-weight: 800; color: var(--text-primary); background: transparent; border: 1px solid transparent; border-radius: 8px; width: 100%; padding: 4px 6px; transition: border-color 0.2s;" onchange="saveDrawerField('title', this.value)" placeholder="Vazifa nomi...">
    </div>

    <!-- Properties Grid -->
    <div class="drawer-props-grid">
      <!-- Status / Column -->
      <div class="drawer-prop-label"><i class="fas fa-columns"></i> Ustun:</div>
      <div>
        <select id="drawerColumnSelect" class="form-control" style="height: 32px; font-size: 12.5px;" onchange="onDrawerColumnChange(this.value)"></select>
      </div>

      <!-- Priority -->
      <div class="drawer-prop-label"><i class="fas fa-flag"></i> Muhimlik:</div>
      <div>
        <select id="drawerPrioritySelect" class="form-control" style="height: 32px; font-size: 12.5px;" onchange="saveDrawerField('priority', this.value)">
          <option value="low">🟢 Past (Low)</option>
          <option value="medium">🟡 O'rta (Medium)</option>
          <option value="high">🔴 Yuqori (High)</option>
          <option value="urgent">⚡ Shoshilinch (Urgent)</option>
