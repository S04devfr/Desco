  document.getElementById('columnNameInput').value = name;
  document.getElementById('columnColorInput').value = color;
  document.getElementById('columnModal').classList.remove('hidden');
}
function closeColumnModal() {
  document.getElementById('columnModal').classList.add('hidden');
}
async function submitColumnForm(e) {
  e.preventDefault();
  const editId = document.getElementById('columnEditId').value;
  const name = document.getElementById('columnNameInput').value.trim();
  const color = document.getElementById('columnColorInput').value;

  try {
    if (editId) {
      await fetch(`/api/tasks/columns/${editId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, color })
      });
    } else {
      await fetch('/api/tasks/columns', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ boardId: _activeBoardId, name, color })
      });
    }
    closeColumnModal();
    await loadBoardsList();
  } catch (err) {
    console.error('submitColumnForm error:', err);
  }
}

// ── View Switch (Kanban / List) ──────────────────────────────────────────────
function switchTaskView(view) {
  _currentView = view;
  document.getElementById('btnViewKanban').classList.toggle('active', view === 'kanban');
  document.getElementById('btnViewList').classList.toggle('active', view === 'list');
  document.getElementById('kanbanBoardView').style.display = view === 'kanban' ? 'flex' : 'none';
  document.getElementById('taskListView').style.display = view === 'list' ? 'block' : 'none';
  if (view === 'kanban') renderKanbanBoard();
  else renderListView();
}

// ── Search & Filter ──────────────────────────────────────────────────────────
function onTaskSearchInput(val) {
  clearTimeout(_searchDebounceTimer);
  _searchDebounceTimer = setTimeout(() => {
    loadTasks(false);
  }, 250);
}

function setTaskFilter(filterName, btnEl) {
  _currentFilter = filterName;
  document.querySelectorAll('.task-filter-chip').forEach(el => el.classList.remove('active'));
  btnEl.classList.add('active');
  loadTasks();
}
</script>

