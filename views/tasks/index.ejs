// ── Drag & Drop Engine (Optimistic UI) ────────────────────────────────────────
function onCardDragStart(e, id) {
  _dragTaskId = id;
  e.currentTarget.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
}

function onCardDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
  document.querySelectorAll('.kanban-cards-list').forEach(el => el.classList.remove('drag-over'));
  _dragTaskId = null;
}

function _dragAfterElement(container, y) {
  const draggableElements = [...container.querySelectorAll('.task-card:not(.dragging)')];
  return draggableElements.reduce((closest, child) => {
    const box = child.getBoundingClientRect();
    const offset = y - box.top - box.height / 2;
    if (offset < 0 && offset > closest.offset) {
      return { offset: offset, element: child };
    } else {
      return closest;
    }
  }, { offset: Number.NEGATIVE_INFINITY }).element;
}

function onCardDragOver(e) {
  e.preventDefault();
  const container = e.currentTarget;
  container.classList.add('drag-over');
  const afterElement = _dragAfterElement(container, e.clientY);
  const draggable = document.querySelector('.task-card.dragging');
  if (draggable) {
    if (afterElement == null) {
      container.appendChild(draggable);
    } else {
      container.insertBefore(draggable, afterElement);
    }
  }
}

function onCardDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

async function onCardDrop(e, columnId) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  if (!_dragTaskId) return;

  const taskId = _dragTaskId;
  _dragTaskId = null;

  // Calculate new order in target column
  const container = e.currentTarget;
  const cards = [...container.querySelectorAll('.task-card')];
  const newOrder = cards.findIndex(c => Number(c.dataset.taskId) === taskId);

  // Optimistic UI update in local state
  const task = _tasks.find(t => t.id === taskId);
  if (task) {
    task.columnId = columnId;
    task.order = newOrder >= 0 ? newOrder : 0;
  }

  // Persist to backend
  try {
    const r = await fetch(`/api/tasks/${taskId}/move`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ columnId, order: newOrder >= 0 ? newOrder : 0 })
    });
    if (!r.ok) {
      const errData = await r.json();
      throw new Error(errData.message || 'Ko\'chirishda xatolik');
    }
  } catch (err) {
    console.error('Task move error:', err);
    loadTasks(false); // Revert on failure
  }
}

// ── Quick Add Task ───────────────────────────────────────────────────────────
function showQuickAddForm(colId) {
  document.getElementById(`quickAddBtn_${colId}`).style.display = 'none';
  const form = document.getElementById(`quickAddForm_${colId}`);
  form.style.display = 'flex';
  const input = document.getElementById(`quickAddInput_${colId}`);
  input.focus();
}

function hideQuickAddForm(colId) {
  document.getElementById(`quickAddBtn_${colId}`).style.display = 'flex';
  const form = document.getElementById(`quickAddForm_${colId}`);
  form.style.display = 'none';
  document.getElementById(`quickAddInput_${colId}`).value = '';
}

function handleQuickAddKeyDown(e, colId) {
  if (e.key === 'Enter') {
    e.preventDefault();
    submitQuickAdd(colId);
  } else if (e.key === 'Escape') {
    hideQuickAddForm(colId);
  }
}

async function submitQuickAdd(colId) {
  const input = document.getElementById(`quickAddInput_${colId}`);
  const title = input ? input.value.trim() : '';
  if (!title) return;

  hideQuickAddForm(colId);

  try {
    const r = await fetch('/api/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title,
        boardId: _activeBoardId,
        columnId: colId,
        priority: 'medium'
      })
    });
    if (r.ok) {
      const created = await r.json();
      _tasks.push(created);
      renderKanbanBoard();
    }
  } catch (err) {
    console.error('Quick add error:', err);
  }
}

// ── Task Drawer (Slide-Over Detail) ──────────────────────────────────────────
async function openTaskDrawer(taskId) {
  _activeDrawerTaskId = taskId;
  const overlay = document.getElementById('taskDrawerOverlay');
  const drawer = document.getElementById('taskDrawer');
  overlay.classList.add('active');
  drawer.classList.add('active');

  try {
    const r = await fetch(`/api/tasks/${taskId}`);
    if (!r.ok) throw new Error('Vazifani yuklab bo\'lmadi');
    const task = await r.json();

    document.getElementById('drawerTaskId').textContent = `#${task.id}`;
    document.getElementById('drawerTaskTitle').value = task.title || '';
    document.getElementById('drawerDescription').value = task.description || '';
    document.getElementById('drawerPrioritySelect').value = task.priority || 'medium';
    document.getElementById('drawerAssigneeSelect').value = task.assignedToId || '';
    document.getElementById('drawerClientSelect').value = task.clientId || '';
    document.getElementById('drawerColumnSelect').value = task.columnId || '';
    document.getElementById('drawerDueDate').value = task.dueDate ? task.dueDate.slice(0, 10) : '';
    document.getElementById('drawerDueTime').value = task.dueTime || '';
    document.getElementById('drawerReminderSelect').value = task.reminderMinutes || '';

    const statusBadge = document.getElementById('drawerStatusBadge');
    if (statusBadge) {
      statusBadge.textContent = task.column ? task.column.name : (task.completed ? 'Bajarildi' : 'Yangi');
      statusBadge.style.background = task.column?.color || 'var(--accent)';
    }

    renderDrawerChecklist(task.checklists || []);
    renderDrawerAttachments(task.attachments || []);
    renderDrawerComments(task.comments || []);
    renderDrawerActivities(task.activities || []);
  } catch (err) {
    console.error('openTaskDrawer error:', err);
  }
}

function closeTaskDrawer() {
  const overlay = document.getElementById('taskDrawerOverlay');
  const drawer = document.getElementById('taskDrawer');
  overlay.classList.remove('active');
  drawer.classList.remove('active');
  _activeDrawerTaskId = null;
}

async function saveDrawerField(fieldName, value) {
  if (!_activeDrawerTaskId) return;
  try {
    const payload = {};
    payload[fieldName] = value;
    const r = await fetch(`/api/tasks/${_activeDrawerTaskId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (r.ok) {
      const updated = await r.json();
      const idx = _tasks.findIndex(t => t.id === updated.id);
      if (idx >= 0) _tasks[idx] = updated;
      if (_currentView === 'kanban') renderKanbanBoard();
      else renderListView();
    }
  } catch (err) {
    console.error('saveDrawerField error:', err);
  }
}

async function onDrawerColumnChange(colId) {
  if (!_activeDrawerTaskId) return;
  await saveDrawerField('columnId', colId);
  const board = _boards.find(b => b.id === _activeBoardId);
  const col = board?.columns?.find(c => c.id === Number(colId));
  const statusBadge = document.getElementById('drawerStatusBadge');
  if (statusBadge && col) {
    statusBadge.textContent = col.name;
    statusBadge.style.background = col.color || 'var(--accent)';
  }
}

