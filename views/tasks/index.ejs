<!-- ══════════════════════════════════════════════════════════════════════════
     8. JAVASCRIPT LOGIC & KANBAN ENGINE
     ══════════════════════════════════════════════════════════════════════════ -->
<script>
// ── State Management ─────────────────────────────────────────────────────────
let _boards = [];
let _activeBoardId = null;
let _tasks = [];
let _users = [];
let _clients = [];
let _currentFilter = 'all';
let _searchDebounceTimer = null;
let _activeDrawerTaskId = null;
let _currentView = 'kanban';
let _dragTaskId = null;

// Esc helper
function esc(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// ── Initialization ───────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  await Promise.all([
    loadUsersList(),
    loadClientsList(),
    loadBoardsList()
  ]);
  setupKeyboardShortcuts();
  setupWebSocketUpdates();
});

// ── Keyboard Shortcuts (N, F, /, Esc) ────────────────────────────────────────
function setupKeyboardShortcuts() {
  document.addEventListener('keydown', (e) => {
    // Ignore if typing inside input or textarea
    const tag = e.target.tagName.toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') {
      if (e.key === 'Escape') {
        closeTaskDrawer();
        closeCreateTaskModal();
      }
      return;
    }

    if (e.key === 'n' || e.key === 'N') {
      e.preventDefault();
      openCreateTaskModal();
    } else if (e.key === '/') {
      e.preventDefault();
      document.getElementById('taskSearchInput')?.focus();
    } else if (e.key === 'Escape') {
      closeTaskDrawer();
      closeCreateTaskModal();
    }
  });
}

// ── WebSocket Real-Time Listener ─────────────────────────────────────────────
function setupWebSocketUpdates() {
  try {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${window.location.host}`);
    ws.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        if (data.type && data.type.startsWith('task_')) {
          loadTasks(false); // Reload silently in background
        }
      } catch (_) {}
    };
  } catch (_) {}
}

// ── Load Auxiliary Data ──────────────────────────────────────────────────────
async function loadUsersList() {
  try {
    const r = await fetch('/api/settings/users');
    if (r.ok) {
      _users = await r.json();
      populateUserSelectors();
    }
  } catch (_) {}
}

async function loadClientsList() {
  try {
    const r = await fetch('/api/clients');
    if (r.ok) {
      const data = await r.json();
      _clients = Array.isArray(data) ? data : (data.clients || []);
      populateClientSelectors();
    }
  } catch (_) {}
}

function populateUserSelectors() {
  const options = '<option value="">Mas\'ul tanlanmagan</option>' +
    _users.map(u => `<option value="${u.id}">${esc(u.fullName || u.email)} (${u.role})</option>`).join('');

  const filterSel = document.getElementById('filterAssigneeSelect');
  if (filterSel) filterSel.innerHTML = '<option value="">Barcha mas\'ullar</option>' + _users.map(u => `<option value="${u.id}">${esc(u.fullName || u.email)}</option>`).join('');

  const modalSel = document.getElementById('modalTaskAssignee');
  if (modalSel) modalSel.innerHTML = options;

  const drawerSel = document.getElementById('drawerAssigneeSelect');
  if (drawerSel) drawerSel.innerHTML = options;
}

function populateClientSelectors() {
  const options = '<option value="">Mijoz biriktirilmagan</option>' +
    _clients.map(c => `<option value="${c.id}">${esc(c.name)} ${c.phone ? '(' + esc(c.phone) + ')' : ''}</option>`).join('');

  const modalSel = document.getElementById('modalTaskClient');
  if (modalSel) modalSel.innerHTML = options;

  const drawerSel = document.getElementById('drawerClientSelect');
  if (drawerSel) drawerSel.innerHTML = options;
}

// ── Board Management ─────────────────────────────────────────────────────────
async function loadBoardsList() {
  try {
    const r = await fetch('/api/tasks/boards');
    if (!r.ok) throw new Error('Boardlarni yuklab bo\'lmadi');
    _boards = await r.json();

    if (_boards.length > 0) {
      if (!_activeBoardId || !_boards.find(b => b.id === _activeBoardId)) {
        _activeBoardId = _boards[0].id;
      }
      renderBoardDropdown();
      updateActiveBoardDisplay();
      await loadTasks();
    }
  } catch (err) {
    console.error('loadBoardsList error:', err);
  }
}

function renderBoardDropdown() {
  const listEl = document.getElementById('boardDropdownList');
  if (!listEl) return;
  listEl.innerHTML = _boards.map(b => `
    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 10px; border-radius:8px; cursor:pointer; background:${b.id === _activeBoardId ? 'rgba(0,122,255,0.1)' : 'transparent'}; color:${b.id === _activeBoardId ? 'var(--accent)' : 'var(--text-primary)'}; font-weight:700; font-size:13px;" onclick="selectBoard(${b.id})">
      <div style="display:flex; align-items:center; gap:8px;">
        <i class="fas ${b.icon || 'fa-clipboard-list'}" style="color:${b.color || '#007AFF'};"></i>
        <span>${esc(b.name)}</span>
      </div>
      <span class="badge" style="font-size:10px;">${b._count?.tasks || 0}</span>
    </div>
  `).join('');
}

function updateActiveBoardDisplay() {
  const activeBoard = _boards.find(b => b.id === _activeBoardId);
  if (!activeBoard) return;
  document.getElementById('activeBoardName').textContent = activeBoard.name;
  const iconEl = document.getElementById('activeBoardIcon');
  if (iconEl) {
    iconEl.className = `fas ${activeBoard.icon || 'fa-clipboard-list'}`;
    iconEl.style.color = activeBoard.color || '#007AFF';
  }
  populateColumnSelectors(activeBoard.columns || []);
}

function populateColumnSelectors(columns) {
  const options = columns.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
  const modalCol = document.getElementById('modalTaskColumn');
  if (modalCol) modalCol.innerHTML = options;
  const drawerCol = document.getElementById('drawerColumnSelect');
  if (drawerCol) drawerCol.innerHTML = options;
}

function toggleBoardDropdown() {
  const menu = document.getElementById('boardDropdownMenu');
  if (menu) menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', (e) => {
  if (!e.target.closest('#activeBoardBtn') && !e.target.closest('#boardDropdownMenu')) {
    const menu = document.getElementById('boardDropdownMenu');
    if (menu) menu.style.display = 'none';
  }
});

function selectBoard(id) {
  _activeBoardId = id;
  toggleBoardDropdown();
  updateActiveBoardDisplay();
  loadTasks();
}

// ── Tasks Loading & Rendering ────────────────────────────────────────────────
async function loadTasks(showLoading = true) {
  if (!_activeBoardId) return;
  if (showLoading) {
    if (_currentView === 'kanban') {
      document.getElementById('kanbanBoardView').innerHTML = '<div style="padding:40px;text-align:center;width:100%"><div class="spinner"></div></div>';
    } else {
      document.getElementById('taskListTableBody').innerHTML = '<tr><td colspan="8" class="tc" style="padding:30px;"><div class="spinner"></div></td></tr>';
    }
  }

  try {
    let url = `/api/tasks?boardId=${_activeBoardId}`;

    if (_currentFilter === 'mine') url += '&mine=true';
    else if (_currentFilter === 'today') url += '&today=true';
    else if (_currentFilter === 'overdue') url += '&overdue=true';
    else if (_currentFilter === 'urgent') url += '&priority=urgent';
    else if (_currentFilter === 'done') url += '&completed=true';

    const assigneeVal = document.getElementById('filterAssigneeSelect')?.value;
    if (assigneeVal) url += `&assignedToId=${assigneeVal}`;

    const searchVal = document.getElementById('taskSearchInput')?.value?.trim();
    if (searchVal) url += `&search=${encodeURIComponent(searchVal)}`;

    const r = await fetch(url);
    if (!r.ok) throw new Error('Vazifalarni yuklab bo\'lmadi');
    _tasks = await r.json();

    if (_currentView === 'kanban') {
      renderKanbanBoard();
    } else {
      renderListView();
    }
  } catch (err) {
    console.error('loadTasks error:', err);
  }
}

// ── Kanban Board Rendering ───────────────────────────────────────────────────
function renderKanbanBoard() {
  const board = _boards.find(b => b.id === _activeBoardId);
  const container = document.getElementById('kanbanBoardView');
  if (!container) return;

  if (!board || !board.columns || board.columns.length === 0) {
    container.innerHTML = `
      <div style="padding: 60px; text-align: center; width: 100%; color: var(--text-tertiary);">
        <i class="fas fa-columns" style="font-size: 36px; opacity: 0.3; margin-bottom: 12px;"></i>
        <div style="font-size: 15px; font-weight: 700;">Ushbu boardda hali ustunlar yo'q</div>
        <button class="btn btn-primary btn-sm" onclick="openCreateColumnModal()" style="margin-top: 12px;">
          <i class="fas fa-plus"></i> Birinchi ustunni qo'shish
        </button>
      </div>
    `;
    return;
  }

  let html = '';
  for (const col of board.columns) {
    const colTasks = _tasks.filter(t => t.columnId === col.id);
    colTasks.sort((a, b) => (a.order || 0) - (b.order || 0));

    html += `
      <div class="kanban-column" data-col-id="${col.id}">
        <!-- Column Header -->
        <div class="kanban-column-header">
          <div class="kanban-column-title">
            <span class="col-dot" style="background: ${col.color || '#007AFF'};"></span>
            <span>${esc(col.name)}</span>
            <span class="col-badge">${colTasks.length}</span>
          </div>
          <div style="display: flex; align-items: center; gap: 4px;">
            <button class="btn btn-ghost btn-sm" style="padding: 2px 6px; font-size: 11px;" onclick="openEditColumnModal(${col.id}, '${esc(col.name)}', '${col.color || '#007AFF'}')" title="Ustunni tahrirlash">
              <i class="fas fa-ellipsis-h"></i>
            </button>
          </div>
        </div>

        <!-- Cards Container (Drag Drop Zone) -->
        <div class="kanban-cards-list"
          data-col-id="${col.id}"
          ondragover="onCardDragOver(event)"
          ondragleave="onCardDragLeave(event)"
          ondrop="onCardDrop(event, ${col.id})">
          ${colTasks.map(t => renderTaskCard(t)).join('')}
        </div>

        <!-- Quick Task Creator -->
        <div class="quick-add-card-wrap">
          <button class="quick-add-btn" id="quickAddBtn_${col.id}" onclick="showQuickAddForm(${col.id})">
            <i class="fas fa-plus"></i> Vazifa qo'shish
          </button>
          <div class="quick-add-form" id="quickAddForm_${col.id}">
            <input type="text" class="quick-add-input" id="quickAddInput_${col.id}" placeholder="Vazifa nomi... (Enter)" onkeydown="handleQuickAddKeyDown(event, ${col.id})">
            <div class="quick-add-actions">
              <button class="btn btn-ghost btn-sm" onclick="hideQuickAddForm(${col.id})">Bekor</button>
              <button class="btn btn-primary btn-sm" onclick="submitQuickAdd(${col.id})">Qo'shish</button>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  // "+ Ustun qo'shish" button at end
  html += `
    <div class="add-column-btn" onclick="openCreateColumnModal()">
      <i class="fas fa-plus"></i> Yangi ustun qo'shish
    </div>
  `;

  container.innerHTML = html;
}

// ── Single Task Card Rendering ───────────────────────────────────────────────
function renderTaskCard(t) {
  const priorityClass = `priority-badge-${t.priority || 'medium'}`;
  const priorityLabels = { low: 'Past', medium: 'O\'rta', high: 'Yuqori', urgent: 'Shoshilinch' };

  // Checklist indicator
  let checklistHtml = '';
  if (t.checklistProgress && t.checklistProgress.total > 0) {
    const pct = Math.round((t.checklistProgress.completed / t.checklistProgress.total) * 100);
    checklistHtml = `
      <div class="task-card-checklist-bar">
        <div class="task-card-checklist-fill" style="width: ${pct}%;"></div>
      </div>
    `;
  }

  // Client badge
  let clientHtml = '';
  if (t.client && t.client.name) {
    clientHtml = `
      <div class="task-card-client" title="${esc(t.client.name)} ${esc(t.client.phone || '')}">
        <i class="fas fa-user-circle"></i>
        <span>${esc(t.client.name)}</span>
      </div>
    `;
  }

  // Due date badge
  let dueHtml = '';
  if (t.dueDate) {
    const d = new Date(t.dueDate);
    const dateStr = d.toLocaleDateString('uz-UZ', { month: 'short', day: 'numeric' });
    dueHtml = `
      <span class="task-due-badge ${t.isOverdue ? 'overdue' : ''}" title="${t.isOverdue ? 'Muddati o\'tgan!' : 'Tugash vaqti'}">
        <i class="far fa-clock"></i> ${dateStr} ${t.dueTime || ''}
      </span>
    `;
  }

  // Assignee avatar
  let userHtml = '';
  if (t.assignedTo) {
    const initials = (t.assignedTo.fullName || t.assignedTo.email || '?').split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase();
    userHtml = `<span class="task-user-avatar" title="${esc(t.assignedTo.fullName || t.assignedTo.email)}">${initials}</span>`;
  }

  // Labels
  let tagsHtml = '';
  if (t.parsedLabels && t.parsedLabels.length > 0) {
    tagsHtml = t.parsedLabels.map(l => `<span class="task-tag" style="background:rgba(0,122,255,0.12); color:var(--accent);">${esc(l)}</span>`).join('');
  }

  return `
    <div class="task-card ${t.completed ? 'completed' : ''}"
      id="taskCard_${t.id}"
      data-task-id="${t.id}"
      draggable="true"
      ondragstart="onCardDragStart(event, ${t.id})"
      ondragend="onCardDragEnd(event)"
      onclick="openTaskDrawer(${t.id})">

      <!-- Header: Tags + Priority -->
      <div class="task-card-header">
        <div class="task-card-tags">
          <span class="task-tag ${priorityClass}">${priorityLabels[t.priority || 'medium']}</span>
          ${tagsHtml}
        </div>
      </div>

      <!-- Title -->
      <div class="task-card-title">${esc(t.title)}</div>

      <!-- Client badge -->
      ${clientHtml}

      <!-- Checklist Bar -->
      ${checklistHtml}

      <!-- Meta Footer -->
      <div class="task-card-meta">
        <div class="task-meta-left">
          ${dueHtml}
          ${t.checklistProgress?.total ? `<span style="font-size:10.5px; font-weight:700; color:var(--text-tertiary);"><i class="fas fa-check-square"></i> ${t.checklistProgress.completed}/${t.checklistProgress.total}</span>` : ''}
          ${t.commentsCount ? `<span style="font-size:10.5px; font-weight:700; color:var(--text-tertiary);"><i class="fas fa-comment"></i> ${t.commentsCount}</span>` : ''}
          ${t.attachmentsCount ? `<span style="font-size:10.5px; font-weight:700; color:var(--text-tertiary);"><i class="fas fa-paperclip"></i> ${t.attachmentsCount}</span>` : ''}
        </div>
        <div>${userHtml}</div>
      </div>
    </div>
  `;
}

