<%- include('../layouts/header', {
  title: 'Ombor — DESCO CRM',
  activePage: 'warehouse',
  user: user
}) %>

<style>
  .wh-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  /* Stats Cards Grid */
  .wh-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }

  .wh-stat-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    transition: all 0.2s ease;
  }
  .wh-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(0,0,0,0.06);
    border-color: var(--accent);
  }

  .wh-stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  /* Tabs & Controls */
  .wh-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .wh-pill-tab {
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 700;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .wh-pill-tab.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(99,102,241,0.25);
  }

  .wh-filter-btn {
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid var(--border);
    background: var(--bg-primary);
    color: var(--text-secondary);
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .wh-filter-btn.active {
    background: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
  }

  /* Table styling */
  .wh-table-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .wh-table {
    width: 100%;
    border-collapse: collapse;
  }

  .wh-table th {
    background: var(--bg-secondary);
    padding: 14px 18px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border-bottom: 1px solid var(--border);
  }

  .stock-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    height: 30px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 800;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .stock-ok {
    background: rgba(16, 185, 129, 0.12) !important;
    color: #10B981 !important;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }
  .stock-ok:hover {
    background: rgba(16, 185, 129, 0.25) !important;
    transform: scale(1.08);
  }
  
  .stock-low {
    background: rgba(245, 158, 11, 0.12) !important;
    color: #D97706 !important;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }
  .stock-low:hover {
    background: rgba(245, 158, 11, 0.25) !important;
    transform: scale(1.08);
  }
  
  .stock-zero {
    background: rgba(239, 68, 68, 0.1) !important;
    color: #EF4444 !important;
    border: 1px solid rgba(239, 68, 68, 0.18);
  }
  .stock-zero:hover {
    background: rgba(239, 68, 68, 0.2) !important;
    transform: scale(1.08);
  }
  
  .stock-total {
    background: rgba(99, 102, 241, 0.12) !important;
    color: #6366F1 !important;
    border: 1px solid rgba(99, 102, 241, 0.22);
    font-weight: 800;
  }

  .main-product-row {
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .main-product-row:hover {
    background-color: var(--bg-secondary) !important;
  }
  
  .variant-row {
    background-color: rgba(0,0,0,0.015);
    transition: background-color 0.15s ease;
  }
  .variant-row:hover {
    background-color: var(--bg-secondary) !important;
  }

  .variant-color-text {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 6px;
    transition: background-color 0.15s ease;
  }
  .variant-color-text:hover {
    background-color: var(--border);
  }
  .variant-color-text .edit-color-icon {
    font-size: 10px;
    opacity: 0;
    margin-left: 6px;
    transition: opacity 0.15s ease, color 0.15s ease;
    color: var(--text-secondary);
  }
  .variant-color-text:hover .edit-color-icon {
    opacity: 0.8;
  }

  .color-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(0,0,0,0.1);
  }

  .step-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }
  .step-btn:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* Modal Backdrop blur */
  .modal-overlay {
    backdrop-filter: blur(8px);
    background: rgba(0,0,0,0.4);
  }
  .modal-box {
    border-radius: 18px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }
</style>

<main class="main-content">

  <!-- Header -->
  <div class="wh-header">
    <div>
      <h1 style="font-size:22px; font-weight:800; margin:0; display:flex; align-items:center; gap:10px;">
        <i class="fas fa-warehouse" style="color:var(--accent)"></i> Ombor Boshqaruvi
      </h1>
      <p style="font-size:13px; color:var(--text-tertiary); margin:4px 0 0">Filiallar va mahsulotlar kesimida zaxiralarni tezkor va aqliy boshqarish</p>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <button class="btn btn-primary" onclick="openFillModal()" style="border-radius:10px; font-weight:700; box-shadow:0 4px 12px rgba(99,102,241,0.3);">
        <i class="fas fa-plus"></i> Zaxira To'ldirish
      </button>
      <button class="btn btn-secondary" onclick="openTransferModal()" style="border-radius:10px; font-weight:600;">
        <i class="fas fa-exchange-alt"></i> Ko'chirish
      </button>
      <button class="btn btn-ghost" onclick="openProductModal()" style="border-radius:10px; font-weight:600;">
        <i class="fas fa-tags"></i> Katalog
      </button>
    </div>
  </div>

  <!-- Stats Cards Grid -->
  <div class="wh-stats-grid" id="statsCards">
    <!-- Dynamic Stats Cards -->
  </div>

  <!-- Controls Bar: Tabs, Filters & Search -->
  <div class="wh-controls-bar">
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <button class="wh-pill-tab active" onclick="switchTab('inventory', this)">
        <i class="fas fa-boxes"></i> Zaxira Holati
      </button>
      <button class="wh-pill-tab" onclick="switchTab('logs', this)">
        <i class="fas fa-history"></i> Harakatlar Tarixi
      </button>
    </div>

    <!-- Filter Pills for Inventory -->
    <div id="inventoryFilterGroup" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
      <button class="wh-filter-btn active" onclick="setStockFilter('all', this)">Barchasi</button>
      <button class="wh-filter-btn" onclick="setStockFilter('low', this)"><i class="fas fa-exclamation-triangle" style="color:#d97706"></i> Kam qolganlar (≤2)</button>
      <button class="wh-filter-btn" onclick="setStockFilter('zero', this)"><i class="fas fa-times-circle" style="color:#ef4444"></i> Tugaganlar (0)</button>
    </div>

    <input type="text" id="whSearch" class="form-control" style="width:240px; border-radius:20px; padding-left:14px; font-size:13px;" placeholder="🔍 Mahsulot yoki rang nomini qidirish..." oninput="filterInventoryList()">
  </div>

  <!-- Inventory Table Card -->
  <div id="tab-inventory">
    <div class="wh-table-card">
      <table class="wh-table">
        <thead>
          <tr>
            <th style="text-align:left;">Mahsulot va Ranglar</th>
            <th style="text-align:center;">Toshkent</th>
            <th style="text-align:center;">Qo'qon</th>
            <th style="text-align:center;">Jami Zaxira</th>
            <th style="text-align:right;">Tezkor Harakat</th>
          </tr>
        </thead>
        <tbody id="inventoryBody">
          <tr><td colspan="5" style="text-align:center; padding:40px; color:var(--text-tertiary)"><div class="spinner"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Logs Table Card -->
  <div id="tab-logs" style="display:none">
    <div class="wh-table-card">
      <table class="wh-table">
        <thead>
          <tr>
            <th style="text-align:left;">Sana va Vaqt</th>
            <th style="text-align:left;">Mahsulot va Rang</th>
            <th style="text-align:center;">Ombor</th>
            <th style="text-align:center;">Miqdor</th>
            <th style="text-align:center;">Harakat</th>
            <th style="text-align:left;">Izoh / Mas'ul</th>
          </tr>
        </thead>
        <tbody id="logsBody">
          <tr><td colspan="6" style="text-align:center; padding:40px; color:var(--text-tertiary)"><div class="spinner"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

</main>

<!-- AQLIY QUICK STOCK EDITOR MODAL -->
<div class="modal-overlay hidden" id="quickStockModal">
  <div class="modal-box" style="max-width:440px">
    <div class="modal-header">
      <h2><i class="fas fa-edit" style="color:var(--accent); margin-right:8px"></i> Zaxirani Tahrirlash</h2>
      <button class="modal-close" onclick="closeQuickStockModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div style="background:var(--bg-secondary); border:1px solid var(--border); border-radius:12px; padding:12px; margin-bottom:16px; text-align:center;">
        <div id="qs-product-title" style="font-size:15px; font-weight:800; color:var(--text-primary);">Mahsulot Nomi</div>
        <div style="font-size:12px; color:var(--text-secondary); margin-top:4px; display:flex; align-items:center; justify-content:center; gap:8px;">
          <span id="qs-color-badge" class="color-dot"></span>
          <span id="qs-color-name">Rang</span> | 
          <span id="qs-warehouse-name" style="font-weight:700; color:var(--accent);">Ombor</span>
        </div>
      </div>

      <!-- Quick Stepper Controls -->
      <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:18px;">
        <button class="step-btn" onclick="stepQuickStock(-10)">-10</button>
        <button class="step-btn" onclick="stepQuickStock(-1)">-1</button>
        <input type="number" id="qs-stock-input" class="form-control" style="width:100px; height:44px; text-align:center; font-size:20px; font-weight:800; color:var(--accent); border-radius:12px;" min="0">
        <button class="step-btn" onclick="stepQuickStock(1)">+1</button>
        <button class="step-btn" onclick="stepQuickStock(10)">+10</button>
      </div>

      <div class="form-group">
        <label class="form-label">Tahrirlash Izohi / Sababi</label>
        <input type="text" id="qs-notes-input" class="form-control" style="font-size:12.5px;" placeholder="Masalan: Inventarizatsiya yoki zavoddan keldi...">
      </div>

      <div style="display:flex; justify-content:space-between; gap:10px; margin-top:20px;">
        <button class="btn btn-ghost" onclick="closeQuickStockModal()">Bekor qilish</button>
        <button class="btn btn-primary" onclick="submitQuickStockEdit()" id="btnSaveQuickStock" style="font-weight:700;">
          <i class="fas fa-save"></i> Zaxirani Saqlash
        </button>
      </div>
    </div>
  </div>
</div>

<!-- QUICK ADD VARIANT MODAL -->
