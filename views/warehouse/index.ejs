      </div>
      <div class="form-group">
        <label class="form-label">Yangi Rang / Variant Nomi <span style="color:var(--danger)">*</span></label>
        <input type="text" id="av-color-name" class="form-control" placeholder="Masalan: Qora, Tillo, Qizil, Brak...">
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <div class="form-group">
