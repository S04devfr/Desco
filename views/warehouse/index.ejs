        <input type="text" id="tr-product" class="form-control" placeholder="Mahsulot nomi">
      </div>
      <div class="form-group">
        <label class="form-label">Rang / Variant</label>
        <input type="text" id="tr-color" class="form-control" placeholder="Masalan: Qora (ixtiyoriy)">
      </div>
      <div class="form-group">
        <label class="form-label">Miqdor (dona) <span style="color:var(--danger)">*</span></label>
        <input type="number" id="tr-qty" class="form-control" min="1" placeholder="Masalan: 5">
      </div>
      <div class="form-group">
        <label class="form-label">Izoh</label>
        <input type="text" id="tr-notes" class="form-control" placeholder="Masalan: Kuryer orqali yuborildi">
      </div>
      <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
        <button class="btn btn-ghost" onclick="closeTransferModal()">Bekor qilish</button>
