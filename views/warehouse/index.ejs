      <div style="display:flex; justify-content:space-between; gap:10px; margin-top:20px;">
        <button class="btn btn-ghost" onclick="closeAddVariantModal()">Bekor qilish</button>
        <button class="btn btn-primary" onclick="submitAddVariant()" id="btnSaveAddVariant" style="font-weight:700;">
