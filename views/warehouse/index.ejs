<%- include('../layouts/header', {
  title: 'Ombor — DESCO CRM',
  activePage: 'warehouse',
  user: user
}) %>

<main class="main-content">
  <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:22px;font-weight:700;margin:0;display:flex;align-items:center;gap:10px">
        <i class="fas fa-warehouse" style="color:var(--accent)"></i> Ombor boshqaruvi
      </h1>
      <p style="font-size:13px;color:var(--text-tertiary);margin:4px 0 0">Toshkent va Qo'qon omborlaridagi zaxira holati</p>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary" onclick="openFillModal()">
        <i class="fas fa-plus"></i> Zaxira qo'shish
      </button>
      <button class="btn btn-secondary" onclick="openProductModal()">
        <i class="fas fa-tags"></i> Mahsulot turlari
      </button>
    </div>
  </div>

  <!-- Umumiy statistika -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px" id="statsCards">
  </div>

  <!-- Tabs -->
  <div style="display:flex;gap:4px;margin-bottom:16px;border-bottom:1px solid var(--border);padding-bottom:0">
    <button class="tab-btn active" onclick="switchTab('inventory', this)" style="padding:8px 16px;font-size:13px;font-weight:600;border:none;background:none;color:var(--text-secondary);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px">
      <i class="fas fa-boxes"></i> Zaxira
    </button>
    <button class="tab-btn" onclick="switchTab('logs', this)" style="padding:8px 16px;font-size:13px;font-weight:600;border:none;background:none;color:var(--text-secondary);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px">
      <i class="fas fa-history"></i> Tarix
    </button>
  </div>

  <!-- Inventory Table -->
  <div id="tab-inventory">
    <div class="card" style="overflow:hidden">
      <table class="data-table" style="width:100%;border-collapse:collapse">
        <thead>
          <tr>
            <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Mahsulot</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Toshkent</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Qo'qon</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Jami</th>
          </tr>
        </thead>
        <tbody id="inventoryBody">
          <tr><td colspan="4" style="text-align:center;padding:40px;color:var(--text-tertiary)"><div class="spinner"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Logs Table -->
  <div id="tab-logs" style="display:none">
    <div class="card" style="overflow:hidden">
      <table class="data-table" style="width:100%;border-collapse:collapse">
        <thead>
          <tr>
            <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Sana</th>
            <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Mahsulot</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Ombor</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Miqdor</th>
            <th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Harakat</th>
            <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Izoh</th>
          </tr>
        </thead>
        <tbody id="logsBody">
          <tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-tertiary)"><div class="spinner"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- FILL MODAL -->
<div class="modal-overlay hidden" id="fillModal">
  <div class="modal-box" style="max-width:440px">
    <div class="modal-header">
      <h2><i class="fas fa-plus-circle" style="color:var(--success);margin-right:8px"></i>Zaxira qo'shish</h2>
      <button class="modal-close" onclick="closeFillModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Ombor <span style="color:var(--danger)">*</span></label>
        <select id="fill-warehouse" class="form-control">
          <option value="">— Tanlang —</option>
          <option value="Toshkent">Toshkent</option>
          <option value="Qo'qon">Qo'qon</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Mahsulot turi *</label>
        <select id="fill-product" class="form-control">
          <option value="">— Tanlang —</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Mahsulot rangi *</label>
        <select id="fill-color" class="form-control">
          <option value="oddiy">Oddiy</option>
          <option value="Brak (Buzilgan)">Brak (Buzilgan)</option>
          <option value="Kulrang">Kulrang (Grey)</option>
          <option value="Tillo">Tillo (Gold)</option>
          <option value="Qora">Qora (Black)</option>
          <option value="Qizil">Qizil (Red)</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Miqdor <span style="color:var(--danger)">*</span></label>
        <input type="number" id="fill-qty" class="form-control" placeholder="0" min="1">
      </div>
      <div class="form-group">
        <label class="form-label">Izoh</label>
        <input type="text" id="fill-notes" class="form-control" placeholder="Ixtiyoriy izoh...">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeFillModal()">Bekor</button>
      <button class="btn btn-primary" id="fillSaveBtn" onclick="saveFill()">
        <i class="fas fa-save"></i> Saqlash
      </button>
    </div>
  </div>
</div>

<!-- PRODUCT TYPE MODAL -->
<div class="modal-overlay hidden" id="productModal">
  <div class="modal-box" style="max-width:520px">
    <div class="modal-header">
      <h2><i class="fas fa-tags" style="color:var(--accent);margin-right:8px"></i>Mahsulot turlari</h2>
      <button class="modal-close" onclick="closeProductModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:8px;margin-bottom:16px">
        <input type="text" id="newProductName" class="form-control" placeholder="Yangi mahsulot nomi..." style="flex:1">
        <button class="btn btn-primary" onclick="addProduct()" style="white-space:nowrap">
          <i class="fas fa-plus"></i> Qo'shish
        </button>
      </div>
      <div id="productList" style="max-height:350px;overflow-y:auto">
        <div style="text-align:center;padding:20px;color:var(--text-tertiary)"><div class="spinner"></div></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeProductModal()">Yopish</button>
    </div>
  </div>
</div>

<style>
  .tab-btn.active {
    color: var(--accent) !important;
    border-bottom-color: var(--accent) !important;
  }
  .stock-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 40px; height: 26px; padding: 0 8px; border-radius: 6px;
    font-size: 13px; font-weight: 700; transition: all 150ms ease;
  }
  .stock-ok { background: rgba(16, 185, 129, 0.1) !important; color: #10B981 !important; border: 1px solid rgba(16, 185, 129, 0.18); }
  .stock-ok:hover { background: rgba(16, 185, 129, 0.16) !important; transform: translateY(-1px); }
  
  .stock-low { background: rgba(245, 158, 11, 0.1) !important; color: #D97706 !important; border: 1px solid rgba(245, 158, 11, 0.18); }
  .stock-low:hover { background: rgba(245, 158, 11, 0.16) !important; transform: translateY(-1px); }
  
  .stock-zero { background: rgba(239, 68, 68, 0.08) !important; color: #EF4444 !important; border: 1px solid rgba(239, 68, 68, 0.12); }
  .stock-zero:hover { background: rgba(239, 68, 68, 0.14) !important; transform: translateY(-1px); }
  
  .stock-total {
    background: rgba(99, 102, 241, 0.1) !important;
    color: #6366F1 !important;
    border: 1px solid rgba(99, 102, 241, 0.18);
    font-weight: 800;
  }
  .stock-total:hover { background: rgba(99, 102, 241, 0.16) !important; transform: translateY(-1px); }

  .action-fill { background: rgba(16, 185, 129, 0.1); color: #10B981; }
  .action-ship { background: rgba(239, 68, 68, 0.08); color: #EF4444; }
  .action-transfer { background: rgba(99, 102, 241, 0.1); color: #6366F1; }
  .action-return { background: rgba(245, 158, 11, 0.1); color: #D97706; }

  .stat-card {
    background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 20px; display: flex; flex-direction: column; gap: 4px;
    box-shadow: var(--shadow-sm);
  }
  .stat-card .stat-label { font-size: 11px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
  .stat-card .stat-value { font-size: 24px; font-weight: 800; }
  
  .product-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .product-item:hover { background: var(--bg-secondary); }
  .product-item:last-child { border-bottom: none; }
  
  .main-product-row {
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .main-product-row:hover {
    background-color: var(--bg-surface-hover) !important;
  }
  
  .variant-row {
    transition: background-color 0.15s ease;
  }
  .variant-row:hover {
    background-color: var(--bg-surface-hover) !important;
  }

  .variant-color-text {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background-color 0.15s ease;
  }
  .variant-color-text:hover {
    background-color: var(--border-subtle);
  }
  .variant-color-text .edit-color-icon {
    font-size: 10px;
    opacity: 0;
    margin-left: 6px;
    transition: opacity 0.15s ease, color 0.15s ease;
    color: var(--text-secondary);
  }
  .variant-color-text:hover .edit-color-icon {
    opacity: 0.7;
  }
  .variant-color-text:hover .edit-color-icon:hover {
    opacity: 1;
    color: var(--primary);
  }
  .color-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 2px var(--border-subtle);
  }
</style>

<script>
  let _inventoryData = [];
  let _logsData = [];
  let _productCatalog = [];

  async function apiFetch(url, opts) {
    const r = await fetch(url, opts);
    if (!r.ok) {
      let msg = 'Xatolik';
      try { const j = await r.json(); msg = j.message || msg; } catch(e) { msg = await r.text(); }
      throw new Error(msg);
    }
    return r.json();
  }

  function _toast(msg, type) {
    if (typeof showToast === 'function') { showToast(msg, type); return; }
    const c = document.getElementById('toastContainer');
    if (!c) return;
    const t = document.createElement('div');
    t.className = 'toast toast-' + (type || 'info');
    t.innerHTML = '<span>' + msg + '</span>';
    t.style.cssText = 'margin-top:8px;padding:10px 16px;border-radius:8px;font-size:13px;color:#fff;background:' +
      (type === 'error' ? '#FF3B30' : type === 'success' ? '#34C759' : '#007AFF');
    c.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  function _esc(s) { return s == null ? '' : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function _dateTime(d) {
    if (!d) return '';
    const dt = new Date(d);
    if (isNaN(dt)) return '';
    return dt.toLocaleDateString('uz-UZ', { day:'2-digit', month:'2-digit', year:'2-digit' }) +
      ' ' + dt.toLocaleTimeString('uz-UZ', { hour:'2-digit', minute:'2-digit' });
  }

  function stockBadge(val, pName, color, warehouse, isEditable) {
    const cls = val <= 0 ? 'stock-zero' : val <= 5 ? 'stock-low' : 'stock-ok';
    if (isEditable) {
      return '<span class="stock-badge ' + cls + '" style="cursor:pointer" onclick="initiateStockEdit(event, this)" ' +
        'data-product="' + _esc(pName) + '" ' +
        'data-color="' + _esc(color) + '" ' +
        'data-warehouse="' + _esc(warehouse) + '" ' +
        'data-stock="' + val + '">' + val + '</span>';
    }
    return '<span class="stock-badge ' + cls + '">' + val + '</span>';
  }

  function initiateStockEdit(event, badgeEl) {
    event.stopPropagation();
    const p = badgeEl.dataset.product;
    const c = badgeEl.dataset.color;
    const w = badgeEl.dataset.warehouse;
    const s = parseInt(badgeEl.dataset.stock) || 0;

    const td = badgeEl.parentNode;
    const input = document.createElement('input');
    input.type = 'number';
    input.value = s;
    input.style.width = '60px';
    input.style.padding = '4px 6px';
    input.style.fontSize = '12.5px';
    input.style.fontWeight = '700';
    input.style.textAlign = 'center';
    input.style.border = '1px solid var(--accent)';
    input.style.borderRadius = '6px';
    input.style.background = 'var(--surface-base)';
    input.style.color = 'var(--text-primary)';
    input.min = '0';
    
    input.dataset.product = p;
    input.dataset.color = c;
    input.dataset.warehouse = w;
    input.dataset.oldStock = s;

    td.innerHTML = '';
    td.appendChild(input);
    input.focus();
    input.select();

    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('blur', () => finishStockEdit(input));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        input.blur();
      } else if (e.key === 'Escape') {
        cancelStockEdit(input);
      }
    });
  }

  async function finishStockEdit(input) {
    const p = input.dataset.product;
    const c = input.dataset.color;
    const w = input.dataset.warehouse;
    const oldStock = parseInt(input.dataset.oldStock);
    const newStock = parseInt(input.value);

    if (isNaN(newStock) || newStock < 0 || newStock === oldStock) {
      cancelStockEdit(input);
      return;
    }

    try {
      await apiFetch('/api/warehouse/update-stock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName: p, color: c, warehouse: w, stock: newStock })
      });
      _toast("Zaxira yangilandi", 'success');
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
      cancelStockEdit(input);
    }
  }

  function cancelStockEdit(input) {
    const td = input.parentNode;
    const oldStock = parseInt(input.dataset.oldStock);
    const p = input.dataset.product;
    const c = input.dataset.color;
    const w = input.dataset.warehouse;
    
    td.innerHTML = stockBadge(oldStock, p, c, w, true);
  }

  function initiateColorRename(event, spanEl, productName, oldColor) {
    event.stopPropagation();
    const parent = spanEl.parentNode;
    
    const input = document.createElement('input');
    input.type = 'text';
    input.value = oldColor;
    input.className = 'color-rename-input';
    
    input.dataset.product = productName;
    input.dataset.oldColor = oldColor;

    parent.replaceChild(input, spanEl);
    input.focus();
    input.select();

    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('blur', () => finishColorRename(input, spanEl));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        input.blur();
      } else if (e.key === 'Escape') {
        cancelColorRename(input, spanEl);
      }
    });
  }

  async function finishColorRename(input, originalSpan) {
    const parent = input.parentNode;
    if (!parent) return;
    
    const productName = input.dataset.product;
    const oldColor = input.dataset.oldColor;
    const newColor = input.value.trim();

    if (!newColor || newColor === oldColor) {
      cancelColorRename(input, originalSpan);
      return;
    }

    try {
      await apiFetch('/api/warehouse/rename-color', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName, oldColor, newColor })
      });
      _toast("Rang nomi yangilandi", 'success');
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
      cancelColorRename(input, originalSpan);
    }
  }

  function cancelColorRename(input, originalSpan) {
    const parent = input.parentNode;
    if (parent) {
      parent.replaceChild(originalSpan, input);
    }
  }

  async function deleteColorVariant(event, productName, color) {
    if (event) event.stopPropagation();
    if (!confirm('Haqiqatan ham "' + productName + '" mahsulotining "' + color + '" variantini o\'chirmoqchisiz? \n\nDiqqat: Ushbu rangdagi barcha ombor zaxiralari o\'chib ketadi!')) {
      return;
    }
    
    try {
      await apiFetch('/api/warehouse/delete-color', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName, color })
      });
      _toast("Variant muvaffaqiyatli o'chirildi", 'success');
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    }
  }

  function actionBadge(action) {
    const labels = { fill: "To'ldirish", ship: 'Chiqarish', transfer: "Ko'chirish", return: 'Qaytarish' };
    const cls = 'action-' + action;
    return '<span class="stock-badge ' + cls + '">' + (labels[action] || action) + '</span>';
  }

  function fmtPrice(n) {
    if (!n) return '';
    return Number(n).toLocaleString('uz-UZ') + " so'm";
  }

  // ── DATA LOADING ──
  let _warehouses = [];

  async function loadData() {
    try {
      const data = await apiFetch('/api/warehouse');
      _inventoryData = data.inventory || [];
      _logsData = data.logs || [];
      _warehouses = data.warehouses || [];
      renderTableHeader();
      renderInventory();
      renderLogs();
      renderStats();
    } catch(e) {
      _toast(e.message, 'error');
    }
  }

  async function loadProducts() {
    try {
      const data = await apiFetch('/api/product-catalog');
      _productCatalog = data || [];
      updateProductSelect();
      renderProductList();
    } catch(e) { _toast(e.message, 'error'); }
  }

  function updateProductSelect() {
    const sel = document.getElementById('fill-product');
    if (!sel) return;
    sel.innerHTML = '<option value="">— Tanlang —</option>' +
      _productCatalog.map(p => '<option value="' + _esc(p.name) + '">' + _esc(p.name) + (p.price ? ' (' + fmtPrice(p.price) + ')' : '') + '</option>').join('');
  }

  // ── STATS ──
  const STAT_COLORS = ['#34C759','#FF9500','#007AFF','#FF3B30','#5856D6'];
  function renderStats() {
    const wTotals = {};
    _warehouses.forEach(w => { wTotals[w] = 0; });
    let totalAll = 0;
    _inventoryData.forEach(item => {
      _warehouses.forEach(w => {
        const v = (item.warehouses && item.warehouses[w]) || 0;
        wTotals[w] = (wTotals[w] || 0) + v;
        totalAll += v;
      });
    });

    const warehouseCards = _warehouses.map((w, i) => `
      <div class="stat-card">
        <span class="stat-label">${_esc(w)}</span>
        <span class="stat-value" style="color:${STAT_COLORS[i % STAT_COLORS.length]}">${wTotals[w] || 0}</span>
      </div>`).join('');

    document.getElementById('statsCards').innerHTML = `
      <div class="stat-card">
        <span class="stat-label">Jami zaxira</span>
        <span class="stat-value" style="color:var(--accent)">${totalAll}</span>
      </div>
      ${warehouseCards}
      <div class="stat-card">
        <span class="stat-label">Mahsulot turlari</span>
        <span class="stat-value" style="color:var(--text-primary)">${_inventoryData.length}</span>
      </div>
    `;
  }

  // ── INVENTORY TABLE ──
  // ── TABLE HEADER — dinamik ──
  function renderTableHeader() {
    const thead = document.querySelector('#tab-inventory thead tr');
    if (!thead) return;
    const wCols = _warehouses.map(w =>
      '<th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">' + _esc(w) + '</th>'
    ).join('');
    thead.innerHTML = '<th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Mahsulot</th>' +
      wCols +
      '<th style="text-align:center;padding:12px 16px;font-size:12px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">Jami</th>';
  }

  function getColorHash(color) {
    const c = String(color || '').toLowerCase().trim();
    if (c.includes('brak') || c.includes('buzilgan')) return '#FF3B30';
    if (c === 'qizil') return '#FF3B30';
    if (c === 'ko\'k' || c === 'kok' || c === 'ko`k') return '#007AFF';
    if (c === 'yashil') return '#34C759';
    if (c === 'sariq') return '#FFCC00';
    if (c === 'qora') return '#1C1C1E';
    if (c === 'oq') return '#E5E5EA';
    if (c === 'kulrang') return '#8E8E93';
    if (c === 'tillo' || c === 'tilla') return '#D4AF37';
    if (c === 'pushti') return '#FF2D55';
    if (c === 'binafsha') return '#5856D6';
    
    // Hash fallback
    let hash = 0;
    for (let i = 0; i < c.length; i++) {
      hash = c.charCodeAt(i) + ((hash << 5) - hash);
    }
    const colors = ['#007AFF', '#34C759', '#FF9500', '#FF3B30', '#5856D6', '#AF52DE', '#FF2D55'];
    return colors[Math.abs(hash) % colors.length];
  }

  function toggleVariants(idx, rowEl) {
    const subRows = document.querySelectorAll('.variant-row-' + idx);
    const icon = rowEl.querySelector('.toggle-icon');
    let isOpening = false;

    subRows.forEach(r => {
      if (r.classList.contains('hidden')) {
        r.classList.remove('hidden');
        isOpening = true;
      } else {
        r.classList.add('hidden');
      }
    });

    if (icon) {
      if (isOpening) {
        icon.style.transform = 'rotate(90deg)';
      } else {
        icon.style.transform = 'rotate(0deg)';
      }
    }
  }

  function renderInventory() {
    const body = document.getElementById('inventoryBody');
    const colspan = _warehouses.length + 2;
    if (!_inventoryData.length) {
      body.innerHTML = '<tr><td colspan="' + colspan + '" style="text-align:center;padding:40px;color:var(--text-tertiary)"><i class="fas fa-box-open" style="font-size:32px;margin-bottom:8px;display:block"></i>Hozircha mahsulot yo\'q</td></tr>';
      return;
    }

    let html = '';
    _inventoryData.forEach(function(item, idx) {
      const hasVariants = item.variants && (item.variants.length > 1 || (item.variants.length === 1 && item.variants[0].color !== 'oddiy'));

      // 1. MAIN PRODUCT ROW
      const wCells = _warehouses.map(function(w) {
        const val = (item.warehouses && item.warehouses[w] != null) ? item.warehouses[w] : 0;
        const isEditable = !hasVariants;
        return '<td style="padding:12px 16px;text-align:center;font-weight:' + (hasVariants ? '700' : '500') + '">' + stockBadge(val, item.productName, 'oddiy', w, isEditable) + '</td>';
      }).join('');

      const mainRowBg = hasVariants ? 'background-color:rgba(99,102,241,0.015); border-left:3px solid var(--accent);' : '';
      const mainRowClass = hasVariants ? 'class="main-product-row" onclick="toggleVariants(' + idx + ', this)"' : '';
      
      let productNameHtml = '<div style="display:flex;align-items:center;gap:8px">';
      if (hasVariants) {
        productNameHtml += '<i class="fas fa-chevron-right toggle-icon" style="transition: transform 0.2s ease; color:var(--text-tertiary); font-size:11px; margin-right:4px"></i>';
        productNameHtml += '<i class="fas fa-boxes" style="color:var(--accent);font-size:14px"></i>';
        productNameHtml += '<span style="font-weight:700;color:var(--text-primary)">' + _esc(item.productName) + '</span>';
        productNameHtml += '<span style="background:rgba(99,102,241,0.08);color:var(--accent);font-size:10.5px;padding:2px 6px;border-radius:4px;font-weight:600">' + item.variants.length + ' xil rang</span>';
      } else {
        productNameHtml += '<i class="fas fa-box" style="color:var(--text-tertiary);font-size:14px;margin-left:15px"></i>';
        productNameHtml += '<span style="font-weight:600;color:var(--text-primary)">' + _esc(item.productName) + '</span>';
      }
      productNameHtml += '</div>';

      html += '<tr style="border-bottom:1px solid var(--border);' + mainRowBg + '" ' + mainRowClass + '>' +
              '<td style="padding:12px 16px;font-size:14px;">' + productNameHtml + '</td>' +
              wCells +
              '<td style="padding:12px 16px;text-align:center">' +
                '<span class="stock-badge stock-total">' + (item.total || 0) + '</span>' +
              '</td>' +
             '</tr>';

      // 2. SUB-ROWS FOR VARIANTS
      if (hasVariants) {
        item.variants.forEach(function(v) {
          const vWCells = _warehouses.map(function(w) {
            const val = (v.warehouses && v.warehouses[w] != null) ? v.warehouses[w] : 0;
            return '<td style="padding:8px 16px;text-align:center;opacity:0.9">' + stockBadge(val, item.productName, v.color, w, true) + '</td>';
          }).join('');

          const colorDot = '<span class="color-dot" style="background-color:' + getColorHash(v.color) + '"></span>';
          
          html += '<tr class="variant-row variant-row-' + idx + ' hidden" style="border-bottom:1px solid var(--border);">' +
                  '<td style="padding:8px 16px 8px 36px;font-size:13px;font-weight:500;color:var(--text-secondary);">' +
                    '<div style="display:flex;align-items:center;gap:8px">' +
                      '<span style="color:var(--text-tertiary);font-weight:bold;margin-right:2px">└─</span>' +
                      colorDot +
                      '<span class="variant-color-text" title="Rang nomini tahrirlash" onclick="initiateColorRename(event, this, \'' + _esc(item.productName).replace(/'/g, "\\'") + '\', \'' + _esc(v.color).replace(/'/g, "\\'") + '\')">' + 
                        _esc(v.color) + 
                        '<i class="fas fa-pencil-alt edit-color-icon"></i>' +
                      '</span>' +
                      '<i class="fas fa-trash-alt" title="O\'chirish" onclick="deleteColorVariant(event, \'' + _esc(item.productName).replace(/'/g, "\\'") + '\', \'' + _esc(v.color).replace(/'/g, "\\'") + '\')" style="cursor:pointer; font-size:10px; margin-left:6px; color:var(--text-tertiary); transition:color 0.2s;" onmouseover="this.style.color=\'var(--danger)\'" onmouseout="this.style.color=\'var(--text-tertiary)\'"></i>' +
                    '</div>' +
                  '</td>' +
                  vWCells +
                  '<td style="padding:8px 16px;text-align:center">' +
                    '<span class="stock-badge" style="background:rgba(120,120,128,0.08);color:var(--text-secondary);font-size:12px;font-weight:700">' + (v.total || 0) + '</span>' +
                  '</td>' +
                 '</tr>';
        });
      }
    });

    body.innerHTML = html;
  }

  
  // ── LOGS TABLE ──
  function renderLogs() {
    const body = document.getElementById('logsBody');
    if (!_logsData.length) {
      body.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-tertiary)"><i class="fas fa-history" style="font-size:32px;margin-bottom:8px;display:block"></i>Hozircha tarix yo\'q</td></tr>';
      return;
    }
    body.innerHTML = _logsData.map(log => {
      const displayColor = log.color && log.color !== 'oddiy' ? ` (${log.color})` : '';
      return `
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:10px 16px;font-size:12px;color:var(--text-secondary)">${_dateTime(log.createdAt)}</td>
        <td style="padding:10px 16px;font-size:13px;font-weight:500">${_esc(log.productName)}${displayColor}</td>
        <td style="padding:10px 16px;text-align:center;font-size:12px">${_esc(log.warehouse)}</td>
        <td style="padding:10px 16px;text-align:center;font-weight:700;color:${log.changeQty > 0 ? '#34C759' : '#FF3B30'}">${log.changeQty > 0 ? '+' : ''}${log.changeQty}</td>
        <td style="padding:10px 16px;text-align:center">${actionBadge(log.action)}</td>
        <td style="padding:10px 16px;font-size:12px;color:var(--text-secondary)">${_esc(log.notes || '')}${log.userName ? ' <span style="opacity:0.6">(' + _esc(log.userName) + ')</span>' : ''}</td>
      </tr>
    `;}).join('');
  }

  function switchTab(tab, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-inventory').style.display = tab === 'inventory' ? '' : 'none';
    document.getElementById('tab-logs').style.display = tab === 'logs' ? '' : 'none';
  }

  // ── Fill Modal ──
  function openFillModal() { document.getElementById('fillModal').classList.remove('hidden'); }
  function closeFillModal() { document.getElementById('fillModal').classList.add('hidden'); }

  async function saveFill() {
    const warehouse = document.getElementById('fill-warehouse').value;
    const productName = document.getElementById('fill-product').value;
    const color = document.getElementById('fill-color').value;
    const qty = parseInt(document.getElementById('fill-qty').value);
    const notes = document.getElementById('fill-notes').value.trim();

    if (!warehouse) { _toast('Omborni tanlang', 'error'); return; }
    if (!productName) { _toast('Mahsulot turini tanlang', 'error'); return; }
    if (!qty || qty <= 0) { _toast('Miqdor 0 dan katta bo\'lishi kerak', 'error'); return; }

    const btn = document.getElementById('fillSaveBtn');
    btn.disabled = true;
    try {
      await apiFetch('/api/warehouse/fill', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ warehouse, productName, color, qty, notes })
      });
      _toast("Zaxira qo'shildi", 'success');
      closeFillModal();
      document.getElementById('fill-qty').value = '';
      document.getElementById('fill-notes').value = '';
      document.getElementById('fill-color').value = 'oddiy';
      await loadData();
    } catch(e) { _toast(e.message, 'error'); }
    finally { btn.disabled = false; }
  }

  // ── Product Type Modal ──
  function openProductModal() {
    document.getElementById('productModal').classList.remove('hidden');
    loadProducts();
  }
  function closeProductModal() { document.getElementById('productModal').classList.add('hidden'); }

  function renderProductList() {
    const c = document.getElementById('productList');
    if (!_productCatalog.length) {
      c.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-tertiary)"><i class="fas fa-tags" style="font-size:24px;margin-bottom:8px;display:block"></i>Hozircha mahsulot turi yo\'q</div>';
      return;
    }
    c.innerHTML = _productCatalog.map(p => `
      <div class="product-item">
        <div>
          <div style="font-size:14px;font-weight:600;color:var(--text-primary)">${_esc(p.name)}</div>
          ${p.price ? '<div style="font-size:12px;color:var(--text-tertiary);margin-top:2px">' + fmtPrice(p.price) + '</div>' : ''}
        </div>
        <button class="btn btn-danger" style="padding:4px 10px;font-size:11px" onclick="deleteProduct(${p.id})">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    `).join('');
  }

  async function addProduct() {
    const nameEl = document.getElementById('newProductName');
    const name = nameEl.value.trim();

    if (!name) { _toast('Mahsulot nomi kerak', 'error'); nameEl.focus(); return; }

    try {
      await apiFetch('/api/product-catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, price: 0 })
      });
      _toast("Mahsulot turi qo'shildi", 'success');
      nameEl.value = '';
      await loadProducts();
    } catch(e) { _toast(e.message, 'error'); }
  }

  async function deleteProduct(id) {
    if (!confirm("Bu mahsulot turini o'chirasizmi?")) return;
    try {
      await apiFetch('/api/product-catalog/' + id, { method: 'DELETE' });
      _toast("O'chirildi", 'success');
      await loadProducts();
    } catch(e) { _toast(e.message, 'error'); }
  }

  // ── Init ──
  document.addEventListener('DOMContentLoaded', () => {
    loadData();
    loadProducts();
  });
</script>

