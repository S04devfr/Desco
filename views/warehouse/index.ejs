  // ── INVENTORY TABLE ──
  function renderTableHeader() {
    const thead = document.querySelector('#tab-inventory thead tr');
    if (!thead) return;
    const wCols = _warehouses.map(w =>
      '<th style="text-align:center;">' + _esc(w) + '</th>'
    ).join('');
    thead.innerHTML = '<th style="text-align:left;">Mahsulot va Ranglar</th>' +
      wCols +
      '<th style="text-align:center;">Jami Zaxira</th>' +
      '<th style="text-align:right;">Tezkor Harakat</th>';
  }

  function stockBadgeHtml(val, pName, color, warehouse) {
    const cls = val <= 0 ? 'stock-zero' : val <= 2 ? 'stock-low' : 'stock-ok';
    return `<span class="stock-badge ${cls}" title="Zaxirani tahrirlash uchun bosing" onclick="openQuickStockModal(event, '${_esc(pName).replace(/'/g, "\\'")}', '${_esc(color).replace(/'/g, "\\'")}', '${_esc(warehouse).replace(/'/g, "\\'")}', ${val})">${val}</span>`;
  }

  function toggleVariants(idx, rowEl) {
    const subRows = document.querySelectorAll('.variant-row-' + idx);
    const icon = rowEl.querySelector('.toggle-icon');
    let isOpening = false;

    subRows.forEach(r => {
      if (r.style.display === 'none' || r.classList.contains('hidden')) {
        r.style.display = '';
        r.classList.remove('hidden');
        isOpening = true;
      } else {
        r.style.display = 'none';
        r.classList.add('hidden');
      }
    });

    if (icon) {
      icon.style.transform = isOpening ? 'rotate(90deg)' : 'rotate(0deg)';
    }
  }

  function setStockFilter(filterType, btnEl) {
    _stockFilter = filterType;
    document.querySelectorAll('.wh-filter-btn').forEach(b => b.classList.remove('active'));
    if (btnEl) btnEl.classList.add('active');
    renderInventory();
  }

  function renderInventory() {
    const body = document.getElementById('inventoryBody');
    const searchVal = (document.getElementById('whSearch')?.value || '').toLowerCase().trim();
    const colspan = _warehouses.length + 3;

    const filteredData = _inventoryData.filter(item => {
      if (searchVal) {
        const nameMatch = item.productName.toLowerCase().includes(searchVal);
        const colorMatch = item.variants && item.variants.some(v => (v.color || '').toLowerCase().includes(searchVal));
        if (!nameMatch && !colorMatch) return false;
      }

      if (_stockFilter === 'low') {
        return (item.total || 0) <= 2 || (item.variants && item.variants.some(v => (v.total || 0) <= 2));
      }
      if (_stockFilter === 'zero') {
        return (item.total || 0) === 0 || (item.variants && item.variants.some(v => (v.total || 0) === 0));
      }
      return true;
    });

    if (!filteredData.length) {
      body.innerHTML = '<tr><td colspan="' + colspan + '" style="text-align:center;padding:40px;color:var(--text-tertiary)"><i class="fas fa-box-open" style="font-size:32px;margin-bottom:8px;display:block"></i>Mahsulot topilmadi</td></tr>';
      return;
    }

    let html = '';
    filteredData.forEach(function(item, idx) {
      const hasVariants = item.variants && (item.variants.length > 1 || (item.variants.length === 1 && item.variants[0].color !== 'oddiy'));

      // 1. MAIN PRODUCT ROW
      const wCells = _warehouses.map(function(w) {
        const val = (item.warehouses && item.warehouses[w] != null) ? item.warehouses[w] : 0;
        return '<td style="padding:14px 18px;text-align:center;">' + (hasVariants ? `<span class="stock-badge stock-total">${val}</span>` : stockBadgeHtml(val, item.productName, 'oddiy', w)) + '</td>';
      }).join('');

      const mainRowBg = hasVariants ? 'border-left:3px solid var(--accent);' : '';
      const mainRowClass = hasVariants ? 'class="main-product-row" onclick="toggleVariants(' + idx + ', this)"' : '';
      
      let productNameHtml = '<div style="display:flex;align-items:center;gap:10px">';
      if (hasVariants) {
        productNameHtml += '<i class="fas fa-chevron-right toggle-icon" style="transition: transform 0.2s ease; color:var(--text-tertiary); font-size:11px;"></i>';
        productNameHtml += '<div style="width:32px;height:32px;border-radius:8px;background:rgba(99,102,241,0.1);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-boxes"></i></div>';
        productNameHtml += '<div><span style="font-weight:800;color:var(--text-primary);font-size:14px;">' + _esc(item.productName) + '</span>';
        productNameHtml += ' <span style="background:rgba(99,102,241,0.1);color:var(--accent);font-size:10.5px;padding:2px 6px;border-radius:6px;font-weight:700;margin-left:6px">' + item.variants.length + ' xil rang</span></div>';
      } else {
        productNameHtml += '<div style="width:32px;height:32px;border-radius:8px;background:rgba(142,142,147,0.1);color:var(--text-secondary);display:flex;align-items:center;justify-content:center;font-size:13px;margin-left:18px"><i class="fas fa-box"></i></div>';
        productNameHtml += '<span style="font-weight:700;color:var(--text-primary);font-size:14px;">' + _esc(item.productName) + '</span>';
      }
      productNameHtml += '</div>';

      const mainRowActionBtns = `
        <div style="display:inline-flex; gap:6px; align-items:center;">
          <button class="btn btn-sm btn-ghost" onclick="renameProductPrompt(event, '${_esc(item.productName).replace(/'/g, "\\'")}')" style="font-size:11px; padding:3px 8px; font-weight:700; color:var(--text-primary); border:1px solid var(--border);" title="Mahsulot nomini o'zgartirish"><i class="fas fa-edit"></i> Nomini o'zgartirish</button>
          <button class="btn btn-sm btn-ghost" onclick="openAddVariantModal(event, '${_esc(item.productName).replace(/'/g, "\\'")}')" style="font-size:11px; padding:3px 8px; font-weight:700; color:var(--accent); border:1px solid rgba(99,102,241,0.3);" title="Ushbu mahsulotga yangi rang qo'shish"><i class="fas fa-plus"></i> Rang qo'shish</button>
          <button class="btn btn-sm btn-ghost" onclick="deleteProductPrompt(event, '${_esc(item.productName).replace(/'/g, "\\'")}')" style="font-size:11px; padding:3px 8px; font-weight:700; color:var(--danger); border:1px solid rgba(239,68,68,0.3);" title="Mahsulotni va zaxirani butunlay o'chirish"><i class="fas fa-trash-alt"></i></button>
        </div>
      `;

      html += '<tr style="border-bottom:1px solid var(--border);' + mainRowBg + '" ' + mainRowClass + '>' +
              '<td style="padding:14px 18px;">' + productNameHtml + '</td>' +
              wCells +
              '<td style="padding:14px 18px;text-align:center">' +
                '<span class="stock-badge stock-total">' + (item.total || 0) + '</span>' +
              '</td>' +
              '<td style="padding:14px 18px;text-align:right;">' + mainRowActionBtns + '</td>' +
             '</tr>';

      // 2. SUB-ROWS FOR VARIANTS
      if (hasVariants) {
        item.variants.forEach(function(v) {
          const vWCells = _warehouses.map(function(w) {
            const val = (v.warehouses && v.warehouses[w] != null) ? v.warehouses[w] : 0;
            return '<td style="padding:10px 18px;text-align:center;">' + stockBadgeHtml(val, item.productName, v.color, w) + '</td>';
          }).join('');

          const colorDot = '<span class="color-dot" style="background-color:' + getColorHash(v.color) + '"></span>';
          
          const variantActionBtns = `
            <div style="display:inline-flex; gap:6px; align-items:center;">
              <button onclick="openFillModalForVariant(event, '${_esc(item.productName).replace(/'/g, "\\'")}', '${_esc(v.color).replace(/'/g, "\\'")}')" class="btn btn-sm btn-ghost" style="font-size:10.5px; padding:2px 6px; font-weight:700; color:#10B981;" title="Zaxira qo'shish">+ Zaxira</button>
              <button onclick="openTransferModalForVariant(event, '${_esc(item.productName).replace(/'/g, "\\'")}', '${_esc(v.color).replace(/'/g, "\\'")}')" class="btn btn-sm btn-ghost" style="font-size:10.5px; padding:2px 6px; font-weight:700; color:var(--accent);" title="Omborlararo ko'chirish">🔀 Ko'chirish</button>
              <button onclick="deleteColorVariant(event, '${_esc(item.productName).replace(/'/g, "\\'")}', '${_esc(v.color).replace(/'/g, "\\'")}')" class="btn btn-sm btn-ghost" style="font-size:10.5px; padding:2px 6px; font-weight:700; color:var(--danger);" title="Rangni o'chirish"><i class="fas fa-trash-alt"></i></button>
            </div>
          `;

          html += '<tr class="variant-row variant-row-' + idx + ' hidden" style="display:none; border-bottom:1px solid var(--border);">' +
                  '<td style="padding:10px 18px 10px 48px;font-size:13px;font-weight:500;color:var(--text-secondary);">' +
                    '<div style="display:flex;align-items:center;gap:8px">' +
                      '<span style="color:var(--text-tertiary);font-weight:bold;margin-right:2px">└─</span>' +
                      colorDot +
                      '<span class="variant-color-text" title="Rang nomini tahrirlash uchun bosing" onclick="initiateColorRename(event, this, \'' + _esc(item.productName).replace(/'/g, "\\'") + '\', \'' + _esc(v.color).replace(/'/g, "\\'") + '\')">' + 
                        _esc(v.color) + 
                        '<i class="fas fa-pencil-alt edit-color-icon"></i>' +
                      '</span>' +
                    '</div>' +
                  '</td>' +
                  vWCells +
                  '<td style="padding:10px 18px;text-align:center">' +
                    '<span class="stock-badge" style="background:rgba(120,120,128,0.08);color:var(--text-secondary);font-size:12px;font-weight:800">' + (v.total || 0) + '</span>' +
                  '</td>' +
                  '<td style="padding:10px 18px;text-align:right">' + variantActionBtns + '</td>' +
                 '</tr>';
        });
      }
    });

    body.innerHTML = html;
  }

  function filterInventoryList() {
    renderInventory();
  }

  // ── MAHSULOT NOMINI TAHRIRLASH VA O'CHIRISH ──
  async function renameProductPrompt(event, oldName) {
    if (event) event.stopPropagation();
    const newName = prompt(`'${oldName}' mahsuloti uchun yangi nom kiriting:`, oldName);
    if (!newName || !newName.trim() || newName.trim() === oldName) return;

    try {
      const res = await fetch('/api/warehouse/rename-product', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ oldName, newName: newName.trim() })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Xatolik yuz berdi');
      showToast(data.message, 'success');
      loadData();
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  async function deleteProductPrompt(event, productName) {
    if (event) event.stopPropagation();
    if (!confirm(`Haqiqatan ham '${productName}' mahsulotini va uning barcha zaxiralarini ombordan o'chirmoqchimisiz?`)) return;

    try {
      const res = await fetch('/api/warehouse/delete-product', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Xatolik yuz berdi');
      showToast(data.message, 'success');
      loadData();
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  // ── AQLIY QUICK STOCK MODAL ──
  function openQuickStockModal(event, productName, color, warehouse, currentStock) {
    if (event) event.stopPropagation();
    _activeQsData = { productName, color, warehouse, currentStock: parseInt(currentStock) || 0 };

    document.getElementById('qs-product-title').textContent = productName;
    document.getElementById('qs-color-name').textContent = color;
    document.getElementById('qs-warehouse-name').textContent = warehouse + ' Ombori';
    document.getElementById('qs-color-badge').style.backgroundColor = getColorHash(color);
    document.getElementById('qs-stock-input').value = _activeQsData.currentStock;
    document.getElementById('qs-notes-input').value = '';

    document.getElementById('quickStockModal').classList.remove('hidden');
  }

  function closeQuickStockModal() {
    document.getElementById('quickStockModal').classList.add('hidden');
    _activeQsData = null;
  }

  function stepQuickStock(delta) {
    const input = document.getElementById('qs-stock-input');
    const val = Math.max(0, (parseInt(input.value) || 0) + delta);
    input.value = val;
  }

  async function submitQuickStockEdit() {
    if (!_activeQsData) return;
    const input = document.getElementById('qs-stock-input');
    const notesInput = document.getElementById('qs-notes-input');

    const newStock = parseInt(input.value);
    if (isNaN(newStock) || newStock < 0) {
      _toast("Tog'ri zaxira miqdorini kiriting", 'error');
      return;
    }

    const btn = document.getElementById('btnSaveQuickStock');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saqlanmoqda...';

    try {
      await apiFetch('/api/warehouse/update-stock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productName: _activeQsData.productName,
          color: _activeQsData.color,
          warehouse: _activeQsData.warehouse,
          stock: newStock,
          notes: notesInput.value.trim() || undefined
        })
      });
      _toast("Zaxira muvaffaqiyatli saqlandi", 'success');
      closeQuickStockModal();
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Zaxirani Saqlash';
    }
  }

  // ── QUICK ADD VARIANT MODAL ──
  function openAddVariantModal(event, productName) {
    if (event) event.stopPropagation();
    document.getElementById('av-product-name').value = productName;
    document.getElementById('av-color-name').value = '';
    document.getElementById('av-stock-toshkent').value = '0';
    document.getElementById('av-stock-qoqon').value = '0';
    document.getElementById('addVariantModal').classList.remove('hidden');
  }

  function closeAddVariantModal() {
    document.getElementById('addVariantModal').classList.add('hidden');
  }

  async function submitAddVariant() {
    const pName = document.getElementById('av-product-name').value.trim();
    const color = document.getElementById('av-color-name').value.trim();
    const stockToshkent = parseInt(document.getElementById('av-stock-toshkent').value) || 0;
    const stockQoqon = parseInt(document.getElementById('av-stock-qoqon').value) || 0;

    if (!pName || !color) {
      _toast("Iltimos, rang nomini kiriting", 'error');
      return;
    }

    const btn = document.getElementById('btnSaveAddVariant');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Qo\'shilmoqda...';

    try {
      if (stockToshkent > 0) {
        await apiFetch('/api/warehouse/fill', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ warehouse: 'Toshkent', productName: pName, color, qty: stockToshkent, notes: "Yangi rang qo'shildi" })
        });
      }
      if (stockQoqon > 0) {
        await apiFetch('/api/warehouse/fill', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ warehouse: 'Qo\'qon', productName: pName, color, qty: stockQoqon, notes: "Yangi rang qo'shildi" })
        });
      }
      if (stockToshkent === 0 && stockQoqon === 0) {
        await apiFetch('/api/warehouse/update-stock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ warehouse: 'Toshkent', productName: pName, color, stock: 0 })
        });
      }

      _toast(`"${color}" rangi muvaffaqiyatli qo'shildi`, 'success');
      closeAddVariantModal();
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-plus"></i> Variantni Qo\'shish';
    }
  }

  // ── QUICK FILL & TRANSFER HELPERS ──
  function openFillModalForVariant(event, productName, color) {
    if (event) event.stopPropagation();
    openFillModal();
    const selProd = document.getElementById('fill-product');
    if (selProd) selProd.value = productName;
    document.getElementById('fill-color').value = color;
  }

  function openTransferModalForVariant(event, productName, color) {
    if (event) event.stopPropagation();
    openTransferModal();
    document.getElementById('tr-product').value = productName;
    document.getElementById('tr-color').value = color;
  }

  // ── LOGS TABLE ──
  function renderLogs() {
    const body = document.getElementById('logsBody');
    if (!_logsData.length) {
      body.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-tertiary)"><i class="fas fa-history" style="font-size:32px;margin-bottom:8px;display:block"></i>Hozircha tarix yo\'q</td></tr>';
      return;
    }
    body.innerHTML = _logsData.map(log => {
      const displayColor = log.color && log.color !== 'oddiy' ? ` (${log.color})` : '';
      const actionBadge = log.changeQty > 0
        ? `<span class="stock-badge stock-ok" style="font-size:11px;">+ To'ldirish</span>`
        : `<span class="stock-badge stock-zero" style="font-size:11px;">- Chiqarish</span>`;

      return `
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:12px 18px;font-size:12px;color:var(--text-secondary);">${_dateTime(log.createdAt)}</td>
        <td style="padding:12px 18px;font-size:13.5px;font-weight:600;">${_esc(log.productName)}${displayColor}</td>
        <td style="padding:12px 18px;text-align:center;font-size:12.5px;font-weight:600;">${_esc(log.warehouse)}</td>
        <td style="padding:12px 18px;text-align:center;font-weight:800;color:${log.changeQty > 0 ? '#10B981' : '#EF4444'}">${log.changeQty > 0 ? '+' : ''}${log.changeQty}</td>
        <td style="padding:12px 18px;text-align:center">${actionBadge}</td>
        <td style="padding:12px 18px;font-size:12px;color:var(--text-secondary);">${_esc(log.notes || '')} ${log.userName ? `<b style="color:var(--text-primary)">(${_esc(log.userName)})</b>` : ''}</td>
      </tr>
      `;
    }).join('');
  }

  // ── MODALS CONTROL ──
  function switchTab(tab, btn) {
    document.querySelectorAll('.wh-pill-tab').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    document.getElementById('tab-inventory').style.display = tab === 'inventory' ? 'block' : 'none';
    document.getElementById('tab-logs').style.display = tab === 'logs' ? 'block' : 'none';
    document.getElementById('inventoryFilterGroup').style.display = tab === 'inventory' ? 'flex' : 'none';
  }

  function openFillModal() { document.getElementById('fillModal').classList.remove('hidden'); }
  function closeFillModal() { document.getElementById('fillModal').classList.add('hidden'); }

  function openTransferModal() { document.getElementById('transferModal').classList.remove('hidden'); }
  function closeTransferModal() { document.getElementById('transferModal').classList.add('hidden'); }

  function openProductModal() { document.getElementById('productModal').classList.remove('hidden'); }
  function closeProductModal() { document.getElementById('productModal').classList.add('hidden'); }

  async function submitFill() {
    const warehouse = document.getElementById('fill-warehouse').value;
    const productName = document.getElementById('fill-product').value;
    const color = document.getElementById('fill-color').value.trim();
    const qty = parseInt(document.getElementById('fill-qty').value);
    const notes = document.getElementById('fill-notes').value.trim();

    if (!warehouse || !productName || isNaN(qty) || qty <= 0) {
      _toast("Barcha majburiy maydonlarni to'g'ri to'ldiring", 'error');
      return;
    }

    const btn = document.getElementById('btnSubmitFill');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Qo\'shilmoqda...';

    try {
      await apiFetch('/api/warehouse/fill', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ warehouse, productName, color, qty, notes })
      });
      _toast("Zaxira qo'shildi", 'success');
      closeFillModal();
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = 'Qo\'shish';
    }
  }

  async function submitTransfer() {
    const fromWarehouse = document.getElementById('tr-from').value;
    const toWarehouse = document.getElementById('tr-to').value;
    const productName = document.getElementById('tr-product').value.trim();
    const color = document.getElementById('tr-color').value.trim();
    const qty = parseInt(document.getElementById('tr-qty').value);
    const notes = document.getElementById('tr-notes').value.trim();

    if (!fromWarehouse || !toWarehouse || !productName || isNaN(qty) || qty <= 0) {
      _toast("Barcha majburiy maydonlarni to'g'ri to'ldiring", 'error');
      return;
    }

    if (fromWarehouse === toWarehouse) {
      _toast("Bir xil omborlar o'rtasida ko'chirib bo'lmaydi", 'error');
      return;
    }

    const btn = document.getElementById('btnSubmitTransfer');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ko\'chirilmoqda...';

    try {
      await apiFetch('/api/warehouse/transfer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fromWarehouse, toWarehouse, productName, color, qty, notes })
      });
      _toast("Ko'chirildi muvaffaqiyatli", 'success');
      closeTransferModal();
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = 'Ko\'chirish';
    }
  }

  // ── RENAME / DELETE COLOR VARIANT ──
  function initiateColorRename(event, textEl, productName, oldColor) {
    event.stopPropagation();
    const newColor = prompt(`"${productName}" uchun "${oldColor}" rangi nomini yangilang:`, oldColor);
    if (!newColor || newColor.trim() === '' || newColor.trim() === oldColor) return;

    apiFetch('/api/warehouse/rename-color', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productName, oldColor, newColor: newColor.trim() })
    }).then(res => {
      _toast(res.message || "Rang nomi yangilandi", 'success');
      loadData();
    }).catch(e => {
      _toast(e.message, 'error');
    });
  }

  async function deleteColorVariant(event, productName, color) {
    event.stopPropagation();
    if (!confirm(`"${productName}" mahsulotidan "${color}" rangini (variantini) o'chirishni tasdiqlaysizmi?`)) return;

    try {
      await apiFetch('/api/warehouse/delete-color', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName, color })
      });
      _toast(`"${color}" rangi o'chirildi`, 'success');
      await loadData();
    } catch(e) {
      _toast(e.message, 'error');
    }
  }

  // ── CATALOG MANAGEMENT ──
  function renderProductList() {
    const container = document.getElementById('productCatalogList');
    if (!container) return;
    if (!_productCatalog.length) {
      container.innerHTML = '<div style="padding:20px; text-align:center; color:var(--text-tertiary); font-size:13px;">Hozircha mahsulot turlari yaratilmagan</div>';
      return;
    }
    container.innerHTML = _productCatalog.map(p => `
      <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 12px; border-bottom:1px solid var(--border);">
        <span style="font-size:13.5px; font-weight:700; color:var(--text-primary);">${_esc(p.name)}</span>
        <button class="btn btn-ghost btn-sm" onclick="deleteProductCategory(${p.id}, '${_esc(p.name).replace(/'/g, "\\'")}')" style="color:var(--danger); font-size:11px; padding:2px 8px;">O'chirish</button>
      </div>
    `).join('');
  }

  async function addProductCategory() {
    const input = document.getElementById('newCatName');
    const name = input.value.trim();
    if (!name) { _toast("Mahsulot turi nomini kiriting", 'error'); return; }

    try {
      await apiFetch('/api/product-catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      _toast("Mahsulot turi qo'shildi", 'success');
      input.value = '';
      await loadProducts();
    } catch(e) { _toast(e.message, 'error'); }
  }

  async function deleteProductCategory(id, name) {
    if (!confirm(`"${name}" mahsulot turini o'chirishni tasdiqlaysizmi?`)) return;
    try {
      await apiFetch('/api/product-catalog/' + id, { method: 'DELETE' });
      _toast("Mahsulot turi o'chirildi", 'success');
      await loadProducts();
    } catch(e) { _toast(e.message, 'error'); }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadData();
    loadProducts();
  });
</script>

<%- include('../layouts/footer') %>
