<%- include('../layouts/header', {
  title: 'Xarajatlar — DESCO CRM',
  activePage: 'expenses',
  user: user}) %>

<style>
/* Expenses Modern Senior Design System */
.expenses-container {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.expenses-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.expenses-title-group h1 {
  font-size: 24px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.expenses-title-group p {
  font-size: 13.5px;
  color: var(--text-secondary);
}

/* Modern Stat Grid */
.exp-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}

.exp-stat-card {
  background: var(--bg-surface, #121826);
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: 20px;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}
.exp-stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 40px rgba(99, 102, 241, 0.18);
  border-color: rgba(99, 102, 241, 0.35);
}

.exp-stat-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.exp-stat-label {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text-tertiary, #94A3B8);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.exp-stat-value {
  font-size: 22px;
  font-weight: 800;
  color: var(--text-primary, #F8FAFC);
  letter-spacing: -0.5px;
}

.exp-stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}
.exp-stat-icon.red { background: rgba(239, 68, 68, 0.15); color: #EF4444; }
.exp-stat-icon.amber { background: rgba(245, 158, 11, 0.15); color: #F59E0B; }
.exp-stat-icon.indigo { background: rgba(99, 102, 241, 0.15); color: #818CF8; }

/* Filter Bar & Category Pills */
.exp-filter-card {
  background: var(--bg-surface, #121826);
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: 20px;
  padding: 18px 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.cat-pills-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.cat-pill {
  padding: 7px 16px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-secondary, #94A3B8);
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.cat-pill:hover {
  background: rgba(255, 255, 255, 0.12);
  color: var(--text-primary, #F8FAFC);
}
.cat-pill.active {
  background: #3B82F6;
  color: #FFFFFF;
  border-color: #3B82F6;
  box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
}

.filter-inputs-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding-top: 12px;
  border-top: 1px dashed var(--border-subtle, rgba(255, 255, 255, 0.08));
}

.date-input-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 6px 12px;
}
.date-input-wrap input[type="date"] {
  border: none;
  background: transparent;
  color: var(--text-primary, #F8FAFC);
  font-family: inherit;
  font-size: 13px;
  outline: none;
  color-scheme: dark;
}

/* Modern Expenses Table */
.exp-table-card {
  background: var(--bg-surface, #121826);
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.exp-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.exp-table th {
  padding: 14px 20px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-tertiary, #94A3B8);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: rgba(0, 0, 0, 0.25);
  border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
}

.exp-table td {
  padding: 16px 20px;
  font-size: 14px;
  color: var(--text-primary, #F8FAFC);
  border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  vertical-align: middle;
}
.exp-table tbody tr {
  transition: background 0.15s ease;
}
.exp-table tbody tr:hover {
  background: rgba(255, 255, 255, 0.04);
}
.exp-table tbody tr:last-child td {
  border-bottom: none;
}

/* Badges */
.exp-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 700;
}
.exp-badge.salary { background: rgba(59, 130, 246, 0.15); color: #60A5FA; }
.exp-badge.transport { background: rgba(245, 158, 11, 0.15); color: #FBBF24; }
.exp-badge.office { background: rgba(139, 92, 246, 0.15); color: #A78BFA; }
.exp-badge.marketing { background: rgba(16, 185, 129, 0.15); color: #34D399; }
.exp-badge.other { background: rgba(148, 163, 184, 0.18); color: #94A3B8; }

/* Linked Deal Chip */
.deal-link-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 8px;
  background: rgba(99, 102, 241, 0.15);
  border: 1px solid rgba(99, 102, 241, 0.3);
  color: #818CF8;
  font-size: 12px;
  font-weight: 600;
  margin-top: 6px;
}

/* Modal Polish */
.modal-box-polished {
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: 24px;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 520px;
  overflow: hidden;
  animation: iosSpring 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.modal-hdr-polished {
  padding: 20px 24px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.modal-hdr-polished h2 {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
}

.modal-body-polished {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.modal-ftr-polished {
  padding: 16px 24px;
  border-top: 1px solid var(--border-subtle);
  background: var(--bg-app);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}
</style>

<div class="expenses-container">

  <!-- Header -->
  <div class="expenses-header">
    <div class="expenses-title-group">
      <h1><i class="fas fa-wallet" style="color:var(--primary);"></i> Xarajatlar Boshqaruvi</h1>
      <p>Barcha moliyaviy chiqimlar va operativ xarajatlar tahlili</p>
    </div>
    <button class="btn btn-primary" onclick="openExpenseModal()" style="border-radius:14px; padding:10px 20px; font-weight:700;">
      <i class="fas fa-plus"></i> Yangi xarajat
    </button>
  </div>

  <!-- Stats Grid -->
  <div class="exp-stats-grid">
    <div class="exp-stat-card">
      <div class="exp-stat-info">
        <span class="exp-stat-label">Jami Xarajat</span>
        <span class="exp-stat-value" id="statTotal" style="color:#EF4444;">—</span>
      </div>
      <div class="exp-stat-icon red"><i class="fas fa-arrow-trend-down"></i></div>
    </div>

    <div class="exp-stat-card">
      <div class="exp-stat-info">
        <span class="exp-stat-label">Ushbu Oyda</span>
        <span class="exp-stat-value" id="statMonth" style="color:#F59E0B;">—</span>
      </div>
      <div class="exp-stat-icon amber"><i class="fas fa-calendar-days"></i></div>
    </div>

    <div class="exp-stat-card">
      <div class="exp-stat-info">
        <span class="exp-stat-label">Jami Yozuvlar</span>
        <span class="exp-stat-value" id="statCount">—</span>
      </div>
      <div class="exp-stat-icon indigo"><i class="fas fa-file-invoice-dollar"></i></div>
    </div>
  </div>

  <!-- Filter & Category Pills -->
  <div class="exp-filter-card">
    <div class="cat-pills-row">
      <span style="font-size:13px; font-weight:700; color:var(--text-tertiary); margin-right:6px;"><i class="fas fa-sliders"></i> Kategoriya:</span>
      <button class="cat-pill active" onclick="selectCat('', this)"><i class="fas fa-border-all"></i> Barchasi</button>
      <button class="cat-pill" onclick="selectCat('salary', this)"><i class="fas fa-user-tie"></i> Maosh</button>
      <button class="cat-pill" onclick="selectCat('transport', this)"><i class="fas fa-truck-ramp-box"></i> Transport</button>
      <button class="cat-pill" onclick="selectCat('office', this)"><i class="fas fa-building-user"></i> Ofis</button>
      <button class="cat-pill" onclick="selectCat('marketing', this)"><i class="fas fa-bullhorn"></i> Marketing</button>
      <button class="cat-pill" onclick="selectCat('other', this)"><i class="fas fa-receipt"></i> Boshqa</button>
    </div>

    <div class="filter-inputs-row">
      <div class="date-input-wrap">
        <i class="far fa-calendar" style="color:var(--text-tertiary); font-size:12px;"></i>
        <input type="date" id="filterFrom" title="Dan" onchange="loadExpenses()">
        <span style="color:var(--text-tertiary);">—</span>
        <input type="date" id="filterTo" title="Gacha" onchange="loadExpenses()">
      </div>

      <input type="hidden" id="filterCategory" value="">

      <button class="btn btn-secondary btn-sm" onclick="clearFilters()" title="Tozalash" style="border-radius:10px;">
        <i class="fas fa-rotate-left"></i> Qayta o'rnatisiz
      </button>
    </div>
  </div>

  <!-- Expenses Table -->
  <div class="exp-table-card">
    <div class="table-responsive">
      <table class="exp-table" id="expensesTable">
        <thead>
          <tr>
            <th style="width: 5%; text-align: center;">#</th>
            <th style="width: 38%;">Xarajat Tavsifi</th>
            <th style="width: 14%;">Kategoriya</th>
            <th style="width: 16%;">Summa</th>
            <th style="width: 12%;">Sana</th>
            <th style="width: 10%;">Qo'shdi</th>
            <th style="width: 5%; text-align: center;">Amal</th>
          </tr>
        </thead>
        <tbody id="expensesBody">
          <tr><td colspan="7"><div style="padding:40px;text-align:center;"><div class="spinner"></div></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modern Expense Modal -->
<div class="modal-overlay hidden" id="expenseModal">
  <div class="modal-box-polished">
    <div class="modal-hdr-polished">
      <h2 id="expModalTitle"><i class="fas fa-receipt" style="color:var(--primary); margin-right:8px;"></i> Yangi Xarajat</h2>
      <button class="modal-close" onclick="closeExpenseModal()">&times;</button>
    </div>
    <div class="modal-body-polished">
      <input type="hidden" id="expenseId">
      
      <div class="form-group">
        <label class="form-label" style="font-weight:700; font-size:12.5px;">Xarajat Tavsifi *</label>
        <input type="text" id="e-description" class="form-control" placeholder="Masalan: Ofis ijara to'lovi yoki Sdelka #102 operatsion xarajati" style="border-radius:12px; padding:12px;">
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-group">
          <label class="form-label" style="font-weight:700; font-size:12.5px;">Summa (UZS) *</label>
          <input type="number" id="e-amount" class="form-control" placeholder="0" min="0" style="border-radius:12px; padding:12px;">
        </div>

        <div class="form-group">
          <label class="form-label" style="font-weight:700; font-size:12.5px;">Kategoriya</label>
          <select id="e-category" class="form-control" style="border-radius:12px; padding:12px;">
            <option value="other">Boshqa</option>
            <option value="salary">Maosh</option>
            <option value="transport">Transport</option>
            <option value="office">Ofis</option>
            <option value="marketing">Marketing</option>
          </select>
        </div>

        <div class="form-group" style="grid-column: 1 / -1;">
          <label class="form-label" style="font-weight:700; font-size:12.5px;">Sana</label>
          <input type="date" id="e-date" class="form-control" style="border-radius:12px; padding:12px;">
        </div>
      </div>
    </div>

    <div class="modal-ftr-polished">
      <button class="btn btn-secondary" onclick="closeExpenseModal()" style="border-radius:12px;">Bekor qilish</button>
      <button class="btn btn-primary" id="expSaveBtn" onclick="saveExpense()" style="border-radius:12px; font-weight:700;">
        <i class="fas fa-check"></i> Saqlash
      </button>
    </div>
  </div>
</div>

<script>
let allExpenses = [];
const catLabels = { salary:'Maosh', transport:'Transport', office:'Ofis', marketing:'Marketing', other:'Boshqa' };
const catClasses = { salary:'salary', transport:'transport', office:'office', marketing:'marketing', other:'other' };
const catIcons = { salary:'fa-user-tie', transport:'fa-truck-ramp-box', office:'fa-building-user', marketing:'fa-bullhorn', other:'fa-receipt' };

window.allDealsData = [];

function selectCat(val, btnEl) {
  document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
  btnEl.classList.add('active');
  document.getElementById('filterCategory').value = val;
  loadExpenses();
}

function clearFilters() {
  document.getElementById('filterCategory').value = '';
  document.getElementById('filterFrom').value = '';
  document.getElementById('filterTo').value = '';
  document.querySelectorAll('.cat-pill').forEach((b, idx) => {
    if (idx === 0) b.classList.add('active');
    else b.classList.remove('active');
  });
  loadExpenses();
}

async function loadExpenses() {
  const cat = document.getElementById('filterCategory').value;
  const from = document.getElementById('filterFrom').value;
  const to = document.getElementById('filterTo').value;
  const params = new URLSearchParams();
  if (cat) params.set('category', cat);
  if (from) params.set('from', from);
  if (to) params.set('to', to);
  
  try {
    const fetchFn = (typeof fetchWithTimeout === 'function') ? fetchWithTimeout : fetch;
    const [expRes, dealsRes] = await Promise.all([
      fetchFn('/api/expenses?' + params),
      fetchFn('/api/deals')
    ]);

    const [expData, dealsData] = await Promise.all([
      expRes.json().catch(() => ({})),
      dealsRes.json().catch(() => ([]))
    ]);

    if (!expRes.ok) throw new Error(expData.message || 'Server xatosi');
    
    allExpenses = Array.isArray(expData) ? expData : [];
    window.allDealsData = Array.isArray(dealsData) ? dealsData : [];

    renderExpenses();
    updateStats();
  } catch(e) {
    allExpenses = [];
    showToast("Ma'lumotlarni yuklashda xatolik: " + (e.message || ''), 'error');
    renderExpenses();
    updateStats();
  }
}

function updateStats() {
  const total = allExpenses.reduce((s, e) => s + e.amount, 0);
  document.getElementById('statTotal').textContent = fmtMoney(total);
  document.getElementById('statCount').textContent = allExpenses.length;
  
  const now = new Date();
  const monthTotal = allExpenses.filter(e => {
    const d = new Date(e.date || e.createdAt);
    return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
  }).reduce((s, e) => s + e.amount, 0);
  
  document.getElementById('statMonth').textContent = fmtMoney(monthTotal);
}

function renderExpenses() {
  const tbody = document.getElementById('expensesBody');
  if (!allExpenses.length) {
    tbody.innerHTML = `
      <tr>
        <td colspan="7">
          <div style="padding:60px 20px; text-align:center; color:var(--text-tertiary);">
            <div style="font-size:44px; margin-bottom:12px; opacity:0.4;"><i class="fas fa-receipt"></i></div>
            <h3 style="font-size:16px; color:var(--text-secondary); margin:0; font-weight:700;">Xarajatlar topilmadi</h3>
            <p style="font-size:13px; margin-top:6px;">Ushbu tanlangan oraliqda hech qanday yozuv yo'q.</p>
          </div>
        </td>
      </tr>`;
    return;
  }

  tbody.innerHTML = allExpenses.map((e, i) => {
    let dealInfoHtml = '';
    const match = e.description.match(/#(\d+)/);
    if (match && window.allDealsData) {
      const dealId = Number(match[1]);
      const deal = window.allDealsData.find(d => d.id === dealId);
      if (deal) {
        dealInfoHtml = `
          <div class="deal-link-chip">
            <i class="fas fa-handshake"></i> Sdelka #${deal.id} &bull; ${escHtml(deal.productName)}
            ${deal.client ? ` &bull; 👤 ${escHtml(deal.client.name)}` : ''}
          </div>`;
      }
    }

    const categoryKey = e.category || 'other';
    const iconClass = catIcons[categoryKey] || 'fa-receipt';
    const badgeClass = catClasses[categoryKey] || 'other';
    const label = catLabels[categoryKey] || categoryKey;

    return `
      <tr>
        <td style="text-align: center; font-weight: 700; color: var(--text-tertiary);">${i + 1}</td>
        <td>
          <div style="font-weight:700; font-size:14px; color:var(--text-primary);">${escHtml(e.description)}</div>
          ${dealInfoHtml}
        </td>
        <td>
          <span class="exp-badge ${badgeClass}">
            <i class="fas ${iconClass}"></i> ${label}
          </span>
        </td>
        <td>
          <span style="font-weight:800; font-size:15px; color:#EF4444;">${fmtMoney(e.amount)}</span>
        </td>
        <td style="font-weight:600; color:var(--text-secondary); font-size:13px;">${fmtDateShort(e.date || e.createdAt)}</td>
        <td style="font-size:13px; color:var(--text-secondary);">${e.createdBy ? escHtml(e.createdBy.fullName || e.createdBy.email) : '—'}</td>
        <td style="text-align:center;">
          <div style="display:flex; justify-content:center; gap:6px;">
            <button class="btn btn-ghost btn-icon btn-sm" onclick="editExpense(${e.id})" title="Tahrirlash" style="border-radius:10px;">
              <i class="fas fa-pen-to-square"></i>
            </button>
            <button class="btn btn-ghost btn-icon btn-sm text-danger" onclick="deleteExpense(${e.id})" title="O'chirish" style="border-radius:10px;">
              <i class="fas fa-trash-can"></i>
            </button>
          </div>
        </td>
      </tr>`;
  }).join('');
}

function openExpenseModal(id = null) {
  document.getElementById('expenseId').value = '';
  document.getElementById('e-description').value = '';
  document.getElementById('e-amount').value = '';
  document.getElementById('e-category').value = 'other';
  document.getElementById('e-date').value = new Date().toISOString().split('T')[0];
  document.getElementById('expModalTitle').innerHTML = '<i class="fas fa-receipt" style="color:var(--primary); margin-right:8px;"></i> Yangi Xarajat';
  document.getElementById('expenseModal').classList.remove('hidden');
}

function closeExpenseModal() {
  document.getElementById('expenseModal').classList.add('hidden');
}

function editExpense(id) {
  const exp = allExpenses.find(e => e.id === id);
  if (!exp) return;
  document.getElementById('expenseId').value = exp.id;
  document.getElementById('e-description').value = exp.description;
  document.getElementById('e-amount').value = exp.amount;
  document.getElementById('e-category').value = exp.category || 'other';
  if (exp.date) {
    document.getElementById('e-date').value = new Date(exp.date).toISOString().split('T')[0];
  }
  document.getElementById('expModalTitle').innerHTML = '<i class="fas fa-pen-to-square" style="color:var(--primary); margin-right:8px;"></i> Xarajatni Tahrirlash';
  document.getElementById('expenseModal').classList.remove('hidden');
}

async function saveExpense() {
  const id = document.getElementById('expenseId').value;
  const description = document.getElementById('e-description').value.trim();
  const amount = Number(document.getElementById('e-amount').value);
  const category = document.getElementById('e-category').value;
  const date = document.getElementById('e-date').value;

  if (!description || !amount || amount <= 0) {
    showToast("Tavsif va to'g'ri summani kiriting", 'warning');
    return;
  }

  const btn = document.getElementById('expSaveBtn');
  btn.disabled = true;

  try {
    const url = id ? `/api/expenses/${id}` : '/api/expenses';
    const method = id ? 'PUT' : 'POST';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ description, amount, category, date })
    });
    const data = await res.json();

    if (!res.ok) throw new Error(data.message || 'Saqlashda xatolik');

    showToast(id ? "Xarajat tahrirlandi" : "Yangi xarajat qo'shildi", 'success');
    closeExpenseModal();
    loadExpenses();
  } catch (e) {
    showToast(e.message || "Xatolik yuz berdi", 'error');
  } finally {
    btn.disabled = false;
  }
}

async function deleteExpense(id) {
  if (!confirm("Ushbu xarajatni o'chirishni tasdiqlaysizmi?")) return;
  try {
    const res = await fetch(`/api/expenses/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || "O'chirishda xatolik");

    showToast("Xarajat o'chirildi", 'success');
    loadExpenses();
  } catch (e) {
    showToast(e.message || "Xatolik yuz berdi", 'error');
  }
}

document.addEventListener('DOMContentLoaded', loadExpenses);
</script>

<%- include('../layouts/footer') %>
