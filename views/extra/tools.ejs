async function saveAutoMessages() {
  try {
    const templates = document.querySelectorAll('.auto-msg-template');
    const enables = document.querySelectorAll('.auto-msg-enabled');

    const messages = Array.from(templates).map((t, idx) => ({
      id: `msg-${idx + 1}`,
