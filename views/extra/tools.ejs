    document.getElementById('metricConversionRate').textContent = data.overallConversionRate + '%';
    document.getElementById('metricForecast30').textContent = Number(data.metrics.forecast30Days || 0).toLocaleString('uz-UZ') + ' UZS';
    document.getElementById('metricPendingNasiya').textContent = Number(data.metrics.pendingInstallmentsAmount || 0).toLocaleString('uz-UZ') + ' UZS';

    const container = document.getElementById('funnelStagesList');
    container.innerHTML = data.stageFunnel.map(st => `
      <div style="background:var(--bg-surface-hover); padding:14px; border-radius:10px; border:1px solid var(--border);">
        <div style="display:flex; justify-content:space-between; font-size:13.5px; font-weight:700; margin-bottom:8px;">
          <span><span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:${st.color}; margin-right:8px;"></span> ${st.name}</span>
          <span style="color:#0052FF;">${st.count} ta sdelka (${st.percentage}%)</span>
