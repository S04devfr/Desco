async function loadAutoMessages() {
  try {
    const res = await fetch('/api/tools/auto-messages');
    const data = await res.json();

    const container = document.getElementById('autoMsgContainer');
    container.innerHTML = data.messages.map((msg, idx) => `
      <div style="padding:18px; background:var(--bg-surface-hover); border:1px solid var(--border); border-radius:10px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <div style="font-weight:800; font-size:14px; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
            <i class="fas fa-tag" style="color:#0052FF;"></i> Bosqich: ${msg.stageName}
