async function restoreSeedData() {
  if (!confirm("Barcha 4,167 ta mijoz va 492 ta sdelkalar zaxirasini yangi bazaga quyaymi?")) return;
  try {
    const res = await fetch('/api/tools/restore-seed', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      if (window.showToast) showToast(data.message);
      else alert(data.message);
      setTimeout(() => window.location.href = '/deals', 1200);
    } else {
      alert('Xatolik: ' + (data.error || 'Server xatosi'));
    }
  } catch(e) {
    alert('Xatolik: ' + e.message);
  }
}


function initCleanupTab() {
  const input = document.getElementById('cleanupThresholdDate');
  if (input && !input.value) {
    const now = new Date();
    const pad = n => String(n).padStart(2, '0');
    input.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-01`;
  }
}

async function checkCleanupStats() {
  const dateVal = document.getElementById('cleanupThresholdDate').value;
  if (!dateVal) {
    alert("Iltimos, chegara sanasini tanlang!");
    return;
  }

  try {
    const res = await fetch(`/api/tools/cleanup-stats?date=${dateVal}`);
    const data = await res.json();
    if (res.status >= 400) throw new Error(data.error || 'Server xatosi');

    document.getElementById('cleanupDealsCount').textContent = data.deals.toDelete;
    document.getElementById('cleanupDealsTotal').textContent = `Jami ${data.deals.totalBeforeDate} tadan (Faol: ${data.deals.activeBeforeDate} ta)`;
    
    document.getElementById('cleanupClientsCount').textContent = data.clients.toDelete;
    document.getElementById('cleanupClientsTotal').textContent = `Jami ${data.clients.totalBeforeDate} tadan (Faol/Qarzdor: ${data.clients.activeOrWithDebtBeforeDate} ta)`;

    document.getElementById('cleanupStatsContainer').style.display = 'grid';
    
    const btn = document.getElementById('btnExecuteCleanup');
    if (btn) {
      btn.disabled = false;
    }
  } catch(e) {
    alert('Xatolik: ' + e.message);
  }
}

async function executeDatabaseCleanup() {
  const dateVal = document.getElementById('cleanupThresholdDate').value;
  if (!dateVal) return;

  const dealsCount = document.getElementById('cleanupDealsCount').textContent;
  const clientsCount = document.getElementById('cleanupClientsCount').textContent;

  if (Number(dealsCount) === 0 && Number(clientsCount) === 0) {
    alert("O'chiriladigan ma'lumotlar mavjud emas!");
    return;
  }

  const msg = `DIQQAT!\n\nTanlangan sanagacha (${dateVal}) bo'lgan:\n` +
              `- ${dealsCount} ta yopilgan sdelka va ularning barcha vazifalari/tarixi\n` +
              `- ${clientsCount} ta faol bo'lmagan (hech qanday sdelkasi va qarzi yo'q) mijozlar\n\n` +
              `butunlay o'chiriladi. Ushbu amalni ortga qaytarib bo'lmaydi!\n\n` +
              `Tasdiqlash uchun OK tugmasini bosing.`;

  if (!confirm(msg)) return;

  const btn = document.getElementById('btnExecuteCleanup');
  if (btn) btn.disabled = true;

  try {
    const res = await fetch('/api/tools/cleanup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ date: dateVal })
    });
    const data = await res.json();
    if (res.status >= 400) throw new Error(data.error || 'Server xatosi');

    if (window.showToast) {
      showToast(data.message, 'success');
    } else {
      alert(data.message);
    }
    
    document.getElementById('cleanupStatsContainer').style.display = 'none';
    if (btn) btn.disabled = true;
  } catch(e) {
    alert('Xatolik: ' + e.message);
    if (btn) btn.disabled = false;
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadAuditLogs(1);
});
</script>

