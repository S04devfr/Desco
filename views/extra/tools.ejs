<style>
.tools-tab-btn {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  padding: 10px 18px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.tools-tab-btn:hover {
  color: var(--text-primary);
  border-color: var(--text-tertiary);
  transform: translateY(-1px);
}
.tools-tab-btn.active {
  background: #0052FF;
  color: #ffffff;
  border-color: #0052FF;
  box-shadow: 0 4px 12px rgba(0,82,255,0.3);
}
.tools-tab-btn.active i {
  color: #ffffff !important;
}
.tools-tab-content {
  display: none;
}
.tools-tab-content.active {
  display: block;
}
</style>

<script>
let currentActiveTab = 'audit';

function switchToolsTab(tabName) {
  currentActiveTab = tabName;
  document.querySelectorAll('.tools-tab-btn').forEach(btn => btn.classList.remove('active'));
  document.querySelectorAll('.tools-tab-content').forEach(content => content.classList.remove('active'));

  document.getElementById('tab-btn-' + tabName)?.classList.add('active');
  document.getElementById('tab-content-' + tabName)?.classList.add('active');

  refreshCurrentTab();
}

function refreshCurrentTab() {
  if (currentActiveTab === 'audit') loadAuditLogs(1);
  if (currentActiveTab === 'roundrobin') loadRoundRobinConfig();
  if (currentActiveTab === 'forecast') loadSalesForecast();
  if (currentActiveTab === 'automsg') loadAutoMessages();
  if (currentActiveTab === 'permissions') loadPermissionsConfig();
  if (currentActiveTab === 'cleanup') initCleanupTab();
}

async function loadAuditLogs(page = 1) {
  try {
    const q = document.getElementById('auditSearchInput')?.value || '';
    const userId = document.getElementById('auditUserFilter')?.value || '';
    const res = await fetch(`/api/tools/audit-logs?page=${page}&q=${encodeURIComponent(q)}&userId=${userId}`);
    const data = await res.json();

    const tbody = document.getElementById('auditLogsTbody');
    const totalText = document.getElementById('auditTotalText');
    if (totalText && data.pagination) {
      totalText.textContent = `Jami: ${data.pagination.total} ta yozuv`;
    }

    if (!data.logs || data.logs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:40px; color:var(--text-tertiary);">Audit yozuvlari topilmadi</td></tr>`;
      return;
    }

    const userSelect = document.getElementById('auditUserFilter');
    if (userSelect && userSelect.options.length <= 1 && data.users) {
      data.users.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.id;
        opt.textContent = u.fullName || u.email;
        userSelect.appendChild(opt);
      });
    }

    tbody.innerHTML = data.logs.map(log => {
      const timeStr = new Date(log.createdAt).toLocaleString('uz-UZ');
      const userName = log.user ? log.user.fullName : 'Tizim';
      
      let badgeStyle = 'background:rgba(0,82,255,0.12); color:#0052FF; border:1px solid rgba(0,82,255,0.25);';
      if (log.action.includes('LOGIN') || log.action.includes('REGISTER')) {
        badgeStyle = 'background:rgba(16,185,129,0.12); color:#10B981; border:1px solid rgba(16,185,129,0.25);';
      } else if (log.action.includes('DELETE') || log.action.includes('BLOCKED')) {
        badgeStyle = 'background:rgba(239,68,68,0.12); color:#EF4444; border:1px solid rgba(239,68,68,0.25);';
      }

      return `
        <tr style="border-bottom:1px solid var(--border);">
          <td style="font-size:12px; color:var(--text-tertiary); font-weight:500; padding:12px 16px;">${timeStr}</td>
          <td style="font-weight:700; color:var(--text-primary); padding:12px 16px;">${userName}</td>
          <td style="padding:12px 16px;"><span class="badge" style="${badgeStyle}">${log.action}</span></td>
          <td style="font-size:12.5px; padding:12px 16px;">${log.details || ''}</td>
          <td style="padding:12px 16px;">${log.deal ? `<a href="/deals?dealId=${log.deal.id}" style="color:#0052FF; font-weight:600; text-decoration:none;">#${log.deal.id} - ${log.deal.productName}</a>` : '-'}</td>
        </tr>
      `;
    }).join('');
  } catch(e) {
    console.error('Audit log error:', e);
  }
}

async function loadRoundRobinConfig() {
  try {
    const res = await fetch('/api/tools/round-robin');
    const data = await res.json();

    document.getElementById('rrToggleSwitch').checked = data.config.enabled;
    const statusText = document.getElementById('rrStatusText');
    statusText.textContent = data.config.enabled ? 'FAOL' : 'O\'CHIQ';
    statusText.style.color = data.config.enabled ? '#10B981' : '#EF4444';

    const container = document.getElementById('rrManagersList');
    container.innerHTML = data.managers.map(m => {
      const isChecked = data.config.activeManagerIds.includes(m.id);
      return `
        <label style="display:flex; align-items:center; gap:12px; padding:14px; background:var(--bg-surface-hover); border:1px solid var(--border); border-radius:10px; cursor:pointer; transition:all 0.2s ease;">
          <input type="checkbox" class="rr-manager-checkbox" value="${m.id}" ${isChecked ? 'checked' : ''} style="width:18px; height:18px; cursor:pointer;">
          <div>
            <div style="font-size:13.5px; font-weight:700; color:var(--text-primary);">${m.fullName}</div>
            <div style="font-size:11.5px; color:var(--text-tertiary); margin-top:2px;">${m.role === 'admin' ? 'Administrator' : 'Sotuv menejeri'}</div>
          </div>
        </label>
      `;
    }).join('');
  } catch(e) {}
}

async function saveRoundRobinConfig() {
  try {
    const enabled = document.getElementById('rrToggleSwitch').checked;
    const statusText = document.getElementById('rrStatusText');
    statusText.textContent = enabled ? 'FAOL' : 'O\'CHIQ';
    statusText.style.color = enabled ? '#10B981' : '#EF4444';

    const checkboxes = document.querySelectorAll('.rr-manager-checkbox:checked');
    const activeManagerIds = Array.from(checkboxes).map(cb => Number(cb.value));

    const res = await fetch('/api/tools/round-robin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled, activeManagerIds })
    });
    const data = await res.json();
    if (data.success && window.showToast) {
      showToast('Round-Robin sozlamalari saqlandi');
    }
  } catch(e) {}
}

async function loadSalesForecast() {
  try {
    const res = await fetch('/api/tools/sales-forecast');
