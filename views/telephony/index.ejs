  function renderOperatorCharts(operators) {
    if (typeof Chart === 'undefined') return;

    const labels = operators.map(o => o.name);
    const totalCallsData = operators.map(o => o.totalCalls);
    const answeredData = operators.map(o => o.answeredCalls);
    const missedData = operators.map(o => o.missedCalls);

    // Chart 1: Bar Chart
    const ctx1 = document.getElementById('opCallsChart');
    if (ctx1) {
      if (opCallsChartInstance) opCallsChartInstance.destroy();
      opCallsChartInstance = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: labels.length ? labels : ['Operator 1', 'Operator 2'],
          datasets: [
            {
              label: 'Qabul qilingan',
              data: answeredData.length ? answeredData : [0, 0],
              backgroundColor: '#10b981',
              borderRadius: 6
            },
            {
              label: 'O\'tkazib yuborilgan',
              data: missedData.length ? missedData : [0, 0],
              backgroundColor: '#ef4444',
              borderRadius: 6
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'top' } },
          scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: true, ticks: { precision: 0 } }
          }
        }
      });
    }

    // Chart 2: Doughnut Chart
    const ctx2 = document.getElementById('opStatusChart');
    if (ctx2) {
      const totalAns = answeredData.reduce((a, b) => a + b, 0);
      const totalMiss = missedData.reduce((a, b) => a + b, 0);

      if (opStatusChartInstance) opStatusChartInstance.destroy();
      opStatusChartInstance = new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: ['Qabul qilingan', 'O\'tkazib yuborilgan'],
          datasets: [{
            data: [totalAns || 1, totalMiss || 0],
            backgroundColor: ['#10b981', '#ef4444'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          cutout: '70%'
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadTelephonyStats();
    loadOperators();
    loadTelephonyLogs();
  });
</script>

