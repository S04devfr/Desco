  let opStatusChartInstance = null;

  // Web Audio Synthesizer for realistic dialing ringtone on laptops
  let audioCtx = null;
  let ringOsc = null;

  function switchTelephonyTab(tabName, btn) {
    document.querySelectorAll('.telephony-nav-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    if (tabName === 'calls') {
      document.getElementById('tabContentCalls').style.display = 'block';
      document.getElementById('tabContentAnalytics').style.display = 'none';
    } else {
      document.getElementById('tabContentCalls').style.display = 'none';
      document.getElementById('tabContentAnalytics').style.display = 'flex';
      loadOperatorAnalytics();
    }
  }

  function startRingtone() {
    try {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();

      ringOsc = audioCtx.createOscillator();
      const gainNode = audioCtx.createGain();
      
      ringOsc.type = 'sine';
      ringOsc.frequency.setValueAtTime(440, audioCtx.currentTime);
      gainNode.gain.setValueAtTime(0.08, audioCtx.currentTime);

      ringOsc.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      ringOsc.start();
    } catch(e) {}
  }

  function stopRingtone() {
    try {
      if (ringOsc) {
        ringOsc.stop();
        ringOsc.disconnect();
        ringOsc = null;
      }
    } catch(e) {}
  }

  function pressNumpad(val) {
    const inp = document.getElementById('dialerInput');
    inp.value += val;
  }

  function backspaceNumpad() {
    const inp = document.getElementById('dialerInput');
    inp.value = inp.value.slice(0, -1);
  }

  async function startSoftphoneCall() {
    const num = document.getElementById('dialerInput').value.trim();
    if (!num) {
      _toast('Raqam kiritilishi shart!', 'error');
      return;
    }

    try {
      startRingtone();
      const res = await apiFetch('/api/telephony/dial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phoneNumber: num })
      });

      if (res.callLog) {
        currentActiveCallId = res.callLog.id;
        document.getElementById('callStateLabel').textContent = 'Suhbat Ketmoqda...';
        document.getElementById('btnStartCall').style.display = 'none';
        document.getElementById('activeCallControls').style.display = 'flex';
        document.getElementById('callTimer').style.display = 'block';

        callSeconds = 0;
        clearInterval(callTimerInterval);
        callTimerInterval = setInterval(() => {
          callSeconds++;
          const m = String(Math.floor(callSeconds / 60)).padStart(2, '0');
          const s = String(callSeconds % 60).padStart(2, '0');
          document.getElementById('callTimer').textContent = `${m}:${s}`;
        }, 1000);

        stopRingtone();
        _toast('Qo\'ng\'iroq ulandi (Web-Softphone)!', 'success');
        loadTelephonyLogs();
      }
    } catch(e) {
      stopRingtone();
      _toast(e.message, 'error');
    }
  }

  async function endSoftphoneCall() {
    if (!currentActiveCallId) return;

    try {
      stopRingtone();
      await apiFetch('/api/telephony/hangup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ callId: currentActiveCallId, duration: callSeconds })
      });

      clearInterval(callTimerInterval);
      document.getElementById('callStateLabel').textContent = 'Raqam Terilmoqda';
      document.getElementById('btnStartCall').style.display = 'flex';
      document.getElementById('activeCallControls').style.display = 'none';
      document.getElementById('callTimer').style.display = 'none';
      document.getElementById('callTimer').textContent = '00:00';

      currentActiveCallId = null;
      _toast('Suhbat yakunlandi va yozib olindi', 'info');
      loadTelephonyLogs();
      loadTelephonyStats();
      loadOperators();
    } catch(e) {
      _toast(e.message, 'error');
    }
  }

