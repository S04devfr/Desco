generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String?
  name      String?
  role      String   @default("manager")
  isActive  Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals          Deal[]
  tasks          Task[]
  expenses       Expense[]
  clients        Client[]
  activities     ActivityLog[]
  managerSalary  ManagerSalary?
  managerFines   ManagerFine[]
  plans          Plan[]
  callLogs       CallLog[]

  companiesCompanyOwner Company[] @relation("CompanyOwner")
  contactsContactOwner  Contact[] @relation("ContactOwner")
  tasksCreated          Task[]    @relation("TaskCreatedBy")
  stageHistories        DealStageHistory[]
  newActivities         Activity[]
  dealOwners            Deal[]    @relation("DealOwner")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  company   String?
  companyAddress String?
  companyPhone String?
  companyEmail String?
  companyWebsite String?
  notes     String?
  city      String?
  debt      Float    @default(0)
  debtDate  DateTime?
  debtNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId Int?
  owner   User?  @relation(fields: [ownerId], references: [id])

  deals Deal[]
  tasks Task[]
  callLogs CallLog[]

  instagramId       String? @unique
  instagramUsername String?
  instagramUnreadCount Int @default(0)
  messages          InstagramMessage[]

  telegramId        String? @unique
  telegramUsername  String?
  telegramUnreadCount Int @default(0)
  telegramMessages  TelegramMessage[]

  @@index([ownerId])
  @@index([createdAt])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  industry  String?
  website   String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  ownerId Int?
  owner   User?  @relation("CompanyOwner", fields: [ownerId], references: [id])

  contacts Contact[]
  deals    Deal[]
  tasks    Task[]

  @@index([ownerId])
  @@index([createdAt])
  @@map("companies")
}

model Contact {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  position  String?
  city      String?
  source    String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  ownerId Int?
  owner   User?    @relation("ContactOwner", fields: [ownerId], references: [id])

  deals Deal[]
  tasks Task[]

  instagramId          String?            @unique
  instagramUsername    String?
  instagramUnreadCount Int                @default(0)
  messages             InstagramMessage[]

  telegramId          String?           @unique
  telegramUsername    String?
  telegramUnreadCount Int               @default(0)
  telegramMessages    TelegramMessage[]

  @@index([companyId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("contacts")
}

// ── VORONKA (PIPELINE) ──
model Pipeline {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  color       String   @default("#007AFF")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#5D4037")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  statusType String   @default("new")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelineId Int?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  deals Deal[]
  fromHistory DealStageHistory[] @relation("HistoryFromStage")
  toHistory   DealStageHistory[] @relation("HistoryToStage")
}

model Deal {
  id          Int       @id @default(autoincrement())
  productName String
  title       String?
  amount      Float     @default(0)
  paidAmount  Float     @default(0)
  costPrice   Float     @default(0)
  currency    String    @default("UZS")
  status      String    @default("new")
  notes       String?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  managerId Int?
  manager   User? @relation(fields: [managerId], references: [id])

  ownerId Int?
  owner   User? @relation("DealOwner", fields: [ownerId], references: [id])

  stageId Int?
  stage   PipelineStage? @relation(fields: [stageId], references: [id])

  pipelineId Int?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  probability Float? @default(0)
  expectedCloseDate DateTime?
  closedAt    DateTime?

  tasks        Task[]
  activities   ActivityLog[]
  installments Installment[]
  deliveryLog  DeliveryLog?
  warehouse        String?
  stockDecremented Boolean   @default(false)
  deliveryPrice    Float     @default(0)
  source           String    @default("oddiy") // instagram | target | oddiy
  tags             String?   @default("")
  stageUpdatedAt   DateTime? @default(now())
  productColor     String    @default("oddiy")

  driverPhone      String?
  stageHistory DealStageHistory[]
  callLogs     CallLog[]

  @@index([stageId])
  @@index([managerId])
  @@index([clientId])
  @@index([contactId])
  @@index([companyId])
  @@index([ownerId])
  @@index([pipelineId])
  @@index([createdAt])
}

// ── YETKAZIB BERISH KUZATUVI ──
model DeliveryLog {
  id            Int       @id @default(autoincrement())
  dealId        Int       @unique
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  shopirName    String?
  dispatchDate  DateTime  @default(now())
  deliveredDate DateTime?
  destination   String?

  status        String    @default("dispatched")    // dispatched | delivered | returned | cancelled
  paymentStatus String    @default("unpaid")        // unpaid | partial | paid
  collectedAmount Float   @default(0)
  paymentNotes  String?

  updatedBy     String?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([paymentStatus])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  createdAt DateTime @default(now())

  dealId Int?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float    @default(0)
  category    String   @default("other")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  dueTime     String?
  completed   Boolean   @default(false)
  status      String    @default("todo")
  priority    String    @default("medium")
  actionType  String    @default("Связаться")
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedToId Int?
  assignedTo   User? @relation(fields: [assignedToId], references: [id])

  createdById Int?
  createdBy   User? @relation("TaskCreatedBy", fields: [createdById], references: [id])

  dealId Int?
  deal   Deal? @relation(fields: [dealId], references: [id])

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([assignedToId])
  @@index([createdById])
  @@index([completed])
  @@index([contactId])
  @@index([companyId])
  @@index([createdAt])
}

model CompanySettings {
  id                    Int      @id @default(autoincrement())
  companyName           String   @default("DESCO CRM")
  currency              String   @default("UZS")
  logoUrl               String?
  mandatoryFields       String   @default("")
  telegramSessionString String?
  telegramPhone         String?
  telegramApiId         String?
  telegramApiHash       String?
  instagramAccessToken  String?
  instagramPageId       String?
  instagramVerifyToken  String?
  updatedAt             DateTime @updatedAt
}

model InstagramAccount {
  id          Int      @id @default(autoincrement())
  accountId   String   @unique
  accessToken String?
  username    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InstagramMessage {
  id        Int      @id @default(autoincrement())
  messageId String   @unique
  text      String?
  senderId  String
  recipientId String
  timestamp DateTime
  isOutgoing Boolean @default(false)
  createdAt DateTime @default(now())

  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])

  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id])

  attachmentType String?
  attachmentUrl  String?
}

model Installment {
  id          Int      @id @default(autoincrement())
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  amount      Float    @default(0)
  paid        Boolean  @default(false)
  productName String?
  month       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealId])
  @@index([dueDate])
}

model ProductCatalog {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shopir {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  region     String?
  price      Float    @default(0)
  travelCost Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model IshonchFilial {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  region     String?
  price      Float    @default(0)
  travelCost Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WarehouseStock {
  id          Int      @id @default(autoincrement())
  warehouse   String
  productName String
  color       String   @default("oddiy")
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([warehouse, productName, color])
}

model WarehouseLog {
  id          Int      @id @default(autoincrement())
  warehouse   String
  productName String
  color       String   @default("oddiy")
  changeQty   Int
  action      String
  notes       String?
  dealId      Int?
  userName    String?
  createdAt   DateTime @default(now())
}

// ── MARKETING & TARGET ──
model MarketingLog {
  id        Int      @id @default(autoincrement())
  date      DateTime
  channel   String   // instagram, facebook, google, tiktok, other
  campaign  String?  // kampaniya nomi / reklamasi
  spent     Float    @default(0)
  leads     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── HODIMLAR OYLIK ──
model ManagerSalary {
  id         Int   @id @default(autoincrement())
  managerId  Int   @unique
  baseSalary Float @default(0)
  manager    User  @relation(fields: [managerId], references: [id])
}

model ManagerFine {
  id        Int      @id @default(autoincrement())
  managerId Int
  amount    Float    @default(0)
  reason    String?
  month     String   // "2025-01"
  createdAt DateTime @default(now())
  manager   User     @relation(fields: [managerId], references: [id])
}

model Plan {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("todo") // "todo", "progress", "done"
  priority    String   @default("medium") // "high", "medium", "low"
  color       String?  @default("#3b82f6")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatorId   Int
  creator     User     @relation(fields: [creatorId], references: [id])
}

model TelegramMessage {
  id             Int      @id @default(autoincrement())
  messageId      String   @unique
  text           String?
  senderId       String
  recipientId    String
  timestamp      DateTime
  isOutgoing     Boolean  @default(false)
  createdAt      DateTime @default(now())

  clientId       Int?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  contactId      Int?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  attachmentType String?
  attachmentUrl  String?
}

model DealStageHistory {
  id          Int      @id @default(autoincrement())
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId Int?
  fromStage   PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id])
  toStageId   Int
  toStage     PipelineStage @relation("HistoryToStage", fields: [toStageId], references: [id])
  changedById Int?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@map("deal_stage_history")
}

model Activity {
  id            Int       @id @default(autoincrement())
  type          String    // call | email | meeting | note | task
  relatedToType String    // deal | contact | company
  relatedToId   Int
  description   String
  dueDate       DateTime?
  completedAt   DateTime?
  ownerId       Int?
  owner         User?     @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())

  @@map("activities")
}

model CallLog {
  id           Int      @id @default(autoincrement())
  callId       String?  @unique
  type         String   @default("incoming") // incoming | outgoing | missed
  fromNumber   String
  toNumber     String
  clientName   String?
  duration     Int      @default(0) // seconds
  status       String   @default("answered") // answered | missed | busy | failed
  recordingUrl String?
  notes        String?
  sipExtension String?  @default("101")

  managerId    Int?
  manager      User?    @relation(fields: [managerId], references: [id])
  clientId     Int?
  client       Client?  @relation(fields: [clientId], references: [id])
  dealId       Int?
  deal         Deal?    @relation(fields: [dealId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromNumber])
  @@index([toNumber])
  @@index([createdAt])
  @@map("call_logs")
}


