# ==================================================
# DESCO CRM - TELEPHONY / VOIP ENVIRONMENT CONFIGURATION
# ==================================================

# Active VoIP/SIP Provider (options: generic, onlinepbx, zadarma, asterisk, mock)
TELEPHONY_PROVIDER=generic

# Provider REST API Base Endpoint
TELEPHONY_API_URL=https://api.your-voip-provider.com/v1

# Provider API Credentials (Secret keys managed on Railway dashboard)
TELEPHONY_API_KEY=your_api_key_here
TELEPHONY_API_SECRET=your_api_secret_here

# SIP Server Connection Settings
TELEPHONY_SIP_DOMAIN=sip.your-voip-provider.com
TELEPHONY_SIP_USERNAME=your_sip_username
TELEPHONY_SIP_PASSWORD=your_sip_password

# Webhook Security Token (Shared secret for HTTP header signature verification)
TELEPHONY_WEBHOOK_SECRET=your_webhook_signature_token_here

# Security Enforcement (set to true in production once webhook secret is configured)
TELEPHONY_VERIFY_SIGNATURE=false

# Default Manager SIP Extension
TELEPHONY_DEFAULT_EXTENSION=101
